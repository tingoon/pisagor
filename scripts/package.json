{
  "name": "@pisagor/scripts",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo maintenance scripts (catalog generate, …).",
  "type": "module",
  "scripts": {
    "generate": "bun ./src/generate-catalog.ts && bun ./src/generate-props.ts",
    "generate:catalog": "bun ./src/generate-catalog.ts",
    "generate:props": "bun ./src/generate-props.ts",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "ts-morph": "^28.0.0"
  }
}
