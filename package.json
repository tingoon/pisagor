  },
  "catalog": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "astro": "^7.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vue": "^3.5.42"
  },
  "description": "Pisagor UI library monorepo (React and Vue).",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@changesets/config": "3.1.4",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@types/bun": "1.4.0",
    "@types/node": "^26.6.2",
    "knip": "^6.37.0",
    "lefthook": "^2.1.14",
    "rulesync": "^17.0.0",
    "taze": "^21.1.0",
    "turbo": "^2.11.2",
    "typescript": "^7.0.2"
  },
  "homepage": "https://github.com/tingoon/pisagor#readme",
  "license": "MIT",
  "name": "pisagor",
  "packageManager": "bun@1.4.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tingoon/pisagor.git"
  },
  "scripts": {
    "build": "turbo build",
    "check": "biome check . && turbo type-check --output-logs=errors-only && knip",
    "dev": "turbo dev",
    "format": "biome check --write .",
    "lint": "biome lint .",
    "prepare": "lefthook install && rulesync install",
    "rulesync": "rulesync generate",
    "setup": "bun run rulesync",
    "test": "turbo test",
    "type-check": "turbo type-check"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ]
}
