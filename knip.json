{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    "apps/react": {
      "entry": [".storybook/**/*", "src/**/*", "../../packages/react/**/*.stories.@(ts|tsx)"]
    },
    "apps/vue": {
      "entry": [".storybook/**/*", "src/**/*", "../../packages/vue/**/*.stories.@(ts|tsx)"]
    },
    "packages/react": {
      "entry": ["src/**/*"],
      "ignoreIssues": {
        "src/**/*.stories.tsx": ["unresolved", "dependencies", "unlisted"],
        "src/blocks/**": ["exports", "types", "files"],
        "src/charts/**/*.recipe.ts": ["exports", "types", "duplicates"],
        "src/components/**/*.recipe.ts": ["exports", "types", "duplicates"],
        "src/data-grid/**/*.recipe.ts": ["exports", "types", "duplicates"],
        "src/data-table/**/*.recipe.ts": ["exports", "types", "duplicates"],
        "src/internal/**": ["exports", "types"],
        "src/phone-input/**/*.recipe.ts": ["exports", "types", "duplicates"],
        "src/rich-text-editor/**/*.recipe.ts": ["exports", "types", "duplicates"]
      }
    },
    "packages/recipes": {
      "entry": ["src/ui/*.ts"]
    },
    "packages/tsconfig": {
      "ignoreDependencies": ["@types/react"]
    },
    "packages/vue": {
      "entry": ["src/**/*"],
      "ignoreIssues": {
        "src/**/*.stories.ts": ["unresolved", "dependencies", "unlisted"],
        "src/blocks/**": ["exports", "types", "files"],
        "src/components/**": ["exports", "types", "duplicates"],
        "src/internal/**": ["exports", "types", "duplicates"]
      }
    }
  }
}
