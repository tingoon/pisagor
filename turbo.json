{
  "globalDependencies": ["biome.json", "tsconfig.json"],
  "globalPassThroughEnv": [
    "TANSTACK_CLI_TELEMETRY_DISABLED",
    "TURBO_TELEMETRY_DISABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["transit"],
      "env": ["DOCS_BASE_PATH", "DOCS_SITE", "STORYBOOK_BASE_PATH"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {},
    "transit": {
      "dependsOn": ["^transit"]
    },
    "type-check": {
      "dependsOn": ["transit"]
    }
  },
  "ui": "tui"
}
