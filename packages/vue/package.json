    "@tanstack/vue-virtual": "^3.13.47",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@vueuse/core": "^15.0.0",
    "libphonenumber-js": "^1.13.15",
    "remeda": "^2.53.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
