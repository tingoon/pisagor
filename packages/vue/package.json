{
  "name": "@pisagor/vue",
  "version": "1.0.0",
  "description": "Accessible Vue UI components built on Ark UI and Tailwind CSS v4.",
  "homepage": "https://github.com/tingoon/pisagor#readme",
  "bugs": {
    "url": "https://github.com/tingoon/pisagor/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tingoon/pisagor.git",
