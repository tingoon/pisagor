{
  "bugs": {
    "url": "https://github.com/tingoon/pisagor/issues"
  },
  "dependencies": {
    "@ark-ui/vue": "^5.39.1",
    "@phosphor-icons/vue": "^2.2.1",
    "@pisagor/recipes": "^0.1.0",
    "@pisagor/tokens": "^0.1.0",
    "@pisagor/utils": "^0.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/vue-table": "^9.2.4",
    "@tanstack/vue-virtual": "^3.13.36",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/vue-3": "^3.30.5",
    "@vueuse/core": "^14.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "description": "Accessible Vue UI components built on Ark UI and Tailwind CSS.",
  "devDependencies": {
    "@pisagor/tsconfig": "workspace:*",
    "vue": "catalog:"
  },
  "exports": {
    ".": "./src/components/index.ts",
    "./*": "./src/components/*/index.ts",
    "./data-grid": "./src/data-grid/index.ts",
    "./data-table": "./src/data-table/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./phone-input": "./src/phone-input/index.ts",
    "./rich-text-editor": "./src/rich-text-editor/index.ts",
    "./styles": "./src/styles.css"
  },
  "files": [
    "src",
    "!**/*.stories.*",
    "!**/*.test.*"
  ],
  "homepage": "https://github.com/tingoon/pisagor#readme",
  "license": "MIT",
  "name": "@pisagor/vue",
  "peerDependencies": {
    "tailwindcss": "^4",
    "vue": "^3.5"
  },
  "repository": {
    "directory": "packages/vue",
    "type": "git",
    "url": "git+https://github.com/tingoon/pisagor.git"
  },
  "scripts": {
    "type-check": "tsc"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "version": "0.1.0"
}
