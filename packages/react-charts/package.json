{
  "bugs": {
    "url": "https://github.com/tingoon/pisagor/issues"
  },
  "dependencies": {
    "@pisagor/react": "^0.2.0",
    "@pisagor/recipes": "^0.2.0",
    "@pisagor/utils": "^0.1.0",
    "recharts": "^3.10.1"
  },
  "description": "Chart primitives for Pisagor React (Recharts wrappers).",
  "devDependencies": {
    "@pisagor/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./examples": "./src/examples/index.ts",
    "./examples/*": "./src/examples/*",
    "./styles": "./src/styles.css"
  },
  "files": [
    "catalog.gen.json",
    "skills",
    "src",
    "!**/*.stories.*",
    "!**/*.test.*"
  ],
  "homepage": "https://github.com/tingoon/pisagor#readme",
  "license": "MIT",
  "name": "@pisagor/react-charts",
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "repository": {
    "directory": "packages/react-charts",
    "type": "git",
    "url": "git+https://github.com/tingoon/pisagor.git"
  },
  "scripts": {
    "type-check": "tsc"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "version": "0.1.2"
}
