    "./date-field/examples/*": "./src/fields/date-field/examples/*",
    "./file-field/examples": "./src/fields/file-field/examples/index.ts",
    "./file-field/examples/*": "./src/fields/file-field/examples/*",
    "./number-field/examples": "./src/fields/number-field/examples/index.ts",
    "./number-field/examples/*": "./src/fields/number-field/examples/*",
    "./otp-field/examples": "./src/fields/otp-field/examples/index.ts",
    "./otp-field/examples/*": "./src/fields/otp-field/examples/*",
    "./password-field/examples": "./src/fields/password-field/examples/index.ts",
    "./password-field/examples/*": "./src/fields/password-field/examples/*",
    "./phone-field/examples": "./src/fields/phone-field/examples/index.ts",
    "./phone-field/examples/*": "./src/fields/phone-field/examples/*",
    "./radio-group-field/examples": "./src/fields/radio-group-field/examples/index.ts",
    "./radio-group-field/examples/*": "./src/fields/radio-group-field/examples/*",
    "./rich-text-editor-field/examples": "./src/fields/rich-text-editor-field/examples/index.ts",
    "./rich-text-editor-field/examples/*": "./src/fields/rich-text-editor-field/examples/*",
    "./select-field/examples": "./src/fields/select-field/examples/index.ts",
    "./select-field/examples/*": "./src/fields/select-field/examples/*",
    "./slider-field/examples": "./src/fields/slider-field/examples/index.ts",
    "./slider-field/examples/*": "./src/fields/slider-field/examples/*",
    "./styles": "./src/styles.css",
    "./switch-field/examples": "./src/fields/switch-field/examples/index.ts",
    "./switch-field/examples/*": "./src/fields/switch-field/examples/*",
    "./tags-input-field/examples": "./src/fields/tags-input-field/examples/index.ts",
    "./tags-input-field/examples/*": "./src/fields/tags-input-field/examples/*",
    "./tanstack": "./src/tanstack/index.ts",
