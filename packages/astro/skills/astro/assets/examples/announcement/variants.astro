---
import Announcement from "../../../../../src/components/announcement/announcement.astro";
import Badge from "../../../../../src/components/badge/badge.astro";
---

<div class="flex flex-col gap-2">
  <Announcement
    title="v2.1.0 — Dark mode, faster builds, and 12 new components"
  >
    <Badge slot="badge" variant="default">Release</Badge>
  </Announcement>
  <Announcement
    title="Your last invoice couldn't be processed. Update your billing info."
  >
    <Badge slot="badge" variant="destructive">Payment failed</Badge>
  </Announcement>
  <Announcement
    title="Scheduled downtime tonight 2 to 4 a.m. UTC. No action needed."
  >
    <Badge slot="badge" variant="info">Maintenance</Badge>
  </Announcement>
</div>
