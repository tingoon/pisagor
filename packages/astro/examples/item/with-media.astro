---
import { Item } from "@pisagor/astro";
import source from "./with-media.astro?raw";
export { source };
---

<Item variant="outline">
  <Item.Media>
    <span aria-hidden="true" class="text-base">✓</span>
  </Item.Media>
  <Item.Content>
    <Item.Title>Your profile has been verified.</Item.Title>
  </Item.Content>
  <Item.Actions>
    <span aria-hidden="true">›</span>
  </Item.Actions>
</Item>
