---
import { InputGroup, Kbd } from "@pisagor/astro";
import source from "./with-keyboard-shortcut.astro?raw";
export { source };
---

<InputGroup>
  <input
    class="min-w-0 flex-1 bg-transparent outline-none"
    placeholder="Search..."
  >
  <InputGroup.Addon align="inline-end">
    <Kbd>⌘K</Kbd>
  </InputGroup.Addon>
</InputGroup>
