---
import { InputGroup } from "@pisagor/astro";
---

<div class="flex flex-col gap-2">
  <InputGroup size="sm">
    <input
      class="min-w-0 flex-1 bg-transparent outline-none"
      placeholder="Small"
    >
  </InputGroup>
  <InputGroup size="md">
    <input
      class="min-w-0 flex-1 bg-transparent outline-none"
      placeholder="Medium"
    >
  </InputGroup>
  <InputGroup size="lg">
    <input
      class="min-w-0 flex-1 bg-transparent outline-none"
      placeholder="Large"
    >
  </InputGroup>
</div>
