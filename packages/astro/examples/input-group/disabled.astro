---
import { InputGroup } from "@pisagor/astro";
import source from "./disabled.astro?raw";
export { source };
---

<InputGroup>
  <input
    class="min-w-0 flex-1 bg-transparent outline-none"
    disabled
    placeholder="Search..."
  >
  <InputGroup.Addon>
    <span aria-hidden="true">⌕</span>
  </InputGroup.Addon>
</InputGroup>
