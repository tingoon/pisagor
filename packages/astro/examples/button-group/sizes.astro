---
import { Button, ButtonGroup } from "@pisagor/astro";

const sizes = ["sm", "md", "lg"] as const;
---

<div class="flex flex-col items-start gap-2">
  {sizes.map((size) => (
    <ButtonGroup size={size}>
      <Button size={size} variant="outline">
        Archive
      </Button>
      <Button size={size} variant="outline">
        Report
      </Button>
    </ButtonGroup>
  ))}
</div>
