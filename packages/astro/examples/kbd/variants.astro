---
import { Kbd } from "@pisagor/astro";
import source from "./variants.astro?raw";
export { source };
---

<div class="flex flex-wrap items-center gap-2">
  <Kbd variant="default">K</Kbd>
  <Kbd.Group>
    <Kbd variant="outline">K</Kbd>
    <Kbd variant="outline">⌘</Kbd>
    <Kbd variant="outline">⌃</Kbd>
  </Kbd.Group>
</div>
