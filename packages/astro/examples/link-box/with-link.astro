---
import { LinkBox } from "@pisagor/astro";
import source from "./with-link.astro?raw";
export { source };
---

<LinkBox>
  <article class="flex flex-col gap-2 rounded-xl border p-4">
    <LinkBox.Overlay href="https://example.com/blog/simple-post"
      >Blog post title</LinkBox.Overlay
    >
    <p class="text-muted-foreground text-sm">A sample blog post.</p>
    <a
      class="text-primary underline"
      href="https://example.com/blog/simple-post/details"
    >
      Inner link
    </a>
  </article>
</LinkBox>
