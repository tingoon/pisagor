---
import { EmptyState } from "@pisagor/astro";

const sizes = ["sm", "md", "lg"] as const;
---

<div class="flex flex-col gap-4">
  {sizes.map((size) => (
    <EmptyState
      description="No items match your current filters."
      size={size}
      title="No projects found"
    />
  ))}
</div>
