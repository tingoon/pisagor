---
import { Frame } from "@pisagor/astro";

const sizes = ["sm", "md", "lg"] as const;
export type { source };
---

<div class="flex flex-col gap-4">
  {sizes.map((size) => (
    <Frame size={size}>
      <Frame.Header>
        <Frame.Title>Section {size}</Frame.Title>
      </Frame.Header>
      <Frame.Panel>
        <p class="text-muted-foreground text-sm">Section content</p>
      </Frame.Panel>
    </Frame>
  ))}
</div>
