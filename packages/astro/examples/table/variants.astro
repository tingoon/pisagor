---
import { Table } from "@pisagor/astro";
---

<div class="flex flex-col gap-6">
  <Table variant="plain">
    <Table.Header>
      <Table.Row>
        <Table.Head>Plain</Table.Head>
        <Table.Head>Value</Table.Head>
      </Table.Row>
    </Table.Header>
    <Table.Body>
      <Table.Row>
        <Table.Cell>Alpha</Table.Cell>
        <Table.Cell>1</Table.Cell>
      </Table.Row>
      <Table.Row>
        <Table.Cell>Beta</Table.Cell>
        <Table.Cell>2</Table.Cell>
      </Table.Row>
    </Table.Body>
  </Table>
  <Table variant="striped">
    <Table.Header>
      <Table.Row>
        <Table.Head>Striped</Table.Head>
        <Table.Head>Value</Table.Head>
      </Table.Row>
    </Table.Header>
    <Table.Body>
      <Table.Row>
        <Table.Cell>Alpha</Table.Cell>
        <Table.Cell>1</Table.Cell>
      </Table.Row>
      <Table.Row>
        <Table.Cell>Beta</Table.Cell>
        <Table.Cell>2</Table.Cell>
      </Table.Row>
    </Table.Body>
  </Table>
</div>
