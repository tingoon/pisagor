---
import { Format } from "@pisagor/astro";
---

<div class="flex flex-col gap-2">
  <div>
    <span class="text-muted-foreground text-sm">USD: </span>
    <Format.Number
      options={{ currency: "USD", style: "currency" }}
      value={99.99}
    />
  </div>
  <div>
    <span class="text-muted-foreground text-sm">EUR: </span>
    <Format.Number
      options={{ currency: "EUR", style: "currency" }}
      value={99.99}
    />
  </div>
  <div>
    <span class="text-muted-foreground text-sm">BRL: </span>
    <Format.Number
      options={{ currency: "BRL", style: "currency" }}
      value={99.99}
    />
  </div>
</div>
