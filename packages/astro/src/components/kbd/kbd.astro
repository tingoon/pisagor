---
import type { KbdProps as BaseKbdProps } from "@pisagor/props";
import { kbdRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"kbd"> & BaseKbdProps;

const {
  variant = "default",
  recipe = kbdRecipe,
  class: className,
  ...rest
} = Astro.props;
---

<kbd
  {...rest}
  class={recipe({ className, variant })}
  data-part="root"
  data-scope="kbd"
>
  <slot />
</kbd>
