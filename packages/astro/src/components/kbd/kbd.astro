---
import type { KbdProps as KbdSharedProps } from "@pisagor/props";
import { kbdRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"kbd"> & KbdSharedProps;

const { variant = "default", class: className, ...rest } = Astro.props;
---

<kbd
  {...rest}
  class={kbdRecipe({ className, variant })}
  data-part="root"
  data-scope="kbd"
>
  <slot />
</kbd>
