---
import type { KbdProps as BaseKbdProps } from "@pisagor/props";
import { kbdRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";
import type { SizeScaleProps } from "../../internal";

type Props = HTMLAttributes<"kbd"> & BaseKbdProps & SizeScaleProps;

const {
  variant = "default",
  size = "md",
  recipe = kbdRecipe,
  class: className,
  ...rest
} = Astro.props;
---

<kbd
  {...rest}
  class={recipe({ className, size, variant })}
  data-part="root"
  data-scope="kbd"
  data-size={size}
>
  <slot />
</kbd>
