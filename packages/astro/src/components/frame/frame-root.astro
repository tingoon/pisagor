---
import type { FrameProps as BaseFrameProps } from "@pisagor/props";
import type { HTMLAttributes } from "astro/types";
import { withProvider } from "./frame.context";

type Props = HTMLAttributes<"div"> & BaseFrameProps;

const root = withProvider(Astro.props, { name: "Root", slot: "base" });
---

<div {...root.props}>
  <slot />
</div>
