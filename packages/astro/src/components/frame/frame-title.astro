---
import type { HTMLAttributes } from "astro/types";
import { withContext } from "./frame.context";

type Props = HTMLAttributes<"div">;

const title = withContext(Astro.props, {
  defaultProps: { "data-part": "panel-title" },
  name: "Title",
  slot: "panelTitle",
});
---

<div {...title.props}>
  <slot />
</div>
