---
import type { HTMLAttributes } from "astro/types";
import { withContext } from "./frame.context";

type Props = HTMLAttributes<"header">;

const header = withContext(Astro.props, {
  defaultProps: { "data-part": "panel-header" },
  name: "Header",
  slot: "panelHeader",
});
---

<header {...header.props}>
  <slot />
</header>
