---
import type { HTMLAttributes } from "astro/types";
import { withContext } from "./frame.context";

type Props = HTMLAttributes<"header">;

const header = withContext(Astro.props, {
  name: "Header",
  part: "panel-header",
  slot: "panelHeader",
});
---

<header {...header.props}>
  <slot />
</header>
