---
import type { HTMLAttributes } from "astro/types";
import { withContext } from "./frame.context";

type Props = HTMLAttributes<"footer">;

const footer = withContext(Astro.props, {
  defaultProps: { "data-part": "panel-footer" },
  name: "Footer",
  slot: "panelFooter",
});
---

<footer {...footer.props}>
  <slot />
</footer>
