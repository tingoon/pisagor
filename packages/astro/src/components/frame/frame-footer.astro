---
import type { HTMLAttributes } from "astro/types";
import { withContext } from "./frame.context";

type Props = HTMLAttributes<"footer">;

const footer = withContext(Astro.props, {
  name: "Footer",
  part: "panel-footer",
  slot: "panelFooter",
});
---

<footer {...footer.props}>
  <slot />
</footer>
