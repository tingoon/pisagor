---
import type { ButtonGroupRootContract } from "@pisagor/contracts";
import type { HTMLAttributes } from "astro/types";
import { withProvider } from "./button-group.context";

type Props = HTMLAttributes<"fieldset"> & ButtonGroupRootContract;

const root = withProvider(Astro.props, { name: "Root" });
---

<fieldset {...root.props}>
  <slot />
</fieldset>
