---
import type { ButtonGroupProps as BaseButtonGroupProps } from "@pisagor/props";
import type { HTMLAttributes } from "astro/types";
import { withProvider } from "./button-group.context";

type Props = HTMLAttributes<"fieldset"> & BaseButtonGroupProps;

const root = withProvider(Astro.props, { name: "Root", slot: "base" });
---

<fieldset {...root.props}>
  <slot />
</fieldset>
