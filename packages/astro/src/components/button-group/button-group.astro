---
import type { ButtonGroupProps as ButtonGroupSharedProps } from "@pisagor/props";
import { buttonGroupRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"fieldset"> & ButtonGroupSharedProps;

const { orientation = "horizontal", class: className, ...rest } = Astro.props;
const slots = buttonGroupRecipe({ orientation });
---

<fieldset
  {...rest}
  class={slots.base({ className })}
  data-orientation={orientation}
  data-part="root"
  data-scope="button-group"
>
  <slot />
</fieldset>
