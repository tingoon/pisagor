---
import type { StatusRootContract } from "@pisagor/contracts";
import { statusRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"span"> & StatusRootContract;

const {
  size,
  variant,
  recipe = statusRecipe,
  class: className,
  ...rest
} = Astro.props;
---

<span
  {...rest}
  class={recipe({ className, size, variant })}
  data-part="indicator"
  data-scope="status"
  data-size={size}
>
  <slot />
</span>
