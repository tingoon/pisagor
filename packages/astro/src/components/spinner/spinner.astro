---
import { spinnerRecipe } from "@pisagor/recipes/spinner";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"svg">;

const { "aria-label": ariaLabel, class: className, ...rest } = Astro.props;
---

<svg
  {...rest}
  aria-hidden={ariaLabel ? undefined : true}
  aria-label={ariaLabel ?? "Loading"}
  class={spinnerRecipe({ className })}
  data-part="root"
  data-scope="spinner"
  fill="currentColor"
  height="1em"
  role="status"
  viewBox="0 0 256 256"
  width="1em"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    d="M136,32V64a8,8,0,0,1-16,0V32a8,8,0,0,1,16,0Zm37.05,58.94a8,8,0,0,0,11.31,0l22.63-22.62a8,8,0,0,0-11.32-11.32L173.05,79.62A8,8,0,0,0,173.05,90.94ZM224,128a8,8,0,0,0-8-8H184a8,8,0,0,0,0,16h32A8,8,0,0,0,224,128ZM207,194.05a8,8,0,0,0-11.32,0l-22.62,22.63a8,8,0,0,0,11.32,11.32l22.62-22.63A8,8,0,0,0,207,194.05ZM128,184a8,8,0,0,0-8,8v32a8,8,0,0,0,16,0V192A8,8,0,0,0,128,184ZM79.62,173.05a8,8,0,0,0-11.32,11.32l22.63,22.62a8,8,0,0,0,11.31-11.31ZM72,128a8,8,0,0,0-8-8H32a8,8,0,0,0,0,16H64A8,8,0,0,0,72,128ZM90.94,79.62,68.32,57A8,8,0,0,0,57,68.32L79.62,90.94a8,8,0,0,0,11.32-11.32Z"
  ></path>
</svg>
