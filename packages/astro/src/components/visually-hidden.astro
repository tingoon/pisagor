---
import type { VisuallyHiddenRootContract } from "@pisagor/props";
import { visuallyHiddenRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"span"> & VisuallyHiddenRootContract;

const {
  recipe = visuallyHiddenRecipe,
  class: className,
  ...rest
} = Astro.props;
---

<span
  {...rest}
  class={recipe({ className })}
  data-part="root"
  data-scope="visually-hidden"
>
  <slot />
</span>
