---
import type { SkipNavRootContract } from "@pisagor/contracts";
import { skipNavRecipe } from "@pisagor/recipes";
import { defaultMessages } from "@pisagor/utils";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a">, SkipNavRootContract {
  /**
   * The id of the element to skip to.
   *
   * @defaultValue "skip-nav-content"
   */
  id?: string;
}

const SKIP_NAV_ID = "skip-nav-content";
const {
  id = SKIP_NAV_ID,
  recipe = skipNavRecipe,
  class: className,
  ...rest
} = Astro.props;
const slots = recipe();
---

<a
  {...rest}
  class={slots.link({ className })}
  data-part="link"
  data-scope="skip-nav"
  href={`#${id}`}
>
  <slot>{defaultMessages["skipNav.label"]}</slot>
</a>
