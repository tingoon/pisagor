---
interface Props {
  /** Number value to format. */
  value: number;
  /** BCP 47 locale. Defaults to the runtime default locale. */
  locale?: string;
  /** Extra options forwarded to `Intl.NumberFormat`. */
  options?: Intl.NumberFormatOptions;
}

const { value, locale, options } = Astro.props;
const formatted = new Intl.NumberFormat(locale, options).format(value);
---

{formatted}
