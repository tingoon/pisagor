---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"span"> {
  /** Target date for relative formatting. */
  value: Date | string | number;
  /** BCP 47 locale. Defaults to the runtime default locale. */
  locale?: string;
  /** Numeric style for `Intl.RelativeTimeFormat`. */
  numeric?: Intl.RelativeTimeFormatOptions["numeric"];
  /** Style for `Intl.RelativeTimeFormat`. */
  style?: Intl.RelativeTimeFormatOptions["style"];
}

const DIVISIONS: { amount: number; unit: Intl.RelativeTimeFormatUnit }[] = [
  { amount: 60, unit: "second" },
  { amount: 60, unit: "minute" },
  { amount: 24, unit: "hour" },
  { amount: 7, unit: "day" },
  { amount: 4.34524, unit: "week" },
  { amount: 12, unit: "month" },
  { amount: Number.POSITIVE_INFINITY, unit: "year" },
];

function formatRelativeTime(
  date: Date,
  locale: string | undefined,
  numeric: Intl.RelativeTimeFormatOptions["numeric"],
  style: Intl.RelativeTimeFormatOptions["style"],
): string {
  const formatter = new Intl.RelativeTimeFormat(locale, { numeric, style });
  let duration = (date.getTime() - Date.now()) / 1000;

  for (const division of DIVISIONS) {
    if (Math.abs(duration) < division.amount) {
      return formatter.format(Math.round(duration), division.unit);
    }

    duration /= division.amount;
  }

  return formatter.format(Math.round(duration), "year");
}

const {
  value,
  locale,
  numeric = "auto",
  style = "long",
  class: className,
  ...rest
} = Astro.props;

const date = value instanceof Date ? value : new Date(value);
const formatted = formatRelativeTime(date, locale, numeric, style);
---

<span {...rest} class={className} data-part="root" data-scope="format">
  {formatted}
</span>
