---
import type { ButtonProps as BaseButtonProps } from "@pisagor/props";
import { buttonRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";
import Spinner from "./spinner.astro";

type Props = HTMLAttributes<"button"> & BaseButtonProps;

const {
  clickEffect = true,
  loading = false,
  pill = false,
  size = "md",
  variant = "default",
  disabled,
  type = "button",
  recipe = buttonRecipe,
  class: className,
  ...rest
} = Astro.props;

const slots = recipe({ clickEffect, loading, pill, size, variant });
const content = loading ? await Astro.slots.render("default") : "";
---

<button
  {...rest}
  aria-busy={loading || undefined}
  class={slots.base({ className })}
  data-part="root"
  data-scope="button"
  data-size={size}
  data-state={loading ? "loading" : "idle"}
  data-variant={variant}
  disabled={disabled || loading}
  type={type}
>
  {loading ? (
    <>
      <span aria-hidden="true" class={slots.hidden()} set:html={content} />
      <span class={slots.srOnly()} set:html={content} />
      <span class={slots.spinner()}>
        <Spinner aria-hidden="true" />
      </span>
    </>
  ) : (
    <slot />
  )}
</button>
