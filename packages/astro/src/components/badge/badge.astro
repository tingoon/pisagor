---
import type { BadgeProps as BadgeSharedProps } from "@pisagor/props";
import { badgeRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"span"> & BadgeSharedProps;

const {
  pill = false,
  size = "md",
  variant = "default",
  class: className,
  ...rest
} = Astro.props;
---

<span
  {...rest}
  class={badgeRecipe({ className, pill, size, variant })}
  data-part="root"
  data-scope="badge"
  data-size={size}
  data-variant={variant}
>
  <slot />
</span>
