---
import { proseRecipe } from "@pisagor/recipes/prose";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /**
   * Trusted HTML content. When set, the default slot is ignored.
   */
  html?: string;
}

const { html, class: className, ...rest } = Astro.props;
---

{html ? (
  <div
    {...rest}
    class={proseRecipe({ className })}
    data-part="root"
    data-scope="prose"
    set:html={html}
  />
) : (
  <div
    {...rest}
    class={proseRecipe({ className })}
    data-part="root"
    data-scope="prose"
  >
    <slot />
  </div>
)}
