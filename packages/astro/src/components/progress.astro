---
import type { ProgressProps as BaseProgressProps } from "@pisagor/props";
import {
  fieldRecipe,
  type ProgressRecipeSlot,
  progressRecipe,
} from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";
import { createSlotRecipeContext } from "../internal/create-slot-recipe-context";
import type { VariantClassNames } from "../internal/types";

interface Props extends HTMLAttributes<"div">, BaseProgressProps {
  /**
   * The orientation of the progress bar.
   *
   * @defaultValue "horizontal"
   */
  orientation?: "horizontal" | "vertical";
  /**
   * Whether to show indeterminate progress.
   *
   * @defaultValue false
   */
  indeterminate?: boolean;
  /**
   * When true, renders the numeric value text beside the label.
   */
  isValueVisible?: boolean;
  /**
   * The value of the progress bar.
   *
   * @defaultValue 0
   */
  value?: number;
  /**
   * The minimum value.
   *
   * @defaultValue 0
   */
  min?: number;
  /**
   * The maximum value.
   *
   * @defaultValue 100
   */
  max?: number;
  /** Optional label rendered above the progress bar. */
  label?: string;
  /** Slot class names */
  classNames?: VariantClassNames<ProgressRecipeSlot>;
}

const { useStyles, withContext, withProvider } = createSlotRecipeContext({
  name: "Progress",
  recipe: progressRecipe,
});

const {
  orientation = "horizontal",
  indeterminate = false,
  isValueVisible = false,
  value = 0,
  min = 0,
  max = 100,
  label,
  style,
  classNames,
  ...rest
} = Astro.props;

const clamped = Math.min(Math.max(value, min), max);
const percent = max === min ? 0 : ((clamped - min) / (max - min)) * 100;
const state = indeterminate
  ? "indeterminate"
  : clamped === max
    ? "complete"
    : "loading";
const valueText = indeterminate ? "loading..." : `${Math.round(percent)}%`;
const rangeStyle = indeterminate
  ? undefined
  : `${orientation === "horizontal" ? "width" : "height"}:${percent}%`;
const rootStyle = indeterminate
  ? style
  : [typeof style === "string" ? style : "", `--percent:${percent}`]
      .filter(Boolean)
      .join(";");

const fieldLabelClass = fieldRecipe().label();
const { slots } = useStyles();
const root = withProvider(rest, { name: "Root", slot: "base" });
const header = withContext({ class: classNames?.header }, { name: "Header" });
const track = withContext({ class: classNames?.track }, { name: "Track" });
const range = withContext({ class: classNames?.range }, { name: "Range" });
const showHeader = Boolean(label) || isValueVisible;
---

<div
  {...root.props}
  data-max={max}
  data-orientation={orientation}
  data-state={state}
  data-value={indeterminate ? undefined : clamped}
  style={rootStyle}
>
  {showHeader && (
    <div {...header.props}>
      {label ? (
        // biome-ignore lint/a11y/noLabelWithoutControl: mirrors the React Progress.Label DOM; the track carries aria-label
        <label class={fieldLabelClass}>{label}</label>
      ) : null}
      {isValueVisible && (
        <span
          aria-live="polite"
          class={`${slots.value({ class: classNames?.value })} ${fieldLabelClass}`}
          data-part="value"
          data-scope="progress"
        >
          {valueText}
        </span>
      )}
    </div>
  )}
  <slot />
  <div
    {...track.props}
    aria-label={valueText}
    aria-valuemax={max}
    aria-valuemin={min}
    aria-valuenow={indeterminate ? undefined : clamped}
    data-max={max}
    data-orientation={orientation}
    data-state={state}
    role="progressbar"
  >
    <div
      {...range.props}
      data-orientation={orientation}
      data-state={state}
      style={rangeStyle}
    ></div>
  </div>
</div>
