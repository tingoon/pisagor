---
import type { AlertContract, AlertRootContract } from "@pisagor/contracts";
import type { HTMLAttributes } from "astro/types";
import AlertAction from "./alert-action.astro";
import AlertDescription from "./alert-description.astro";
import AlertRoot from "./alert-root.astro";
import AlertTitle from "./alert-title.astro";

interface Props
  extends Omit<HTMLAttributes<"div">, "title">,
    AlertRootContract,
    AlertContract {
  title?: string;
  description?: string;
  icon?: null;
}

const { title, description, classNames, icon, ...rest } = Astro.props;
const hasIcon = Astro.slots.has("icon");
const DEFAULT_ICON_PATHS: Record<string, string> = {
  destructive:
    "M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm-8-80V80a8,8,0,0,1,16,0v56a8,8,0,0,1-16,0Zm20,36a12,12,0,1,1-12-12A12,12,0,0,1,140,172Z",
  info: "M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176ZM112,84a12,12,0,1,1,12,12A12,12,0,0,1,112,84Z",
  success:
    "M173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34ZM232,128A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z",
  warning:
    "M236.8,188.09,149.35,36.22h0a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM222.93,203.8a8.5,8.5,0,0,1-7.48,4.2H40.55a8.5,8.5,0,0,1-7.48-4.2,7.59,7.59,0,0,1,0-7.72L120.52,44.21a8.75,8.75,0,0,1,15,0l87.45,151.87A7.59,7.59,0,0,1,222.93,203.8ZM120,144V104a8,8,0,0,1,16,0v40a8,8,0,0,1-16,0Zm20,36a12,12,0,1,1-12-12A12,12,0,0,1,140,180Z",
};
const defaultIconPath =
  icon === null ? undefined : DEFAULT_ICON_PATHS[rest.variant ?? "default"];
const hasAction = Astro.slots.has("action");
const hasTitle = Astro.slots.has("title") || title !== undefined;
const hasDescription =
  Astro.slots.has("description") || description !== undefined;
---

<AlertRoot {...rest}>
  {hasIcon && <slot name="icon" />}
  {!hasIcon && defaultIconPath && (
    <svg
      aria-hidden="true"
      fill="currentColor"
      height="1em"
      viewBox="0 0 256 256"
      width="1em"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path d={defaultIconPath} />
    </svg>
  )}
  {hasTitle && (
    <AlertTitle class={classNames?.title}>
      {title ?? <slot name="title" />}
    </AlertTitle>
  )}
  {hasDescription && (
    <AlertDescription class={classNames?.description}>
      {description ?? <slot name="description" />}
    </AlertDescription>
  )}
  {hasAction && (
    <AlertAction class={classNames?.action}>
      <slot name="action" />
    </AlertAction>
  )}
</AlertRoot>
