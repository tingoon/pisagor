---
import type { AlertVariantProps } from "@pisagor/recipes/alert";
import type { HTMLAttributes } from "astro/types";
import AlertAction from "./alert-action.astro";
import AlertDescription from "./alert-description.astro";
import AlertRoot from "./alert-root.astro";
import AlertTitle from "./alert-title.astro";

interface Props extends Omit<HTMLAttributes<"div">, "title">, AlertVariantProps {
  /** Bold title line. */
  title?: string;
  /** Description content. */
  description?: string;
}

const { variant = "default", title, description, ...rest } = Astro.props;
const hasIcon = Astro.slots.has("icon");
const hasAction = Astro.slots.has("action");
const hasTitle = Astro.slots.has("title") || title !== undefined;
const hasDescription = Astro.slots.has("description") || description !== undefined;
---

<AlertRoot {...rest} variant={variant}>
  {hasIcon && <slot name="icon" />}
  {hasTitle && <AlertTitle>{title ?? <slot name="title" />}</AlertTitle>}
  {hasDescription && <AlertDescription>{description ?? <slot name="description" />}</AlertDescription>}
  {hasAction && (
  <AlertAction>
    <slot name="action" />
  </AlertAction>
)}
</AlertRoot>
