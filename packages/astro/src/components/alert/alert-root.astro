---
import type { AlertProps as BaseAlertProps } from "@pisagor/props";
import { alertRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"div">, "title"> & BaseAlertProps;

const { variant = "default", class: className, ...rest } = Astro.props;
const slots = alertRecipe({ variant });
---

<div
  {...rest}
  class={slots.base({ className })}
  data-part="root"
  data-scope="alert"
>
  <slot />
</div>
