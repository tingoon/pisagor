---
import { type AlertVariantProps, alertRecipe } from "@pisagor/recipes/alert";
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"div">, "title"> & AlertVariantProps;

const { variant = "default", class: className, ...rest } = Astro.props;
const slots = alertRecipe({ variant });
---

<div {...rest} class={slots.base({ className })} data-part="root" data-scope="alert">
  <slot />
</div>
