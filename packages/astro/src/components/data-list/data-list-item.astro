---
import type { DataListItemProps as BaseDataListItemProps } from "@pisagor/props";
import type { DataListItemRecipeSlot } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";
import type { VariantClassNames } from "../../internal/types";
import { withContext, withProvider } from "./data-list.context";

interface Props extends HTMLAttributes<"div">, BaseDataListItemProps {
  /** Value rendered as `dd`. */
  value?: string;
  /** Slot class names */
  classNames?: VariantClassNames<DataListItemRecipeSlot>;
}

const { value, classNames, ...rest } = Astro.props;
const item = withProvider(rest, {
  defaultProps: { "data-part": "item" },
  name: "Item",
  slot: "base",
});
const label = withContext(
  { class: classNames?.label },
  {
    defaultProps: { "data-part": "item-label" },
    name: "ItemLabel",
    slot: "label",
  },
);
const valuePart = withContext(
  { class: classNames?.value },
  {
    defaultProps: { "data-part": "item-value" },
    name: "ItemValue",
    slot: "value",
  },
);
const hasLabel = Astro.slots.has("default");
const hasValue = value !== undefined || Astro.slots.has("value");
---

<div {...item.props}>
  {hasLabel && (
    <dt {...label.props}>
      <slot />
    </dt>
  )}
  {hasValue && <dd {...valuePart.props}>{value ?? <slot name="value" />}</dd>}
</div>
