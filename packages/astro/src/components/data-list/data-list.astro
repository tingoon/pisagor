---
import type {
  DataListContract,
  DataListPresetItem as BaseDataListPresetItem,
  DataListRootContract,
} from "@pisagor/contracts";
import type { HTMLAttributes } from "astro/types";
import DataListItem from "./data-list-item.astro";
import DataListRoot from "./data-list-root.astro";

interface DataListPresetItem
  extends Omit<BaseDataListPresetItem, "label" | "value"> {
  label: string;
  value: string;
}

interface Props
  extends HTMLAttributes<"dl">,
    DataListRootContract,
    DataListContract {
  /**
   * The orientation of the data list.
   *
   * @defaultValue "horizontal"
   */
  orientation?: "horizontal" | "vertical";
  items?: DataListPresetItem[];
}

const { orientation = "horizontal", items = [], ...rest } = Astro.props;
---

<DataListRoot {...rest} orientation={orientation}>
  {items.map((item) => (
    <DataListItem value={item.value}>{item.label}</DataListItem>
  ))}
  <slot />
</DataListRoot>
