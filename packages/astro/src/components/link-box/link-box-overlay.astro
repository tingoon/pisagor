---
import type { HTMLAttributes } from "astro/types";
import { withContext } from "./link-box.context";

type Props = HTMLAttributes<"a">;

const overlay = withContext(Astro.props, { name: "Overlay", slot: "overlay" });
---

{/* biome-ignore lint/a11y/useAnchorContent: content is the default slot */}
{/* biome-ignore lint/a11y/useValidAnchor: href is forwarded from props */}
<a {...overlay.props}>
  <slot />
</a>
