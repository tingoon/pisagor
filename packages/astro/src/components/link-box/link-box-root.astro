---
import type { LinkBoxProps as BaseLinkBoxProps } from "@pisagor/props";
import type { HTMLAttributes } from "astro/types";
import { withProvider } from "./link-box.context";

type Props = HTMLAttributes<"div"> & BaseLinkBoxProps;

const root = withProvider(Astro.props, { name: "Root", slot: "base" });
---

<div {...root.props}>
  <slot />
</div>
