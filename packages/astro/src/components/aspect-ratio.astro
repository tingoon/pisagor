---
import type {
  AspectRatioRootContract,
  AspectRatioContract,
} from "@pisagor/contracts";
import { aspectRatioRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> &
  AspectRatioRootContract &
  AspectRatioContract;

const {
  ratio,
  style,
  recipe = aspectRatioRecipe,
  class: className,
  ...rest
} = Astro.props;

const mergedStyle =
  ratio === undefined
    ? style
    : [typeof style === "string" ? style : "", `--ratio:${ratio}`]
        .filter(Boolean)
        .join(";");
---

<div
  {...rest}
  class={recipe({ className })}
  data-part="root"
  data-scope="aspect-ratio"
  style={mergedStyle}
>
  <slot />
</div>
