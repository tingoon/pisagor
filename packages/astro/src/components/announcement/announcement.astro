---
import type {
  AnnouncementContract,
  AnnouncementRootContract,
} from "@pisagor/props";
import type { HTMLAttributes } from "astro/types";
import AnnouncementRoot from "./announcement-root.astro";
import AnnouncementTitle from "./announcement-title.astro";

interface Props
  extends Omit<HTMLAttributes<"div">, "title" | "role">,
    AnnouncementRootContract,
    AnnouncementContract {
  /**
   * The ARIA role of the announcement.
   *
   * @defaultValue "status"
   */
  role?: "status" | "alert";
  title?: string;
}

const { title, ...rest } = Astro.props;
const hasBadge = Astro.slots.has("badge");
const hasTitle = Astro.slots.has("title") || title !== undefined;
---

<AnnouncementRoot {...rest}>
  {hasBadge && <slot name="badge" />}
  {hasTitle && (
    <AnnouncementTitle>{title ?? <slot name="title" />}</AnnouncementTitle>
  )}
  <slot />
</AnnouncementRoot>
