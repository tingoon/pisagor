---
import { announcementRecipe } from "@pisagor/recipes/announcement";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"span">;

const { class: className, ...rest } = Astro.props;
const slots = announcementRecipe();
---

<span {...rest} class={slots.title({ className })} data-part="title" data-scope="announcement">
  <slot />
</span>
