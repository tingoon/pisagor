---
import type { AnnouncementRootContract } from "@pisagor/props";
import type { HTMLAttributes } from "astro/types";
import { withProvider } from "./announcement.context";

interface Props
  extends Omit<HTMLAttributes<"div">, "role">,
    AnnouncementRootContract {
  /**
   * The ARIA role of the announcement.
   *
   * @defaultValue "status"
   */
  role?: "status" | "alert";
}

const root = withProvider(Astro.props, {
  defaultProps: { role: "status" },
  name: "Root",
  slot: "base",
});
---

<div {...root.props}>
  <slot />
</div>
