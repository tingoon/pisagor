---
import type { SkeletonProps as BaseSkeletonProps } from "@pisagor/props";
import { skeletonRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";
import type { SizeScaleProps } from "../../internal";

type Props = HTMLAttributes<"div"> & BaseSkeletonProps & SizeScaleProps;

const {
  size = "md",
  recipe = skeletonRecipe,
  class: className,
  ...rest
} = Astro.props;
const slots = recipe({ size });
---

<div
  {...rest}
  class={slots.circle({ className })}
  data-part="circle"
  data-scope="skeleton"
>
  <slot />
</div>
