---
import type { SkeletonRootContract } from "@pisagor/props";
import { skeletonRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & SkeletonRootContract;

const {
  size = "md",
  recipe = skeletonRecipe,
  class: className,
  ...rest
} = Astro.props;
const slots = recipe({ size });
---

<div
  {...rest}
  class={slots.base({ className })}
  data-part="root"
  data-scope="skeleton"
>
  <slot />
</div>
