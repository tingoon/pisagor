---
import type { SkeletonRootContract } from "@pisagor/props";
import { skeletonRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div">, SkeletonRootContract {
  /**
   * The number of lines of the skeleton text.
   *
   * @defaultValue 2
   */
  lines?: number;
}

const {
  lines = 2,
  size = "md",
  recipe = skeletonRecipe,
  class: className,
  ...rest
} = Astro.props;
const slots = recipe({ size });
---

<div
  {...rest}
  class={slots.text({ className })}
  data-part="text"
  data-scope="skeleton"
>
  {Array.from({ length: lines }).map(() => <div class={slots.line()} />)}
</div>
