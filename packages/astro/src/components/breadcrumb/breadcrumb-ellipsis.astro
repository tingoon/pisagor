---
import type { HTMLAttributes } from "astro/types";
import { useBreadcrumb } from "./breadcrumb.context";

type Props = HTMLAttributes<"span">;

const { slots } = useBreadcrumb();
---

<span
  {...Astro.props}
  aria-hidden="true"
  data-part="ellipsis"
  data-scope="breadcrumb"
  role="presentation"
>
  <svg
    aria-hidden="true"
    class={slots.ellipsis()}
    fill="currentColor"
    height="1em"
    viewBox="0 0 256 256"
    width="1em"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M140,128a12,12,0,1,1-12-12A12,12,0,0,1,140,128Zm56-12a12,12,0,1,0,12,12A12,12,0,0,0,196,116ZM60,116a12,12,0,1,0,12,12A12,12,0,0,0,60,116Z"
    />
  </svg>
</span>
