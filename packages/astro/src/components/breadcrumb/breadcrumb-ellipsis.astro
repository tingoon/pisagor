---
import { breadcrumbRecipe } from "@pisagor/recipes/breadcrumb";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"span">;

const { class: className, ...rest } = Astro.props;
const slots = breadcrumbRecipe();
---

<span {...rest} aria-hidden="true" data-part="ellipsis" data-scope="breadcrumb" role="presentation">
  <svg
    aria-hidden="true"
    class={slots.ellipsis({ className })}
    fill="currentColor"
    height="1em"
    viewBox="0 0 256 256"
    width="1em"
  >
    <path
      d="M128,96a32,32,0,1,0,32,32A32,32,0,0,0,128,96Zm0,48a16,16,0,1,1,16-16A16,16,0,0,1,128,144ZM48,96a32,32,0,1,0,32,32A32,32,0,0,0,48,96Zm0,48a16,16,0,1,1,16-16A16,16,0,0,1,48,144ZM208,96a32,32,0,1,0,32,32A32,32,0,0,0,208,96Zm0,48a16,16,0,1,1,16-16A16,16,0,0,1,208,144Z"
    ></path>
  </svg>
</span>
