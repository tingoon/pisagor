---
import type { BreadcrumbItemProps as BaseBreadcrumbItemProps } from "@pisagor/props";
import type { HTMLAttributes } from "astro/types";
import { withBreadcrumbItemProvider } from "./breadcrumb.context";

type Props = HTMLAttributes<"li"> & BaseBreadcrumbItemProps;

const item = withBreadcrumbItemProvider(Astro.props, {
  name: "Item",
  slot: "base",
});
---

<li {...item.props}>
  <slot />
</li>
