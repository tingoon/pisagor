---
import type { HTMLAttributes } from "astro/types";
import { withBreadcrumbItemContext } from "./breadcrumb.context";

type Props = HTMLAttributes<"a">;

const link = withBreadcrumbItemContext(Astro.props, { name: "Link" });
---

{/* biome-ignore lint/a11y/useAnchorContent: content is the default slot */}
{/* biome-ignore lint/a11y/useValidAnchor: href is forwarded from props */}
<a {...link.props}>
  <slot />
</a>
