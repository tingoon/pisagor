---
import { breadcrumbItemRecipe } from "@pisagor/recipes/breadcrumb";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { class: className, href, ...rest } = Astro.props;
const slots = breadcrumbItemRecipe();
---

<a {...rest} class={slots.link({ className })} data-part="link" data-scope="breadcrumb" href={href}>
  <slot>Page</slot>
</a>
