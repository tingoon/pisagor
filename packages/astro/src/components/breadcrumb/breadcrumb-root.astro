---
import type { BreadcrumbRootContract } from "@pisagor/props";
import { defaultMessages } from "@pisagor/utils";
import type { HTMLAttributes } from "astro/types";

interface Props
  extends HTMLAttributes<"nav">,
    Omit<BreadcrumbRootContract, "items"> {
  /**
   * Accessible label for the breadcrumb navigation landmark.
   *
   * @defaultValue "Breadcrumb"
   */
  "aria-label"?: string;
}

const {
  "aria-label": ariaLabel = defaultMessages["breadcrumb.label"],
  recipe: _recipe,
  ...rest
} = Astro.props;
---

<nav {...rest} aria-label={ariaLabel} data-part="root" data-scope="breadcrumb">
  <slot />
</nav>
