---
import type { HTMLAttributes } from "astro/types";
import { withBreadcrumbContext } from "./breadcrumb.context";

type Props = HTMLAttributes<"ol">;

const list = withBreadcrumbContext(Astro.props, {
  defaultProps: { role: "list" },
  name: "List",
});
---

<ol {...list.props}>
  <slot />
</ol>
