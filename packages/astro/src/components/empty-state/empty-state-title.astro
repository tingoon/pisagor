---
import type { HTMLAttributes } from "astro/types";
import { withContext } from "./empty-state.context";

type Props = HTMLAttributes<"h3">;

const title = withContext(Astro.props, { name: "Title", slot: "title" });
---

{/* biome-ignore lint/a11y/useHeadingContent: content is the default slot */}
<h3 {...title.props}>
  <slot />
</h3>
