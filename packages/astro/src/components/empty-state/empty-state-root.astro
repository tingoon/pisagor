---
import type { EmptyStateRootContract } from "@pisagor/contracts";
import type { HTMLAttributes } from "astro/types";
import { withProvider } from "./empty-state.context";

type Props = HTMLAttributes<"div"> & EmptyStateRootContract;

const root = withProvider(Astro.props, { name: "Root", slot: "base" });
---

<div {...root.props}>
  <slot />
</div>
