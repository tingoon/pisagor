---
import type { InputGroupTextRootContract } from "@pisagor/props";
import { inputGroupTextRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"span"> & InputGroupTextRootContract;

const {
  recipe = inputGroupTextRecipe,
  class: className,
  ...rest
} = Astro.props;
---

<span
  {...rest}
  class={recipe({ className })}
  data-part="text"
  data-scope="input-group"
>
  <slot />
</span>
