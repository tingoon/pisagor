---
import type {
  ButtonProps as BaseButtonProps,
  InputGroupButtonProps as BaseInputGroupButtonProps,
} from "@pisagor/props";
import { inputGroupButtonRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";
import Button from "../button/button.astro";

type Props = Omit<
  HTMLAttributes<"button"> & BaseButtonProps,
  "size" | "recipe"
> &
  BaseInputGroupButtonProps;

const {
  size = "xs",
  variant = "ghost",
  class: className,
  ...rest
} = Astro.props;
---

<Button
  {...rest}
  class={inputGroupButtonRecipe({ className, size })}
  data-part="button"
  data-scope="input-group"
  data-size={size}
  size={size}
  variant={variant}
>
  <slot />
</Button>
