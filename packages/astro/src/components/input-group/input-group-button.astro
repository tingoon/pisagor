---
import type {
  ButtonRootContract,
  InputGroupButtonRootContract,
} from "@pisagor/contracts";
import { inputGroupButtonRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";
import Button from "../button.astro";

type Props = Omit<
  HTMLAttributes<"button"> & ButtonRootContract,
  "size" | "recipe"
> &
  InputGroupButtonRootContract;

const {
  size = "xs",
  variant = "ghost",
  recipe = inputGroupButtonRecipe,
  class: className,
  ...rest
} = Astro.props;
---

<Button
  {...rest}
  class={recipe({ className, size })}
  data-part="button"
  data-scope="input-group"
  data-size={size}
  variant={variant}
>
  <slot />
</Button>
