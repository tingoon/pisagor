---
import type { InputGroupAddonProps as InputGroupAddonSharedProps } from "@pisagor/props";
import { inputGroupAddonRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & InputGroupAddonSharedProps;

const { align = "inline-start", class: className, ...rest } = Astro.props;
---

<div
  {...rest}
  class={inputGroupAddonRecipe({ align, className })}
  data-align={align}
  data-part="addon"
  data-scope="input-group"
>
  <slot />
</div>
