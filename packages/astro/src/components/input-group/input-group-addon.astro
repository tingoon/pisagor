---
import type { InputGroupAddonProps as BaseInputGroupAddonProps } from "@pisagor/props";
import { inputGroupAddonRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & BaseInputGroupAddonProps;

const {
  align = "inline-start",
  recipe = inputGroupAddonRecipe,
  class: className,
  ...rest
} = Astro.props;
---

{/* biome-ignore lint/a11y/useSemanticElements: mirrors the React InputGroup.Addon DOM (div role="group") */}
<div
  {...rest}
  class={recipe({ align, className })}
  data-align={align}
  data-part="addon"
  data-scope="input-group"
  role="group"
>
  <slot />
</div>
