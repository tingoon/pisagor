---
import type { FormControlGroupShellProps as FormControlGroupShellSharedProps } from "@pisagor/props";
import {
  formControlGroupShellRecipe,
  inputGroupRootRecipe,
} from "@pisagor/recipes";
import { cn } from "@pisagor/utils";
import type { HTMLAttributes } from "astro/types";

type FormControlVariant = "primary" | "secondary";

type Props = HTMLAttributes<"div"> & FormControlGroupShellSharedProps;

const {
  size = "md",
  variant: variantProp,
  class: className,
  ...rest
} = Astro.props;
const variant = variantProp ?? ("primary" as FormControlVariant);
---

<div
  {...rest}
  class={formControlGroupShellRecipe({
  className: cn(inputGroupRootRecipe(), className),
  size,
  variant,
})}
  data-part="root"
  data-scope="input-group"
  data-size={size}
  data-variant={variant}
>
  <slot />
</div>
