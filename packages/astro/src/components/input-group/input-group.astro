---
import {
  type FormControlGroupShellVariantProps,
  formControlGroupShellRecipe,
} from "@pisagor/recipes/form-control";
import type { HTMLAttributes } from "astro/types";

type FormControlVariant = "primary" | "secondary";

type Props = HTMLAttributes<"div"> & FormControlGroupShellVariantProps;

const { size = "md", variant: variantProp, class: className, ...rest } = Astro.props;
const variant = variantProp ?? ("primary" as FormControlVariant);
---

<div
  {...rest}
  class={formControlGroupShellRecipe({ className, size, variant })}
  data-part="root"
  data-scope="input-group"
  data-size={size}
  data-variant={variant}
  role="group"
>
  <slot />
</div>
