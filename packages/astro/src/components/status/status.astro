---
import { type StatusVariantProps, statusRecipe } from "@pisagor/recipes/status";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"span"> & StatusVariantProps;

const {
  size = "md",
  variant = "default",
  class: className,
  ...rest
} = Astro.props;
---

<span
  {...rest}
  class={statusRecipe({ className, size, variant })}
  data-part="indicator"
  data-scope="status"
  data-size={size}
>
  <slot />
</span>
