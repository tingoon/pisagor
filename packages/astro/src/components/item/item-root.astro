---
import type { ItemRootContract } from "@pisagor/contracts";
import type { HTMLAttributes } from "astro/types";
import { withProvider } from "./item.context";

type Props = HTMLAttributes<"div"> & ItemRootContract;

const root = withProvider(Astro.props, { name: "Root" });
---

<div {...root.props}>
  <slot />
</div>
