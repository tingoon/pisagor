---
import type { ItemProps as BaseItemProps } from "@pisagor/props";
import { itemRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div">, BaseItemProps {}

const { variant = "default", class: className, ...rest } = Astro.props;
const slots = itemRecipe();
---

<div
  {...rest}
  class={slots.media({ className, variant })}
  data-part="media"
  data-scope="item"
  data-variant={variant}
>
  <slot />
</div>
