---
import type { ItemVariantProps } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";
import { useItem } from "./item.context";

type Props = HTMLAttributes<"div"> & ItemVariantProps;

const { variant = "default", class: className, ...rest } = Astro.props;
const { slots } = useItem();
---

<div
  {...rest}
  class={slots.media({ class: className, variant })}
  data-part="media"
  data-scope="item"
  data-variant={variant}
>
  <slot />
</div>
