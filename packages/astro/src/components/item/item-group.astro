---
import { type ItemVariantProps, itemRecipe } from "@pisagor/recipes/item";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div">, ItemVariantProps {}

const { variant = "default", class: className, ...rest } = Astro.props;
const slots = itemRecipe();
---

<div
  {...rest}
  class={slots.group({ className })}
  data-part="group"
  data-scope="item"
  data-variant={variant}
  role="list"
>
  <slot />
</div>
