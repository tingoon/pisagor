---
import type { ItemRootContract } from "@pisagor/props";
import { itemRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";
import Separator from "../separator.astro";

type Props = HTMLAttributes<"div"> & ItemRootContract;

const { recipe = itemRecipe, class: className, ...rest } = Astro.props;
const slots = recipe();
---

<Separator
  {...rest}
  class={slots.separator({ className })}
  data-part="separator"
  data-scope="item"
  orientation="horizontal"
/>
