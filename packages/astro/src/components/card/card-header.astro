---
import type { CardHeaderContract } from "@pisagor/contracts";
import type { HTMLAttributes } from "astro/types";
import { useStyles } from "./card.context";
import CardDescription from "./card-description.astro";
import CardTitle from "./card-title.astro";

interface Props
  extends Omit<HTMLAttributes<"div">, "title">,
    CardHeaderContract {
  description?: string;
  title?: string;
}

const { description, title, class: className, ...rest } = Astro.props;
const { slots } = useStyles();
---

<div
  {...rest}
  class={slots.header({ class: className })}
  data-part="header"
  data-scope="card"
>
  {title && <CardTitle>{title}</CardTitle>}
  {description && <CardDescription>{description}</CardDescription>}
  <slot />
</div>
