---
import type { CardRootContract } from "@pisagor/props";
import type { HTMLAttributes } from "astro/types";
import { withProvider } from "./card.context";

type Props = HTMLAttributes<"div"> & CardRootContract;

const root = withProvider(Astro.props, { name: "Root", slot: "base" });
---

<div {...root.props}>
  <slot />
</div>
