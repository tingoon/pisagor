---
import type { CardProps as BaseCardProps } from "@pisagor/props";
import type { HTMLAttributes } from "astro/types";
import type { SizeScaleProps } from "../../internal";
import { withProvider } from "./card.context";

type Props = HTMLAttributes<"div"> & BaseCardProps & SizeScaleProps;

const root = withProvider(Astro.props, { name: "Root", slot: "base" });
---

<div {...root.props}>
  <slot />
</div>
