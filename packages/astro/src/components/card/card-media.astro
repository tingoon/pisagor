---
import type { CardProps as CardSharedProps } from "@pisagor/props";
import { cardRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & CardSharedProps;

const { variant = "default", class: className, ...rest } = Astro.props;
const slots = cardRecipe();
---

<div
  {...rest}
  class={slots.media({ className, variant })}
  data-part="media"
  data-scope="card"
  data-variant={variant}
>
  <slot />
</div>
