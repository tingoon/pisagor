---
import type { TimelineProps as TimelineSharedProps } from "@pisagor/props";
import { timelineRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"ol"> & TimelineSharedProps;

const { orientation = "vertical", class: className, ...rest } = Astro.props;
---

<ol
  {...rest}
  class={timelineRecipe({ className, orientation })}
  data-orientation={orientation}
  data-part="root"
  data-scope="timeline"
>
  <slot />
</ol>
