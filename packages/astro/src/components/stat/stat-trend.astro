---
import type { StatTrendRootContract } from "@pisagor/contracts";
import { statTrendRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & StatTrendRootContract;

const {
  trend = "neutral",
  recipe = statTrendRecipe,
  class: className,
  ...rest
} = Astro.props;
---

<div
  {...rest}
  class={recipe({ className, trend })}
  data-part="trend"
  data-scope="stat"
  data-trend={trend}
>
  <slot />
</div>
