---
import type { StatTrendProps as StatTrendSharedProps } from "@pisagor/props";
import { statTrendRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & StatTrendSharedProps;

const { trend = "neutral", class: className, ...rest } = Astro.props;
---

<div
  {...rest}
  class={statTrendRecipe({ className, trend })}
  data-part="trend"
  data-scope="stat"
  data-trend={trend}
>
  <slot />
</div>
