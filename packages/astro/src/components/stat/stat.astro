---
import type { StatContract, StatRootContract } from "@pisagor/contracts";
import type { HTMLAttributes } from "astro/types";
import StatDescription from "./stat-description.astro";
import StatLabel from "./stat-label.astro";
import StatRoot from "./stat-root.astro";
import StatTrend from "./stat-trend.astro";
import StatValue from "./stat-value.astro";

interface Props extends HTMLAttributes<"div">, StatRootContract, StatContract {
  label?: string;
  value?: string;
  description?: string;
}

const { label, value, description, classNames, ...rest } = Astro.props;
const hasLabel = Astro.slots.has("label") || label !== undefined;
const hasValue = Astro.slots.has("value") || value !== undefined;
const hasDescription =
  Astro.slots.has("description") || description !== undefined;
const hasTrend = Astro.slots.has("trend");
---

<StatRoot {...rest}>
  {hasLabel && (
    <StatLabel class={classNames?.label}>
      {label ?? <slot name="label" />}
    </StatLabel>
  )}
  {hasValue && (
    <StatValue class={classNames?.value}>
      {value ?? <slot name="value" />}
    </StatValue>
  )}
  {hasDescription && (
    <StatDescription class={classNames?.description}>
      {description ?? <slot name="description" />}
    </StatDescription>
  )}
  {hasTrend && (
    <StatTrend>
      <slot name="trend" />
    </StatTrend>
  )}
</StatRoot>
