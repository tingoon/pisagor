---
import type { StatProps as StatSharedProps } from "@pisagor/props";
import { statRecipe } from "@pisagor/recipes";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & StatSharedProps;

const { variant = "outline", class: className, ...rest } = Astro.props;
const slots = statRecipe();
---

<div
  {...rest}
  class={slots.base({ className, variant })}
  data-part="root"
  data-scope="stat"
  data-variant={variant}
>
  <slot />
</div>
