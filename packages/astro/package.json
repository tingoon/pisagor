{
  "bugs": {
    "url": "https://github.com/tingoon/pisagor/issues"
  },
  "dependencies": {
    "@pisagor/recipes": "^0.1.0",
    "@pisagor/tokens": "^0.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "tw-animate-css": "^1.4.0"
  },
  "description": "Static Astro UI components built on Tailwind CSS recipes.",
  "devDependencies": {
    "@pisagor/tsconfig": "workspace:*",
    "astro": "catalog:"
  },
  "exports": {
    ".": "./src/components/index.ts",
    "./*": "./src/components/*/index.ts",
    "./styles": "./src/styles.css"
  },
  "files": [
    "src",
    "!**/*.stories.*",
    "!**/*.test.*"
  ],
  "homepage": "https://github.com/tingoon/pisagor#readme",
  "license": "MIT",
  "name": "@pisagor/astro",
  "peerDependencies": {
    "astro": "^7",
    "tailwindcss": "^4"
  },
  "repository": {
    "directory": "packages/astro",
    "type": "git",
    "url": "git+https://github.com/tingoon/pisagor.git"
  },
  "scripts": {
    "type-check": "tsc --noEmit"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "version": "0.2.0"
}
