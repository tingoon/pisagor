{
  "name": "@pisagor/svelte",
  "version": "1.0.0",
  "description": "Accessible Svelte UI components built on Ark UI and Tailwind CSS v4.",
  "homepage": "https://github.com/tingoon/pisagor#readme",
  "bugs": {
    "url": "https://github.com/tingoon/pisagor/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tingoon/pisagor.git",
    "directory": "packages/svelte"
  },
  "files": [
    "skills",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/components/index.ts",
    "./data-grid": "./src/components/data-grid/index.ts",
    "./data-table": "./src/components/data-table/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./phone-input": "./src/components/phone-input/index.ts",
    "./rich-text-editor": "./src/components/rich-text-editor/index.ts",
    "./styles": "./src/styles.css",
    "./utils": "./src/utils/index.ts"
  },
  "scripts": {
    "typecheck": "svelte-check-native --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@ark-ui/svelte": "^5.24.3",
    "@pisagor/contracts": "workspace:*",
    "@pisagor/recipes": "workspace:*",
    "@pisagor/tokens": "workspace:*",
    "@pisagor/utils": "workspace:*",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/svelte-table": "^9.3.1",
    "@tanstack/svelte-virtual": "^3.13.47",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.32.0",
    "libphonenumber-js": "^1.13.15",
    "phosphor-svelte": "^3.1.1",
    "remeda": "^2.53.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "svelte": "catalog:",
    "svelte-check-native": "^1.10.0",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "svelte": "^5",
    "tailwindcss": "^4"
  }
}
