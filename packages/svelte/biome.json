{
  "extends": "//",
  "html": {
    "formatter": {
      "enabled": false
    }
  },
  "linter": {
    "domains": {
      "svelte": "recommended"
    },
    "rules": {
      "a11y": {
        "noAutofocus": "off",
        "useAriaPropsForRole": "off",
        "useSemanticElements": "off"
      }
    }
  }
}
