{
  "compilerOptions": {
    "noUncheckedSideEffectImports": false,
    "paths": {
      "#/storybook/*": ["./.storybook/*"]
    }
  },
  "extends": "@pisagor/tsconfig/react-vite",
  "include": [
    "src",
    ".storybook",
    "vite.config.ts",
    "../../packages/react/src/**/*.stories.tsx",
    "../../packages/react-form/src/**/*.stories.tsx",
    "../../packages/react-blocks/src/**/*.stories.tsx"
  ]
}
