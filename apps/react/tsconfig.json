{
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "#/react-form/examples/fields/*": [
        "../../packages/react-form/examples/fields/*"
      ],
      "#/react-form/examples/integrations/*": [
        "../../packages/react-form/examples/integrations/*"
      ],
      "#/react/examples/actions/*": ["../../packages/react/examples/actions/*"],
      "#/react/examples/data-display/*": [
        "../../packages/react/examples/data-display/*"
      ],
      "#/react/examples/feedback/*": [
        "../../packages/react/examples/feedback/*"
