      "#/react/examples/forms/*": ["../../packages/react/examples/forms/*"],
      "#/react/examples/layout/*": ["../../packages/react/examples/layout/*"],
      "#/react/examples/marketing/*": [
        "../../packages/react/examples/marketing/*"
      ],
      "#/react/examples/media/*": ["../../packages/react/examples/media/*"],
      "#/react/examples/navigation/*": [
        "../../packages/react/examples/navigation/*"
      ],
      "#/react/examples/overlay/*": ["../../packages/react/examples/overlay/*"],
      "#/react/examples/utilities/*": [
        "../../packages/react/examples/utilities/*"
