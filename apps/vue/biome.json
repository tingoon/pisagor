{
  "extends": "//",
  "linter": {
    "domains": {
      "vue": "recommended"
    },
    "rules": {
      "style": {
        "useVueMultiWordComponentNames": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.stories.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    }
  ]
}
