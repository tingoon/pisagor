      "#/vue/examples/layout/*": ["../../packages/vue/examples/layout/*"],
      "#/vue/examples/marketing/*": ["../../packages/vue/examples/marketing/*"],
      "#/vue/examples/media/*": ["../../packages/vue/examples/media/*"],
      "#/vue/examples/navigation/*": [
        "../../packages/vue/examples/navigation/*"
      ],
      "#/vue/examples/overlay/*": ["../../packages/vue/examples/overlay/*"],
      "#/vue/examples/utilities/*": ["../../packages/vue/examples/utilities/*"]
