{
  "compilerOptions": {
    "jsx": "preserve",
    "paths": {
      "#/storybook/*": ["./.storybook/*"],
      "#/vue-form/examples/fields/*": [
        "../../packages/vue-form/examples/fields/*"
      ],
      "#/vue-form/examples/integrations/*": [
        "../../packages/vue-form/examples/integrations/*"
      ],
      "#/vue/examples/actions/*": ["../../packages/vue/examples/actions/*"],
      "#/vue/examples/data-display/*": [
        "../../packages/vue/examples/data-display/*"
      ],
      "#/vue/examples/feedback/*": ["../../packages/vue/examples/feedback/*"],
