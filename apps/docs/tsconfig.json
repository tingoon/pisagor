{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"],
      "#recipes-react/*": ["../react/src/recipes/*"],
      "#recipes-vue/*": ["../vue/src/recipes/*"]
    },
    "types": ["astro/client"]
  },
  "extends": "@pisagor/tsconfig/astro",
  "include": [".astro/types.d.ts", "src", "astro.config.ts"]
}
