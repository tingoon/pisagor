{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "#/*": ["./src/*"],
      "#/astro/*": ["../../packages/astro/*"],
      "#/astro/examples/*": ["../../packages/astro/examples/*"],
      "#/props/*": ["../../packages/props/*"],
      "#/react-form/*": ["../../packages/react-form/*"],
      "#/react-form/examples/*": ["../../packages/react-form/examples/*"],
      "#/react/*": ["../../packages/react/*"],
      "#/react/blocks/*": ["../react/src/blocks/*"],
      "#/react/examples/*": ["../../packages/react/examples/*"],
      "#/recipes/*": ["../../packages/recipes/*"],
      "#/solid-form/*": ["../../packages/solid-form/*"],
      "#/solid-form/examples/*": ["../../packages/solid-form/examples/*"],
      "#/solid/*": ["../../packages/solid/*"],
      "#/solid/blocks/*": ["../solid/src/blocks/*"],
      "#/solid/examples/*": ["../../packages/solid/examples/*"],
      "#/svelte-form/*": ["../../packages/svelte-form/*"],
      "#/svelte-form/examples/*": ["../../packages/svelte-form/examples/*"],
      "#/svelte/*": ["../../packages/svelte/*"],
      "#/svelte/blocks/*": ["../svelte/src/blocks/*"],
      "#/svelte/examples/*": ["../../packages/svelte/examples/*"],
      "#/tokens/*": ["../../packages/tokens/*"],
      "#/utils/*": ["../../packages/utils/*"],
      "#/vue-form/*": ["../../packages/vue-form/*"],
      "#/vue-form/examples/*": ["../../packages/vue-form/examples/*"],
      "#/vue/*": ["../../packages/vue/*"],
      "#/vue/blocks/*": ["../vue/src/blocks/*"],
      "#/vue/examples/*": ["../../packages/vue/examples/*"]
    },
    "types": ["astro/client"]
  },
  "extends": "../../tsconfig.json",
  "files": [
    "./css-modules.d.ts",
    "./react-global.d.ts",
    "./solid-global.d.ts",
    "./svelte-global.d.ts",
    "./vue-global.d.ts"
  ],
  "include": [".astro/types.d.ts", "src", "astro.config.ts"]
}
