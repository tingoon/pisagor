{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "#/*": ["./src/*"],
      "#/changelog/*": ["../../packages/*/CHANGELOG.md"],
      "#/react/blocks/*": ["../react/src/blocks/*"],
      "#/solid/blocks/*": ["../solid/src/blocks/*"],
      "#/svelte/blocks/*": ["../svelte/src/blocks/*"],
      "#/vue/blocks/*": ["../vue/src/blocks/*"]
    },
    "types": ["astro/client"]
  },
  "extends": "../../tsconfig.json",
  "include": [".astro/types.d.ts", "src", "astro.config.ts", "global.d.ts"]
}
