{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "#/*": ["./src/*"],
      "#/changelog/*": ["../../packages/*/CHANGELOG.md"],
      "#examples/astro/*": ["../../packages/astro/examples/*"],
      "#examples/react-blocks/*": ["./src/blocks/react/*"],
      "#examples/react-form/*": ["../../packages/react-form/examples/*"],
      "#examples/react/*": ["../../packages/react/examples/*"],
      "#examples/solid-blocks/*": ["./src/blocks/solid/*"],
      "#examples/solid-form/*": ["../../packages/solid-form/examples/*"],
      "#examples/solid/*": ["../../packages/solid/examples/*"],
      "#examples/svelte-blocks/*": ["./src/blocks/svelte/*"],
      "#examples/svelte-form/*": ["../../packages/svelte-form/examples/*"],
      "#examples/svelte/*": ["../../packages/svelte/examples/*"],
      "#examples/vue-blocks/*": ["./src/blocks/vue/*"],
      "#examples/vue-form/*": ["../../packages/vue-form/examples/*"],
      "#examples/vue/*": ["../../packages/vue/examples/*"]
    },
    "types": ["astro/client"]
  },
  "exclude": ["src/blocks/solid", "src/components/docs/solid"],
  "extends": "../../tsconfig.json",
  "include": [".astro/types.d.ts", "src", "astro.config.ts"]
}
