---
import type { ComponentDocs } from "#/lib/component-docs-types";
import type { Framework } from "#/lib/nav";
import ComponentMeta from "./component-meta.astro";
import PackageLinks from "./package-links.astro";

interface Props {
  framework: Framework;
  /** Override npm package shown in PackageLinks (forms). */
  packageName?: string;
  api?: ComponentDocs["api"];
  taxonomy?: ComponentDocs["taxonomy"];
  aliases?: string[];
}

const { api, taxonomy, aliases } = Astro.props;
---

<div
  class="flex max-w-full flex-wrap items-center justify-between gap-x-4 gap-y-2"
>
  {api && taxonomy ? (
    <ComponentMeta api={api} taxonomy={taxonomy} aliases={aliases} />
  ) : null}
  <PackageLinks
    class="ms-auto"
    framework={Astro.props.framework}
    packageName={Astro.props.packageName}
  />
</div>
