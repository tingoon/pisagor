---
import type { Framework } from "#/lib/nav";
import PackageLinks from "./package-links.astro";
import { DocsNavSegmentGroup } from "./react/docs-nav-segment-group";

interface Props {
  framework: Framework;
  /** Override npm package shown in PackageLinks (forms). */
  packageName?: string;
  /** Shorthand / Compound switch. */
  surfaces?: {
    shorthandHref: string;
    compoundHref: string;
    active?: "shorthand" | "compound";
  };
}

const { surfaces } = Astro.props;
---

<div
  class="flex max-w-full flex-wrap items-center justify-between gap-x-4 gap-y-2"
>
  {surfaces ? (
    <DocsNavSegmentGroup
      client:only="react"
      aria-label="Component surfaces"
      items={[
        {
          href: surfaces.shorthandHref,
          label: "Shorthand",
          value: "shorthand",
        },
        {
          href: surfaces.compoundHref,
          label: "Compound",
          value: "compound",
        },
      ]}
      value={surfaces.active ?? "shorthand"}
    />
  ) : null}
  <PackageLinks
    class="ms-auto"
    framework={Astro.props.framework}
    packageName={Astro.props.packageName}
  />
</div>
