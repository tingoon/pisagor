---
import { highlightCode } from "#/lib/tanstack-highlight";

interface Props {
  code: string;
  lang?: string;
  title?: string;
  class?: string;
}

const copyId = `copy-${Math.random().toString(36).slice(2, 10)}`;

const code = Astro.props.code ?? "";
const requestedLang = Astro.props.lang ?? "bash";
/**
 * Docs Vue snippets come in three shapes:
 * 1) Full SFC (`<script>` / `<template>` / `<style>`) → `vue`
 * 2) Stripped template body (see stripVueExample) → `vue` (was Shiki vue-html)
 * 3) Import / script-only lines (no markup) → `ts`
 */
const hasVueSfcBlock = /<(?:script|template|style)\b/i.test(code);
const hasMarkup = /<[A-Za-z]/.test(code);

let lang = requestedLang;
let badgeLang = requestedLang;

if (requestedLang === "vue" || requestedLang === "vue-html") {
  if (requestedLang === "vue-html" || (!hasVueSfcBlock && hasMarkup)) {
    lang = "vue";
    badgeLang = "vue";
  } else if (hasVueSfcBlock) {
    lang = "vue";
    badgeLang = "vue";
  } else {
    lang = "ts";
    badgeLang = "ts";
  }
}

const highlightedHtml = highlightCode(code, lang);
---

<div
  data-codeblock
  data-highlighter="tanstack"
  class:list={[
  "relative overflow-hidden border border-border/70 bg-muted/40",
  Astro.props.class ?? "rounded-xl",
]}
>
  <div
    class="flex items-center justify-between gap-3 border-b border-border/60 bg-muted/50 px-3 py-1.5"
  >
    <div class="flex min-w-0 items-center gap-2">
      {Astro.props.title ? (
  <span class="truncate font-semibold text-foreground/80 text-xs">
    {Astro.props.title}
  </span>
) : null}
      <span
        class="rounded border border-border/70 px-1.5 py-px text-2.5 font-semibold uppercase tracking-wider text-muted-foreground leading-none"
      >
        {badgeLang}
      </span>
    </div>
    <button
      aria-label="Copy code"
      class="shrink-0 cursor-pointer rounded-md border border-border/70 bg-background/60 px-2 py-0.5 text-xs font-semibold text-muted-foreground transition-colors hover:border-border hover:bg-background hover:text-foreground data-copied:border-primary/45 data-copied:text-primary"
      data-copy-btn
      data-copy-for={copyId}
      type="button"
    >
      <span data-copy-idle>Copy</span>
      <span data-copy-done hidden>Copied</span>
    </button>
  </div>
  <div
    class="overflow-x-auto [&_pre]:m-0! [&_pre]:bg-transparent! [&_pre]:px-4! [&_pre]:py-3! [&_pre]:text-xs! [&_pre]:leading-relaxed! [&_code]:font-mono"
    data-copy-source={copyId}
    set:html={highlightedHtml}
  />
</div>

<script>
function bindCopyButtons() {
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy-btn]")
    .forEach((btn) => {
      if (btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", async () => {
        const id = btn.dataset.copyFor;
        const source = id
          ? document.querySelector<HTMLElement>(`[data-copy-source="${id}"]`)
          : null;
        const text = source?.innerText?.trim() ?? "";
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const ta = document.createElement("textarea");
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand("copy");
          ta.remove();
        }
        const idle = btn.querySelector<HTMLElement>("[data-copy-idle]");
        const done = btn.querySelector<HTMLElement>("[data-copy-done]");
        if (idle) idle.hidden = true;
        if (done) done.hidden = false;
        btn.dataset.copied = "";
        window.setTimeout(() => {
          if (idle) idle.hidden = false;
          if (done) done.hidden = true;
          delete btn.dataset.copied;
        }, 1600);
      });
    });
}

bindCopyButtons();
document.addEventListener("astro:page-load", bindCopyButtons);
</script>

<!-- set:html tokens need global selectors; scoped to [data-codeblock] / .th-* -->
<style is:global>
[data-codeblock][data-highlighter="tanstack"] {
  /* Theme-token palette — matches docs chrome instead of GitHub navy */
  --th-background: transparent;
  --th-token: var(--foreground);
  --th-attr: color-mix(in oklab, var(--primary) 72%, var(--foreground));
  --th-code-inline: color-mix(in oklab, var(--primary) 55%, #c4a574);
  --th-command: color-mix(in oklab, var(--primary) 40%, #a78bfa);
  --th-comment: var(--muted-foreground);
  --th-deleted: color-mix(in oklab, #ef4444 75%, var(--foreground));
  --th-function: color-mix(in oklab, var(--primary) 40%, #a78bfa);
  --th-heading: color-mix(in oklab, var(--primary) 72%, var(--foreground));
  --th-inserted: color-mix(in oklab, var(--primary) 65%, #4ade80);
  --th-keyword: color-mix(in oklab, var(--primary) 55%, #f472b6);
  --th-link: var(--primary);
  --th-literal: color-mix(in oklab, var(--primary) 80%, var(--foreground));
  --th-meta: var(--muted-foreground);
  --th-number: color-mix(in oklab, var(--primary) 70%, #fbbf24);
  --th-operator: color-mix(in oklab, var(--primary) 35%, var(--foreground));
  --th-property: color-mix(in oklab, var(--primary) 72%, var(--foreground));
  --th-selector: color-mix(in oklab, var(--primary) 70%, #4ade80);
  --th-string: color-mix(in oklab, var(--primary) 45%, #86efac);
  --th-tag: color-mix(in oklab, var(--primary) 78%, var(--foreground));
  --th-type: color-mix(in oklab, var(--primary) 50%, #fbbf24);
  --th-variable: color-mix(in oklab, var(--primary) 45%, #fbbf24);
}

[data-codeblock][data-highlighter="tanstack"] .th-code {
  overflow-x: auto;
  padding: 1rem;
  background: var(--th-background);
  color: var(--th-token);
}

.th-token {
  color: var(--th-token);
}
.th-attr {
  color: var(--th-attr);
}
.th-code-inline {
  color: var(--th-code-inline);
}
.th-command {
  color: var(--th-command);
}
.th-comment {
  color: var(--th-comment);
}
.th-deleted {
  color: var(--th-deleted);
}
.th-function {
  color: var(--th-function);
}
.th-heading {
  color: var(--th-heading);
}
.th-inserted {
  color: var(--th-inserted);
}
.th-keyword {
  color: var(--th-keyword);
}
.th-link {
  color: var(--th-link);
}
.th-literal {
  color: var(--th-literal);
}
.th-meta {
  color: var(--th-meta);
}
.th-number {
  color: var(--th-number);
}
.th-operator {
  color: var(--th-operator);
}
.th-property {
  color: var(--th-property);
}
.th-selector {
  color: var(--th-selector);
}
.th-string {
  color: var(--th-string);
}
.th-tag {
  color: var(--th-tag);
}
.th-type {
  color: var(--th-type);
}
.th-variable {
  color: var(--th-variable);
}
.th-line {
  display: inline-block;
  min-width: 100%;
  width: max-content;
}
.th-code--line-numbers code {
  counter-reset: th-line;
}
.th-code--line-numbers .th-line::before {
  display: inline-block;
  width: 2.5em;
  padding-right: 1em;
  color: var(--th-comment);
  content: attr(data-line);
  text-align: right;
  user-select: none;
}
</style>
