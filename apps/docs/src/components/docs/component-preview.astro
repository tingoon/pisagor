---
import {
  ArrowSquareOutIcon,
  BugIcon,
  CaretUpDownIcon,
  MoonIcon,
  SunIcon,
  TreeStructureIcon,
} from "@phosphor-icons/react";
import { Button, Separator, Surface, VisuallyHidden } from "@pisagor/astro";
import type { Framework } from "#/lib/nav";
import { isFramedPreview } from "#/lib/preview-config";
import CodeBlock from "./code-block.astro";

interface Props {
  title?: string;
  /**
   * Inline source (embeds in HTML). Prefer `framework` + `exampleId` +
   * `exportName` so Code tab loads on demand.
   */
  code?: string;
  language?: string;
  class?: string;
  /** Framework for deferred source `import()` */
  framework?: Framework;
  /** Component / form / block id for deferred source load */
  exampleId?: string;
  /** `sources` key for deferred source load */
  exportName?: string;
  /** Which examples tree to load (`component` default) */
  kind?: "component" | "form" | "block";
  /** npm / package id shown in the dependencies popover */
  packageName?: string;
  /** Extra dependency names for the popover */
  dependencies?: string[];
  /** Override “Report an issue” URL */
  reportUrl?: string;
  /** Standalone live-preview URL for “Open in new tab” */
  previewHref?: string;
  /**
   * Render the preview in a fixed-height scrollable frame (viewport-filling
   * app layouts). Defaults to `isFramedPreview(exampleId)`.
   */
  framed?: boolean;
}

const title = Astro.props.title;
const language = Astro.props.language ?? "tsx";
const packageName = Astro.props.packageName ?? "@pisagor/react";
const previewHref = Astro.props.previewHref;
const framework = Astro.props.framework;
const exampleId = Astro.props.exampleId;
const exportName = Astro.props.exportName;
const kind = Astro.props.kind ?? "component";
const deferSource = Boolean(framework && exampleId && exportName);
const framed = Astro.props.framed ?? isFramedPreview(exampleId);
const dependencies = Astro.props.dependencies ?? [
  "@pisagor/recipes",
  "@pisagor/tokens",
];
const reportUrl =
  Astro.props.reportUrl ??
  "https://github.com/tingoon/pisagor/issues/new?labels=docs&title=" +
    encodeURIComponent(title ? `Docs preview: ${title}` : "Docs preview issue");

/** Preview surfaces — `page` is the bare canvas, the rest are Surface variants. */
const surfaces = [
  { label: "Page", value: "page" },
  { label: "Default", value: "default" },
  { label: "Secondary", value: "secondary" },
  { label: "Tertiary", value: "tertiary" },
  { label: "Glass", value: "glass" },
] as const;

const viewports = [
  { label: "Desktop", value: "desktop" },
  { label: "Tablet", value: "tablet" },
  { label: "Mobile", value: "mobile" },
] as const;

/** Native select styled like Pisagor's `sm` form control (no Astro Select exists). */
const selectClass =
  "h-7 w-full min-w-0 cursor-pointer appearance-none rounded-lg border border-foreground/20 bg-card ps-2 pe-6 text-foreground text-xs shadow-sm outline-hidden transition-[color,box-shadow,background-color,border-color] duration-fast ease-out focus-visible:border-primary focus-visible:ring-0.75 focus-visible:ring-ring/24 motion-reduce:transition-none! dark:border-input dark:bg-input/30";
---

<section
  data-component-preview
  data-package={packageName}
  data-pagefind-ignore="all"
  data-preview-href={previewHref}
  class:list={[
    "my-7 overflow-hidden rounded-xl border border-border/70 bg-card shadow-sm",
    Astro.props.class,
  ]}
>
  <div
    class="flex flex-wrap items-center gap-1.5 border-b border-border/60 bg-muted/15 px-2 py-1.5 sm:gap-2 sm:px-2.5"
  >
    <div
      aria-label={title ? `${title} view` : "Component view"}
      class="inline-flex rounded-md bg-muted/60 p-0.5"
      role="tablist"
    >
      <Button
        aria-selected="true"
        class="docs-press text-muted-foreground data-active:bg-background data-active:text-foreground data-active:shadow-sm"
        data-active
        data-view="preview"
        data-view-tab
        role="tab"
        size="xs"
        type="button"
        variant="ghost"
      >
        Preview
      </Button>
      <Button
        aria-selected="false"
        class="docs-press text-muted-foreground data-active:bg-background data-active:text-foreground data-active:shadow-sm"
        data-view="code"
        data-view-tab
        role="tab"
        size="xs"
        type="button"
        variant="ghost"
      >
        Code
      </Button>
    </div>

    <div class="ms-auto flex flex-wrap items-center gap-1">
      <Button
        aria-label="Toggle light and dark mode"
        data-theme-toggle
        data-tooltip="Toggle mode"
        size="icon-sm"
        type="button"
        variant="ghost"
      >
        <SunIcon aria-hidden data-icon-sun size={14} />
        <MoonIcon aria-hidden data-icon-moon hidden size={14} />
      </Button>

      <Button
        aria-label="Open preview in a new tab"
        data-open-tab
        data-tooltip="Open in new tab"
        size="icon-sm"
        type="button"
        variant="ghost"
      >
        <ArrowSquareOutIcon aria-hidden size={14} />
      </Button>

      <div class="relative" data-deps>
        <Button
          aria-expanded="false"
          aria-haspopup="dialog"
          aria-label="Show dependencies"
          data-deps-toggle
          data-tooltip="Dependencies"
          size="icon-sm"
          type="button"
          variant="ghost"
        >
          <TreeStructureIcon aria-hidden size={14} />
        </Button>
        <div
          aria-label="Dependencies"
          class="absolute inset-e-0 z-20 mt-1 hidden min-w-56 rounded-lg border border-border/70 bg-popover p-2 text-popover-foreground shadow-lg"
          data-deps-panel
          role="dialog"
        >
          <p class="mb-1.5 px-1 docs-label">Dependencies</p>
          <ul class="space-y-0.5 font-mono text-xs">
            <li class="rounded-md px-1.5 py-1 text-foreground">
              {packageName}
            </li>
            {dependencies.map((dep) => (
              <li class="rounded-md px-1.5 py-1 text-muted-foreground">
                {dep}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <a
        aria-label="Report an issue"
        class="docs-press inline-flex size-8 items-center justify-center rounded-lg text-muted-foreground hover:bg-accent/60 hover:text-foreground"
        data-tooltip="Report an issue"
        href={reportUrl}
        rel="noreferrer"
        target="_blank"
      >
        <VisuallyHidden>Report an issue</VisuallyHidden>
        <BugIcon aria-hidden size={14} />
      </a>

      <Separator class="mx-0.5 hidden h-4 sm:block" orientation="vertical" />

      {[
        { key: "surface", label: "Surface", options: surfaces },
        { key: "viewport", label: "Viewport", options: viewports },
      ].map((control) => (
        <span class="relative inline-flex">
          <select
            aria-label={control.label}
            class={selectClass}
            data-preview-select={control.key}
          >
            {control.options.map((option, index) => (
              <option selected={index === 0} value={option.value}>
                {option.label}
              </option>
            ))}
          </select>
          <CaretUpDownIcon
            aria-hidden
            class="pointer-events-none absolute inset-e-1.5 top-1/2 -translate-y-1/2 text-muted-foreground"
            size={12}
          />
        </span>
      ))}
    </div>
  </div>

  <div
    data-panel="preview"
    data-preview-framed={framed ? "" : undefined}
    class:list={[
      "bg-background bg-[radial-gradient(ellipse_at_top,color-mix(in_oklab,var(--primary)_8%,transparent),transparent_60%)] text-foreground",
      framed
        ? "docs-preview-frame"
        : "flex min-h-48 items-center justify-center px-4 py-8 sm:px-6 sm:py-10",
    ]}
  >
    <div
      class="w-full max-w-full transition-[max-width] duration-200 ease-out data-[viewport=tablet]:max-w-3xl data-[viewport=mobile]:max-w-93.75"
      data-preview-stage
      data-viewport="desktop"
    >
      <div class="w-full" data-preview-surface="page">
        <slot />
      </div>
    </div>
    {surfaces.map((surface) =>
      surface.value === "page" ? null : (
        <template data-surface-template={surface.value}>
          <Surface
            bordered
            class="w-full"
            padding="lg"
            variant={surface.value}
          />
        </template>
      ),
    )}
  </div>

  <div class="hidden" data-panel="code">
    <CodeBlock
      class="rounded-none border-0 border-t border-border/60"
      code={deferSource ? undefined : Astro.props.code}
      lang={language}
      lazy
      sourceExport={deferSource ? exportName : undefined}
      sourceFramework={deferSource ? framework : undefined}
      sourceId={deferSource ? exampleId : undefined}
      sourceKind={deferSource ? kind : undefined}
    />
  </div>
</section>

<script>
import { bindComponentPreviews } from "#/lib/component-preview-client";

bindComponentPreviews();
document.addEventListener("astro:page-load", bindComponentPreviews);
</script>
