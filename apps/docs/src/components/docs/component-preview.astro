---
import {
  ArrowSquareOutIcon,
  BugIcon,
  CaretUpDownIcon,
  MoonIcon,
  SunIcon,
  TreeStructureIcon,
} from "@phosphor-icons/react";
import { Button, Separator, Surface, VisuallyHidden } from "@pisagor/astro";
import type { Framework } from "#/lib/nav";
import CodeBlock from "./code-block.astro";

interface Props {
  title?: string;
  /**
   * Inline source (embeds in HTML). Prefer `framework` + `exampleId` +
   * `exportName` so Code tab loads on demand.
   */
  code?: string;
  language?: string;
  class?: string;
  /** Framework for deferred source `import()` */
  framework?: Framework;
  /** Component / form / block id for deferred source load */
  exampleId?: string;
  /** `sources` key for deferred source load */
  exportName?: string;
  /** Which examples tree to load (`component` default) */
  kind?: "component" | "form" | "block";
  /** npm / package id shown in the dependencies popover */
  packageName?: string;
  /** Extra dependency names for the popover */
  dependencies?: string[];
  /** Override “Report an issue” URL */
  reportUrl?: string;
  /** Standalone live-preview URL for “Open in new tab” */
  previewHref?: string;
}

const title = Astro.props.title;
const language = Astro.props.language ?? "tsx";
const packageName = Astro.props.packageName ?? "@pisagor/react";
const previewHref = Astro.props.previewHref;
const framework = Astro.props.framework;
const exampleId = Astro.props.exampleId;
const exportName = Astro.props.exportName;
const kind = Astro.props.kind ?? "component";
const deferSource = Boolean(framework && exampleId && exportName);
const dependencies = Astro.props.dependencies ?? [
  "@pisagor/recipes",
  "@pisagor/tokens",
];
const reportUrl =
  Astro.props.reportUrl ??
  "https://github.com/tingoon/pisagor/issues/new?labels=docs&title=" +
    encodeURIComponent(title ? `Docs preview: ${title}` : "Docs preview issue");

/** Preview surfaces — `page` is the bare canvas, the rest are Surface variants. */
const surfaces = [
  { label: "Page", value: "page" },
  { label: "Default", value: "default" },
  { label: "Secondary", value: "secondary" },
  { label: "Tertiary", value: "tertiary" },
  { label: "Glass", value: "glass" },
] as const;

const viewports = [
  { label: "Desktop", value: "desktop" },
  { label: "Tablet", value: "tablet" },
  { label: "Mobile", value: "mobile" },
] as const;

/** Native select styled like Pisagor's `sm` form control (no Astro Select exists). */
const selectClass =
  "h-7 w-full min-w-0 cursor-pointer appearance-none rounded-lg border border-foreground/20 bg-card ps-2 pe-6 text-foreground text-xs shadow-sm outline-hidden transition-[color,box-shadow,background-color,border-color] duration-fast ease-out focus-visible:border-primary focus-visible:ring-0.75 focus-visible:ring-ring/24 motion-reduce:transition-none! dark:border-input dark:bg-input/30";
---

<section
  data-component-preview
  data-package={packageName}
  data-preview-href={previewHref}
  class:list={[
    "my-7 overflow-hidden rounded-xl border border-border/70 bg-card shadow-sm",
    Astro.props.class,
  ]}
>
  <div
    class="flex flex-wrap items-center gap-1.5 border-b border-border/60 bg-muted/15 px-2 py-1.5 sm:gap-2 sm:px-2.5"
  >
    <div
      aria-label={title ? `${title} view` : "Component view"}
      class="inline-flex rounded-md bg-muted/60 p-0.5"
      role="tablist"
    >
      <Button
        aria-selected="true"
        class="docs-press text-muted-foreground data-active:bg-background data-active:text-foreground data-active:shadow-sm"
        data-active
        data-view="preview"
        data-view-tab
        role="tab"
        size="xs"
        type="button"
        variant="ghost"
      >
        Preview
      </Button>
      <Button
        aria-selected="false"
        class="docs-press text-muted-foreground data-active:bg-background data-active:text-foreground data-active:shadow-sm"
        data-view="code"
        data-view-tab
        role="tab"
        size="xs"
        type="button"
        variant="ghost"
      >
        Code
      </Button>
    </div>

    <div class="ms-auto flex flex-wrap items-center gap-1">
      <Button
        aria-label="Toggle light and dark mode"
        data-theme-toggle
        data-tooltip="Toggle mode"
        size="icon-sm"
        type="button"
        variant="ghost"
      >
        <SunIcon aria-hidden data-icon-sun size={14} />
        <MoonIcon aria-hidden data-icon-moon hidden size={14} />
      </Button>

      <Button
        aria-label="Open preview in a new tab"
        data-open-tab
        data-tooltip="Open in new tab"
        size="icon-sm"
        type="button"
        variant="ghost"
      >
        <ArrowSquareOutIcon aria-hidden size={14} />
      </Button>

      <div class="relative" data-deps>
        <Button
          aria-expanded="false"
          aria-haspopup="dialog"
          aria-label="Show dependencies"
          data-deps-toggle
          data-tooltip="Dependencies"
          size="icon-sm"
          type="button"
          variant="ghost"
        >
          <TreeStructureIcon aria-hidden size={14} />
        </Button>
        <div
          aria-label="Dependencies"
          class="absolute inset-e-0 z-20 mt-1 hidden min-w-56 rounded-lg border border-border/70 bg-popover p-2 text-popover-foreground shadow-lg"
          data-deps-panel
          role="dialog"
        >
          <p class="mb-1.5 px-1 docs-label">Dependencies</p>
          <ul class="space-y-0.5 font-mono text-xs">
            <li class="rounded-md px-1.5 py-1 text-foreground">
              {packageName}
            </li>
            {dependencies.map((dep) => (
              <li class="rounded-md px-1.5 py-1 text-muted-foreground">
                {dep}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <a
        aria-label="Report an issue"
        class="docs-press inline-flex size-8 items-center justify-center rounded-lg text-muted-foreground hover:bg-accent/60 hover:text-foreground"
        data-tooltip="Report an issue"
        href={reportUrl}
        rel="noreferrer"
        target="_blank"
      >
        <VisuallyHidden>Report an issue</VisuallyHidden>
        <BugIcon aria-hidden size={14} />
      </a>

      <Separator class="mx-0.5 hidden h-4 sm:block" orientation="vertical" />

      {[
        { key: "surface", label: "Surface", options: surfaces },
        { key: "viewport", label: "Viewport", options: viewports },
      ].map((control) => (
        <span class="relative inline-flex">
          <select
            aria-label={control.label}
            class={selectClass}
            data-preview-select={control.key}
          >
            {control.options.map((option, index) => (
              <option selected={index === 0} value={option.value}>
                {option.label}
              </option>
            ))}
          </select>
          <CaretUpDownIcon
            aria-hidden
            class="pointer-events-none absolute inset-e-1.5 top-1/2 -translate-y-1/2 text-muted-foreground"
            size={12}
          />
        </span>
      ))}
    </div>
  </div>

  <div
    class="flex min-h-48 items-center justify-center bg-background bg-[radial-gradient(ellipse_at_top,color-mix(in_oklab,var(--primary)_8%,transparent),transparent_60%)] px-4 py-8 text-foreground sm:px-6 sm:py-10"
    data-panel="preview"
  >
    <div
      class="w-full max-w-full transition-[max-width] duration-200 ease-out data-[viewport=tablet]:max-w-3xl data-[viewport=mobile]:max-w-93.75"
      data-preview-stage
      data-viewport="desktop"
    >
      <div class="w-full" data-preview-surface="page">
        <slot />
      </div>
    </div>
    {surfaces.map((surface) =>
      surface.value === "page" ? null : (
        <template data-surface-template={surface.value}>
          <Surface
            bordered
            class="w-full"
            padding="lg"
            variant={surface.value}
          />
        </template>
      ),
    )}
  </div>

  <div class="hidden" data-panel="code">
    <CodeBlock
      class="rounded-none border-0 border-t border-border/60"
      code={deferSource ? undefined : Astro.props.code}
      lang={language}
      lazy
      sourceExport={deferSource ? exportName : undefined}
      sourceFramework={deferSource ? framework : undefined}
      sourceId={deferSource ? exampleId : undefined}
      sourceKind={deferSource ? kind : undefined}
    />
  </div>
</section>

<script>
import { ensureLazyCodeBlock } from "#/lib/ensure-lazy-codeblock";

const SURFACE_STORAGE_KEY = "pisagor.docs.preview-surface";
const SURFACE_EVENT = "pisagor:preview-surface";

function readStoredSurface(): string {
  try {
    return localStorage.getItem(SURFACE_STORAGE_KEY) ?? "page";
  } catch {
    return "page";
  }
}

function bindSurface(root: HTMLElement) {
  const wrapper = root.querySelector<HTMLElement>("[data-preview-surface]");
  const select = root.querySelector<HTMLSelectElement>(
    '[data-preview-select="surface"]',
  );
  if (!wrapper || !select) return;

  // Class strings come from the real `<Surface>` render, so they track the recipe.
  const classes = new Map<string, string>([["page", "w-full"]]);
  for (const tpl of root.querySelectorAll<HTMLTemplateElement>(
    "template[data-surface-template]",
  )) {
    const el = tpl.content.firstElementChild;
    if (el && tpl.dataset.surfaceTemplate) {
      classes.set(tpl.dataset.surfaceTemplate, el.className);
    }
  }

  function apply(value: string) {
    const next = classes.has(value) ? value : "page";
    if (!wrapper) return;
    wrapper.className = classes.get(next) ?? "w-full";
    wrapper.dataset.previewSurface = next;
    if (select) select.value = next;
  }

  function choose(value: string) {
    try {
      localStorage.setItem(SURFACE_STORAGE_KEY, value);
    } catch {
      /* ignore */
    }
    // Keep every preview on the page in sync.
    document.dispatchEvent(new CustomEvent(SURFACE_EVENT, { detail: value }));
  }

  select.addEventListener("change", () => choose(select.value));

  document.addEventListener(SURFACE_EVENT, (event) => {
    if (!root.isConnected) return;
    apply(String((event as CustomEvent<string>).detail));
  });

  apply(readStoredSurface());
}

function bindPreview(root: HTMLElement) {
  if (root.dataset.bound === "1") return;
  root.dataset.bound = "1";
  bindSurface(root);

  const tabs = [...root.querySelectorAll<HTMLElement>("[data-view-tab]")];
  const previewPanel = root.querySelector<HTMLElement>(
    '[data-panel="preview"]',
  );
  const codePanel = root.querySelector<HTMLElement>('[data-panel="code"]');
  const stage = root.querySelector<HTMLElement>("[data-preview-stage]");
  const themeBtn = root.querySelector<HTMLElement>("[data-theme-toggle]");
  const openTabBtn = root.querySelector<HTMLElement>("[data-open-tab]");
  const depsRoot = root.querySelector<HTMLElement>("[data-deps]");
  const depsToggle = root.querySelector<HTMLElement>("[data-deps-toggle]");
  const depsPanel = root.querySelector<HTMLElement>("[data-deps-panel]");
  const sun = themeBtn?.querySelector<HTMLElement>("[data-icon-sun]");
  const moon = themeBtn?.querySelector<HTMLElement>("[data-icon-moon]");

  function setView(view: "preview" | "code") {
    for (const tab of tabs) {
      const active = tab.dataset.view === view;
      tab.toggleAttribute("data-active", active);
      tab.setAttribute("aria-selected", active ? "true" : "false");
    }
    previewPanel?.classList.toggle("hidden", view !== "preview");
    codePanel?.classList.toggle("hidden", view !== "code");
    if (view === "code" && codePanel) {
      void ensureLazyCodeBlock(codePanel);
    }
  }

  for (const tab of tabs) {
    tab.addEventListener("click", () => {
      setView(tab.dataset.view === "code" ? "code" : "preview");
    });
  }

  const previewThemeRoot = root.querySelector<HTMLElement>(
    '[data-panel="preview"]',
  );

  function getDocsTheme(): "light" | "dark" {
    return document.documentElement.classList.contains("dark")
      ? "dark"
      : "light";
  }

  function getPreviewTheme(): "light" | "dark" {
    const stored = previewThemeRoot?.dataset.previewTheme;
    if (stored === "dark" || stored === "light") return stored;
    return getDocsTheme();
  }

  function setPreviewTheme(next: "light" | "dark") {
    if (!previewThemeRoot) return;
    // In-memory only for this preview — never localStorage / cookies.
    previewThemeRoot.dataset.previewTheme = next;
    previewThemeRoot.classList.toggle("dark", next === "dark");
    previewThemeRoot.classList.toggle("light", next === "light");
    syncThemeIcons();
  }

  function syncThemeIcons() {
    const dark = getPreviewTheme() === "dark";
    if (sun) sun.hidden = !dark; // show sun when dark (click to go light)
    if (moon) moon.hidden = dark; // show moon when light (click to go dark)
    themeBtn?.setAttribute(
      "aria-label",
      dark ? "Switch preview to light mode" : "Switch preview to dark mode",
    );
  }

  // Default: same as docs page theme (no persisted preview preference).
  setPreviewTheme(getDocsTheme());

  themeBtn?.addEventListener("click", () => {
    setPreviewTheme(getPreviewTheme() === "dark" ? "light" : "dark");
  });

  openTabBtn?.addEventListener("click", () => {
    const href = root.dataset.previewHref;
    const previewTheme = getPreviewTheme();

    // Prefer the hydrated standalone preview page when available.
    if (href) {
      const url = new URL(href, window.location.href);
      url.searchParams.set("theme", previewTheme);
      window.open(url.href, "_blank", "noopener,noreferrer");
      return;
    }

    // Fallback when no standalone preview route is set (static snapshot).
    if (!stage) return;
    const styles = [
      ...document.querySelectorAll('link[rel="stylesheet"], style'),
    ]
      .map((node) => node.outerHTML)
      .join("\n");
    const title = root.dataset.package || "Preview";
    const previewDark = previewTheme === "dark";
    const html = `<!doctype html>
<html lang="en" class="${previewDark ? "dark" : ""}">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>${title}</title>
  ${styles}
</head>
<body class="min-h-dvh bg-background p-0 text-foreground">
<div class="mx-auto w-full">${stage.innerHTML}</div>
</body>
</html>`;
    // `noopener` in windowFeatures returns null — open first, then disown.
    const win = window.open("about:blank", "_blank");
    if (!win) return;
    win.opener = null;
    win.document.open();
    win.document.write(html);
    win.document.close();
  });

  function closeDeps() {
    depsPanel?.classList.add("hidden");
    depsToggle?.setAttribute("aria-expanded", "false");
  }

  depsToggle?.addEventListener("click", (event) => {
    event.stopPropagation();
    const willOpen = depsPanel?.classList.contains("hidden");
    depsPanel?.classList.toggle("hidden", !willOpen);
    depsToggle.setAttribute("aria-expanded", willOpen ? "true" : "false");
  });

  document.addEventListener("click", (event) => {
    if (!depsRoot) return;
    if (!depsRoot.contains(event.target as Node)) closeDeps();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeDeps();
  });

  const viewportSelect = root.querySelector<HTMLSelectElement>(
    '[data-preview-select="viewport"]',
  );
  viewportSelect?.addEventListener("change", () => {
    const size = viewportSelect.value;
    if (stage && (size === "tablet" || size === "mobile" || size === "desktop"))
      stage.dataset.viewport = size;
  });
}

function bindAll() {
  document
    .querySelectorAll<HTMLElement>("[data-component-preview]")
    .forEach(bindPreview);
}

bindAll();
document.addEventListener("astro:page-load", bindAll);
</script>
