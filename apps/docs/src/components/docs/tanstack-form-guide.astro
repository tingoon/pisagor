---
import Example from "#/components/docs/example.astro";
import Installation from "#/components/docs/installation.astro";
import CodeBlock from "#/components/docs/code-block.astro";
import { setDocsExampleContext } from "#/lib/docs-example-context";
import { docsInlineCodeClass } from "#/lib/docs-prose";
import type { Framework } from "#/lib/nav";

interface Props {
  framework: Exclude<Framework, "astro">;
}

const { framework } = Astro.props;

setDocsExampleContext(Astro.locals, {
  exampleId: "tanstack",
  framework,
  kind: "form",
});

const pkg = {
  react: {
    form: "@pisagor/react-form",
    peer: "@tanstack/react-form",
    tanstack: "@pisagor/react-form/tanstack",
    ui: "@pisagor/react",
  },
  solid: {
    form: "@pisagor/solid-form",
    peer: "@tanstack/solid-form",
    tanstack: "@pisagor/solid-form/tanstack",
    ui: "@pisagor/solid",
  },
  svelte: {
    form: "@pisagor/svelte-form",
    peer: "@tanstack/svelte-form",
    tanstack: "@pisagor/svelte-form/tanstack",
    ui: "@pisagor/svelte",
  },
  vue: {
    form: "@pisagor/vue-form",
    peer: "@tanstack/vue-form",
    tanstack: "@pisagor/vue-form/tanstack",
    ui: "@pisagor/vue",
  },
}[framework];

const importSnippet = {
  react: `import { useAppForm } from "${pkg.tanstack}";`,
  solid: `import { useAppForm } from "${pkg.tanstack}";`,
  svelte: `import { createAppForm, Root } from "${pkg.tanstack}";`,
  vue: `import { useAppForm } from "${pkg.tanstack}";`,
}[framework];

const quickStart = {
  react: `import { useAppForm } from "${pkg.tanstack}";

export function ProfileForm() {
  const form = useAppForm({
    defaultValues: {
      email: "",
      password: "",
    },
    onSubmit: ({ value }) => {
      console.log(value);
    },
  });

  return (
    <form.Root className="flex flex-col gap-4">
      <form.AppField name="email">
        {(field) => (
          <field.TextField
            autoComplete="email"
            id="email"
            label="Email"
            type="email"
          />
        )}
      </form.AppField>

      <form.AppField name="password">
        {(field) => (
          <field.PasswordField
            autoComplete="current-password"
            id="password"
            label="Password"
          />
        )}
      </form.AppField>

      <form.SubmitButton>Save</form.SubmitButton>
    </form.Root>
  );
}`,
  solid: `import { useAppForm } from "${pkg.tanstack}";

export function ProfileForm() {
  const form = useAppForm(() => ({
    defaultValues: {
      email: "",
      password: "",
    },
    onSubmit: ({ value }) => {
      console.log(value);
    },
  }));

  return (
    <form.Root class="flex flex-col gap-4">
      <form.AppField name="email">
        {(field) => (
          <field.TextField
            autocomplete="email"
            id="email"
            label="Email"
            type="email"
          />
        )}
      </form.AppField>

      <form.AppField name="password">
        {(field) => (
          <field.PasswordField
            autocomplete="current-password"
            id="password"
            label="Password"
          />
        )}
      </form.AppField>

      <form.SubmitButton>Save</form.SubmitButton>
    </form.Root>
  );
}`,
  svelte: `<script lang="ts">
  import { createAppForm, Root } from "${pkg.tanstack}";

  const form = createAppForm(() => ({
    defaultValues: {
      email: "",
      password: "",
    },
    onSubmit: ({ value }) => {
      console.log(value);
    },
  }));
</script>

<Root class="flex flex-col gap-4" {form}>
  <form.AppField name="email">
    {#snippet children(field)}
      <field.TextField
        autocomplete="email"
        id="email"
        label="Email"
        type="email"
      />
    {/snippet}
  </form.AppField>

  <form.AppField name="password">
    {#snippet children(field)}
      <field.PasswordField
        autocomplete="current-password"
        id="password"
        label="Password"
      />
    {/snippet}
  </form.AppField>

  <form.SubmitButton>Save</form.SubmitButton>
</Root>`,
  vue: `<script setup lang="ts">
import { useAppForm } from "${pkg.tanstack}";

const form = useAppForm({
  defaultValues: {
    email: "",
    password: "",
  },
  onSubmit: ({ value }) => {
    console.log(value);
  },
});
</script>

<template>
  <component :is="form.Root" class="flex flex-col gap-4">
    <component :is="form.AppField" name="email" v-slot="field">
      <component
        :is="field.TextField"
        auto-complete="email"
        id="email"
        label="Email"
        type="email"
      />
    </component>

    <component :is="form.AppField" name="password" v-slot="field">
      <component
        :is="field.PasswordField"
        auto-complete="current-password"
        id="password"
        label="Password"
      />
    </component>

    <component :is="form.SubmitButton">Save</component>
  </component>
</template>`,
}[framework];

const quickStartLang = {
  react: "tsx",
  solid: "tsx",
  svelte: "svelte",
  vue: "vue",
}[framework];

const hookName = framework === "svelte" ? "createAppForm" : "useAppForm";
---

<section class="mb-10">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">
    Overview
  </h2>
  <p class="mb-4 text-muted-foreground">
    The
    <code class={docsInlineCodeClass}>{pkg.tanstack}</code>
    entry wires Pisagor field components to
    <a
      class="text-foreground underline underline-offset-2"
      href="https://tanstack.com/form"
      rel="noreferrer"
      target="_blank"
      >TanStack Form</a
    >. You get typed
    <code class={docsInlineCodeClass}>{hookName}</code>, connected field
    components on
    <code class={docsInlineCodeClass}>AppField</code>, a
    <code class={docsInlineCodeClass}>Root</code>
    form element that handles submit, and a
    <code class={docsInlineCodeClass}>SubmitButton</code>
    that tracks form state.
  </p>
  <p class="text-muted-foreground">
    Standalone fields from
    <code class={docsInlineCodeClass}>{pkg.form}</code>
    stay available without TanStack. Use the adapter when you want shared
    validation, submission, and field state from TanStack Form.
  </p>
</section>

<section class="mb-10">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="install">
    Install
  </h2>
  <p class="mb-4 text-muted-foreground">
    Add the form package and the TanStack Form peer for {framework}. Fields
    depend on
    <code class={docsInlineCodeClass}>{pkg.ui}</code>
    as well.
  </p>
  <Installation class="mb-2" packages={[pkg.form, pkg.peer]} />
</section>

<section class="mb-10">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="import">Import</h2>
  <CodeBlock code={importSnippet} lang="ts" />
</section>

<section class="mb-10">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="quick-start">
    Quick start
  </h2>
  <p class="mb-4 text-muted-foreground">
    Create a form with default values, render fields through
    <code class={docsInlineCodeClass}>AppField</code>, and wrap everything in
    <code class={docsInlineCodeClass}>Root</code>.
  </p>
  <CodeBlock code={quickStart} lang={quickStartLang} />
</section>

<section class="mb-10">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="how-it-works">
    How it works
  </h2>
  <ul class="mb-4 list-disc space-y-2 ps-5 text-muted-foreground">
    <li>
      <code class={docsInlineCodeClass}>{hookName}</code>
      returns a typed TanStack form with every Pisagor field registered for
      <code class={docsInlineCodeClass}>AppField</code>.
    </li>
    <li>
      Inside
      <code class={docsInlineCodeClass}>AppField</code>, call
      <code class={docsInlineCodeClass}>field.TextField</code>
      (or another field). Value, blur, name, and invalid/error state bind
      automatically.
    </li>
    <li>
      <code class={docsInlineCodeClass}>form.Root</code>
      renders a native
      <code class={docsInlineCodeClass}>&lt;form&gt;</code>, prevents the
      default submit, and calls
      <code class={docsInlineCodeClass}>handleSubmit</code>.
    </li>
    <li>
      <code class={docsInlineCodeClass}>SubmitButton</code>
      shows a loading state while
      <code class={docsInlineCodeClass}>isSubmitting</code>
      is true.
    </li>
  </ul>
  <p class="text-muted-foreground">
    Pass field-level or form-level validators through the usual TanStack Form
    options (
    <code class={docsInlineCodeClass}>validators</code>
    on
    <code class={docsInlineCodeClass}>AppField</code>
    or on
    <code class={docsInlineCodeClass}>{hookName}</code>). Errors surface on the
    field after touch or a submit attempt.
  </p>
</section>

<section class="mb-10">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="fields">
    Connected fields
  </h2>
  <p class="mb-4 text-muted-foreground">
    These components are available on the
    <code class={docsInlineCodeClass}>field</code>
    render argument:
  </p>
  <ul
    class="mb-4 grid list-disc gap-1 ps-5 text-muted-foreground sm:grid-cols-2"
  >
    <li>AutocompleteField</li>
    <li>CheckboxField</li>
    <li>DateField</li>
    <li>FileField</li>
    <li>NumberField</li>
    <li>OtpField</li>
    <li>PasswordField</li>
    <li>PhoneField</li>
    <li>RadioGroupField</li>
    <li>RichTextEditorField</li>
    <li>SelectField</li>
    <li>SliderField</li>
    <li>SwitchField</li>
    <li>TagsInputField</li>
    <li>TextareaField</li>
    <li>TextField</li>
  </ul>
  <p class="text-muted-foreground">
    Label, description, and control props match the standalone field APIs.
    Prefer the field docs under Forms for when to use each control; use
    <code class={docsInlineCodeClass}>{pkg.ui}</code>
    docs for the underlying Input, Label, and related primitives.
  </p>
</section>

<section class="mb-10">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="example">
    Example
  </h2>
  <p class="mb-4 text-muted-foreground">
    A kitchen-sink form that exercises every connected field.
  </p>
  <Example name="Default" title="TanStack Form" />
  <div
    data-component-id="tanstack"
    data-docs-examples-host
    data-export-names={JSON.stringify(["Default"])}
    data-kind="form"
    hidden
  ></div>
</section>
