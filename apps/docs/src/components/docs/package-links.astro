---
import { ArrowSquareOutIcon, GithubLogoIcon } from "@phosphor-icons/react";
import type { Framework } from "#/lib/nav";
import { resolvePackageLinks } from "#/lib/packages";
import { NpmBrandIcon, StorybookBrandIcon } from "./brand-icons";

interface Props {
  framework: Framework;
  /** Override npm package (e.g. @pisagor/react-form) instead of framework default. */
  packageName?: string;
  class?: string;
}

const pkg = resolvePackageLinks(Astro.props.framework, Astro.props.packageName);
const links = [
  { href: pkg.github, icon: "github" as const, label: "GitHub" },
  ...(pkg.storybook
    ? [{ href: pkg.storybook, icon: "storybook" as const, label: "Storybook" }]
    : []),
  { href: pkg.npm, icon: "npm" as const, label: "npm" },
];
---

<nav
  aria-label="Package links"
  class:list={[
    "inline-flex w-fit shrink-0 overflow-hidden rounded-md border border-border/60 bg-background/40",
    Astro.props.class,
  ]}
>
  {links.map((link, index) => (
    <a
      class:list={[
        "docs-press inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-muted-foreground hover:bg-muted/60 hover:text-foreground",
        index > 0 && "border-s border-border/60",
      ]}
      href={link.href}
      rel="noreferrer"
      target="_blank"
    >
      {link.icon === "github" ? (
        <GithubLogoIcon aria-hidden size={13} weight="fill" />
      ) : link.icon === "storybook" ? (
        <StorybookBrandIcon size={13} />
      ) : (
        <NpmBrandIcon size={13} />
      )}
      {link.label}
      <ArrowSquareOutIcon
        aria-hidden
        className="opacity-40"
        size={11}
        weight="bold"
      />
    </a>
  ))}
</nav>
