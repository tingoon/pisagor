---
import type { PropRow } from "../../lib/props/types";

interface Props {
  rows: PropRow[];
}
---

<div class="overflow-x-auto rounded-xl border border-border/70 bg-card/80 backdrop-blur">
  <table class="w-full border-collapse text-sm">
    <thead>
      <tr class="border-b border-border/60 text-left text-muted-foreground">
        <th class="px-4 py-3 font-semibold">Prop</th>
        <th class="px-4 py-3 font-semibold">Type</th>
        <th class="px-4 py-3 font-semibold">Default</th>
        <th class="px-4 py-3 font-semibold">Description</th>
      </tr>
    </thead>
    <tbody>
      {Astro.props.rows.map((row) => (
  <tr class="border-b border-border/40 last:border-0">
    <td class="px-4 py-3 align-top">
      <code class="rounded bg-muted/80 px-1.5 py-0.5 font-mono text-3.25">{row.name}</code>
    </td>
    <td class="px-4 py-3 align-top">
      <code class="inline-block max-w-88 break-words font-mono text-3.25 text-primary/90">
        {row.type}
      </code>
    </td>
    <td class="px-4 py-3 align-top">
      {row.defaultValue ? (
        <code class="rounded bg-muted/80 px-1.5 py-0.5 font-mono text-3.25">
          {row.defaultValue}
        </code>
      ) : (
        <span class="text-muted-foreground">—</span>
      )}
    </td>
    <td class="px-4 py-3 align-top text-muted-foreground">{row.description}</td>
  </tr>
))}
    </tbody>
  </table>
</div>
