---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
}

const items = (Astro.props.headings ?? []).filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

{
  items.length > 0 ? (
    <aside class="sticky top-14 hidden h-[calc(100dvh-3.5rem)] w-52 shrink-0 overflow-y-auto p-4 [scrollbar-color:color-mix(in_oklab,var(--border)_80%,transparent)_transparent] [scrollbar-width:thin] xl:block">
      <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground/80">
        On this page
      </p>
      <nav class="space-y-2.5 border-s border-border/60">
        {items.map((item) => (
          <a
            class:list={[
              "block text-sm text-muted-foreground transition hover:text-foreground",
              item.depth === 2 ? "ps-3" : "ps-5",
            ]}
            href={`#${item.slug}`}
          >
            {item.text}
          </a>
        ))}
      </nav>
    </aside>
  ) : (
    <div class="hidden w-52 shrink-0 xl:block" />
  )
}
