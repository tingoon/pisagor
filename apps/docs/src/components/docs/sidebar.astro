---
import type { DocsArea, Framework } from "../../lib/nav";
import { frameworkPath, getSidebarNav } from "../../lib/nav";

interface Props {
  framework: Framework;
  currentPath: string;
  area: DocsArea;
}

const docsNav = getSidebarNav(Astro.props.framework, Astro.props.area);

---

<aside
  class="sticky top-14 hidden h-[calc(100dvh-3.5rem)] w-64 shrink-0 overflow-y-auto border-e border-border/50 p-4 [scrollbar-color:color-mix(in_oklab,var(--border)_80%,transparent)_transparent] [scrollbar-width:thin] lg:block"
>
  <nav class="flex flex-col gap-7 pt-2">
    {
      docsNav.map((section) => (
        <div>
          <p class="mb-2 px-2.5 text-2.75 font-semibold uppercase tracking-[0.08em] text-muted-foreground/80">
            {section.title}
          </p>
          <ul class="space-y-0.5">
            {section.items.map((item) => {
              const href = frameworkPath(Astro.props.framework, item.slug);
              const active =
                Astro.props.currentPath === href || Astro.props.currentPath === `${href}/`;
              const soon = item.status === "soon";
              return (
                <li>
                  {soon ? (
                    <span class="flex items-center justify-between rounded-lg px-2.5 py-1.5 text-sm text-muted-foreground/50">
                      {item.title}
                      <span class="rounded-md border border-border/50 px-1.5 py-0.5 text-2.5 font-semibold uppercase tracking-wide text-muted-foreground/70">
                        Soon
                      </span>
                    </span>
                  ) : (
                    <a
                      aria-current={active ? "page" : undefined}
                      class:list={[
                        "flex items-center rounded-lg px-2.5 py-1.5 text-sm transition",
                        active
                          ? "bg-accent/70 font-medium text-accent-foreground"
                          : "text-muted-foreground hover:bg-accent/40 hover:text-foreground",
                      ]}
                      href={href}
                    >
                      {item.title}
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </nav>
</aside>
