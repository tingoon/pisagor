---
import type { DocsArea, Framework } from "#/lib/nav";
import { getSidebarNav } from "#/lib/nav";
import SidebarNav from "./sidebar-nav";

interface Props {
  framework: Framework;
  currentPath: string;
  area: DocsArea;
}

const sections = getSidebarNav(Astro.props.framework, Astro.props.area);
---

<aside
  class="sticky top-12 hidden h-[calc(100dvh-3rem)] w-56 shrink-0 py-5 pe-3 lg:block"
>
  <SidebarNav
    currentPath={Astro.props.currentPath}
    framework={Astro.props.framework}
    sections={sections}
    client:load
  />
</aside>
