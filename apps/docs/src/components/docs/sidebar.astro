---
import type { DocsArea, Framework } from "../../lib/nav";
import { frameworkPath, getSidebarNav } from "../../lib/nav";

interface Props {
  framework: Framework;
  currentPath: string;
  area: DocsArea;
}

const docsNav = getSidebarNav(Astro.props.framework, Astro.props.area);

---

<aside
  class="docs-scroll-edge-e sticky top-14 hidden h-[calc(100dvh-3.5rem)] w-64 shrink-0 overflow-y-auto px-3 py-5 [scrollbar-color:color-mix(in_oklab,var(--border)_80%,transparent)_transparent] [scrollbar-width:thin] lg:block"
>
  <nav class="flex flex-col gap-6">
    {
      docsNav.map((section) => (
        <div>
          <p class="docs-label mb-3 px-2.5">{section.title}</p>
          <ul class="space-y-px">
            {section.items.map((item) => {
              const href = frameworkPath(Astro.props.framework, item.slug);
              const active =
                Astro.props.currentPath === href || Astro.props.currentPath === `${href}/`;
              const soon = item.status === "soon";
              return (
                <li>
                  {soon ? (
                    <span class="docs-nav-link flex items-center justify-between rounded-md px-2.5 py-1.5 text-foreground/40">
                      {item.title}
                      <span class="rounded border border-border/50 px-1.5 py-px text-[0.625rem] font-semibold uppercase tracking-[0.06em] text-muted-foreground/70">
                        Soon
                      </span>
                    </span>
                  ) : (
                    <a
                      aria-current={active ? "page" : undefined}
                      class:list={[
                        "docs-press docs-nav-link flex items-center rounded-md px-2.5 py-1.5",
                        active
                          ? "bg-accent/80 font-medium text-accent-foreground"
                          : "text-foreground/65 hover:bg-accent/40 hover:text-foreground",
                      ]}
                      href={href}
                    >
                      {item.title}
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </nav>
</aside>
