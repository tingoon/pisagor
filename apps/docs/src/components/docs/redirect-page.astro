---
/**
 * Static redirect with a full `<html>` document. `Astro.redirect` emits a
 * bare snippet in static builds, which Pagefind reports as "has no <html>
 * element"; this page has no `data-pagefind-body`, so Pagefind skips it.
 */
interface Props {
  /** Target path (already prefixed with the docs base). */
  to: string;
}

const { to } = Astro.props;
const canonical = Astro.site ? new URL(to, Astro.site).href : to;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Redirecting to: {to}</title>
    <meta content={`0;url=${to}`} http-equiv="refresh">
    <meta content="noindex" name="robots">
    <link href={canonical} rel="canonical">
  </head>
  <body>
    <a href={to}>Redirecting to <code>{to}</code></a>
  </body>
</html>
