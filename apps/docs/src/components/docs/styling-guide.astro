---
import type { Framework } from "../../lib/nav";
import { frameworkPath } from "../../lib/nav";
import CodeBlock from "./code-block.astro";

interface Props {
  framework: Framework;
}

const { framework } = Astro.props;

const brand = {
  astro: { css: "astro", dark: "#ff8a4c", label: "Astro", swatch: "#ff5d01" },
  react: { css: "react", dark: "#58c4dc", label: "React", swatch: "#087ea4" },
  solid: { css: "solid", dark: "#8ba4ff", label: "Solid", swatch: "#2c4f7c" },
  svelte: { css: "svelte", dark: "#ff7b5c", label: "Svelte", swatch: "#ff3e00" },
  vue: { css: "vue", dark: "#42d392", label: "Vue", swatch: "#42b883" },
}[framework];

const overrideSnippet = `:root {
  --primary: oklch(0.55 0.18 250);
  --primary-foreground: oklch(0.99 0 0);
  --ring: var(--primary);
}

.dark {
  --primary: oklch(0.72 0.14 250);
  --primary-foreground: oklch(0.2 0.04 250);
  --ring: var(--primary);
}`;

const frameworkSnippet = `/* Example: brand the docs shell for ${brand.label} */
html[data-framework="${brand.css}"] {
  --primary: ${brand.swatch};
  --primary-foreground: #ffffff;
  --ring: ${brand.swatch};
}

html.dark[data-framework="${brand.css}"] {
  --primary: ${brand.dark};
  --primary-foreground: #0b1220;
  --ring: ${brand.dark};
}`;

const themeMapSnippet = `@theme inline {
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-ring: var(--ring);
}`;
---

<section class="mb-10">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">Overview</h2>
  <p class="mb-4 text-muted-foreground">
    Pisagor themes through CSS variables (the same convention as shadcn-style token maps).
    Components read <code class="text-foreground">--primary</code>,
    <code class="text-foreground">--primary-foreground</code>, and related tokens — they do not
    hard-code brand colors. Override those variables in your app CSS to recolor the whole library.
  </p>
  <div
    class="mb-2 flex flex-wrap items-center gap-3 rounded-xl border border-border/70 bg-card p-4"
  >
    <span
      class="inline-flex size-10 rounded-full border border-border shadow-sm"
      style={`background: ${brand.swatch}`}
      title={`${brand.label} light primary`}
    ></span>
    <span
      class="inline-flex size-10 rounded-full border border-border shadow-sm"
      style={`background: ${brand.dark}`}
      title={`${brand.label} dark primary`}
    ></span>
    <div class="min-w-0">
      <p class="font-medium text-foreground">{brand.label} docs primary</p>
      <p class="text-muted-foreground text-sm">
        This docs tree sets <code class="text-foreground">data-framework="{brand.css}"</code> on
        <code class="text-foreground">&lt;html&gt;</code>
        and overrides Pisagor&apos;s default neutral primary with the framework brand.
      </p>
    </div>
  </div>
  <div class="mt-4 flex flex-wrap gap-2">
    <button
      class="inline-flex h-9 items-center rounded-lg bg-primary px-4 font-medium text-primary-foreground text-sm"
      type="button"
    >
      Primary button
    </button>
    <button
      class="inline-flex h-9 items-center rounded-lg border border-border bg-background px-4 font-medium text-foreground text-sm ring-2 ring-ring/40"
      type="button"
    >
      Ring sample
    </button>
    <span
      class="inline-flex h-9 items-center rounded-lg bg-primary/15 px-3 font-medium text-primary text-sm"
    >
      Primary / 15
    </span>
  </div>
</section>

<section class="mb-10">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="token-map">Token map</h2>
  <p class="mb-4 text-muted-foreground">
    Wire semantic tokens into Tailwind via <code class="text-foreground">@theme inline</code> so
    utilities like <code class="text-foreground">bg-primary</code> resolve to your CSS variables.
    Pisagor packages already publish this map — copy the pattern if you maintain a custom
    <code class="text-foreground">globals.css</code>.
  </p>
  <CodeBlock class="mb-2" code={themeMapSnippet} lang="css" title="globals.css" />
</section>

<section class="mb-10">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="customizing-colors">
    Customizing colors
  </h2>
  <p class="mb-4 text-muted-foreground">
    Override variables on <code class="text-foreground">:root</code> and
    <code class="text-foreground">.dark</code>. Always update the matching
    <code class="text-foreground">*-foreground</code>
    token when you change a fill so text and icons stay readable.
  </p>
  <CodeBlock class="mb-2" code={overrideSnippet} lang="css" title="globals.css" />
</section>

<section class="mb-10">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="framework-brand">
    Framework brand in these docs
  </h2>
  <p class="mb-4 text-muted-foreground">
    On this site, each framework route paints the shell with that ecosystem&apos;s brand color. The
    same technique works in your product: scope overrides with a data attribute, a class, or a route
    layout.
  </p>
  <CodeBlock
    class="mb-2"
    code={frameworkSnippet}
    lang="css"
    title="apps/docs/src/styles/global.css"
  />
</section>

<section class="mb-10">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="convention">Token convention</h2>
  <p class="text-muted-foreground">
    Each color has two tokens: the base name is the fill. The same name with
    <code class="text-foreground">-foreground</code>
    is the text and icon color meant to sit on that fill. Use both together on every new surface so
    contrast stays consistent in light and dark mode.
  </p>
</section>

<section>
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="next">Next</h2>
  <p class="text-muted-foreground">
    Browse components under{" "}
    <a
      class="text-foreground underline-offset-4 hover:underline"
      href={frameworkPath(framework, "components/button")}
    >
      Button
    </a>{" "}
    to see the brand primary on real controls.
  </p>
</section>
