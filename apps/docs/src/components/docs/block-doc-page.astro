---
import DoDont from "#/components/docs/do-dont.astro";
import Example from "#/components/docs/example.astro";
import DocsLayout from "#/layouts/docs-layout.astro";
import { listBlockExampleNames, loadBlockPage } from "#/lib/block-doc";
import { setDocsExampleContext } from "#/lib/docs-example-context";
import { docsProseClass } from "#/lib/docs-prose";
import type { Framework } from "#/lib/nav";

interface Props {
  id: string;
  framework: Framework;
}

const id = Astro.props.id;
const framework = Astro.props.framework;

setDocsExampleContext(Astro.locals, {
  exampleId: id,
  framework,
  kind: "block",
});

const { Content: BlockContent, docs } = await loadBlockPage(framework, id);
const Content = BlockContent as (props?: {
  components?: Record<string, unknown>;
}) => unknown;
const exampleExportNames = await listBlockExampleNames(framework, id);
const mdxComponents = { DoDont, Example };
---

<DocsLayout
  description={docs.description}
  framework={framework}
  title={docs.title}
>
  <div class={docsProseClass}>
    <Content components={mdxComponents} />
  </div>

  {exampleExportNames.length > 0 ? (
    <div
      data-block-id={id}
      data-docs-block-examples-host
      data-export-names={JSON.stringify(exampleExportNames)}
      hidden
    />
  ) : null}
</DocsLayout>
