---
import type { DocsArea, Framework } from "../../lib/nav";
import { frameworkPath, mainNav } from "../../lib/nav";

export { frameworkPath, mainNav };

interface Props {
  framework: Framework;
  area: DocsArea;
}
---

<nav aria-label="Primary" class="ms-4 hidden items-center gap-1 md:flex">
  {
    mainNav.map((item) => {
      const href = frameworkPath(Astro.props.framework, item.slug);
      const active = Astro.props.area === item.id;
      return (
        <a
          aria-current={active ? "page" : undefined}
          class:list={[
            "rounded-lg px-3 py-1.5 text-sm font-medium transition",
            active
              ? "bg-accent/70 text-accent-foreground"
              : "text-muted-foreground hover:bg-accent/40 hover:text-foreground",
          ]}
          href={href}
        >
          {item.label}
        </a>
      );
    })
  }
</nav>
