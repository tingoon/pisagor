---
import { MagnifyingGlassIcon } from "@phosphor-icons/react";
import type { Framework, NavSection } from "#/lib/nav";
import { frameworkPath } from "#/lib/nav";

interface Props {
  framework: Framework;
  sections: NavSection[];
  currentPath: string;
  /** Unique per instance (desktop sidebar vs mobile sheet). */
  idPrefix: string;
}

const { framework, sections, idPrefix } = Astro.props;

function normalizePath(value: string): string {
  return value.replace(/\/$/, "") || "/";
}

const path = normalizePath(Astro.props.currentPath);
const navHrefs = sections.flatMap((section) =>
  section.items
    .filter((item) => item.status !== "soon")
    .map((item) => normalizePath(frameworkPath(framework, item.slug))),
);

/** Exact match, or prefix match only when no longer sidebar href also matches. */
function isNavActive(href: string): boolean {
  if (path === href) return true;
  if (href === "/" || !path.startsWith(`${href}/`)) return false;

  return !navHrefs.some(
    (other) =>
      other !== href &&
      other.startsWith(`${href}/`) &&
      (path === other || path.startsWith(`${other}/`)),
  );
}

const filterId = `${idPrefix}-filter`;
---

<div class="flex h-full min-h-0 flex-1 flex-col" data-sidebar-nav>
  <div class="shrink-0 px-1 pb-3">
    <label class="sr-only" for={filterId}>Filter</label>
    <div class="relative">
      <MagnifyingGlassIcon
        aria-hidden
        className="pointer-events-none absolute inset-s-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground"
        weight="bold"
      />
      <input
        autocomplete="off"
        class="docs-press h-8 w-full rounded-lg border border-border/70 bg-background ps-8 pe-2.5 text-foreground text-sm outline-none placeholder:text-muted-foreground/80 focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40"
        data-sidebar-filter
        id={filterId}
        placeholder="Filter"
        spellcheck="false"
        type="search"
      >
    </div>
  </div>

  <nav
    aria-label="Sidebar"
    class="scrollbar-thin flex min-h-0 flex-1 flex-col gap-6 overflow-y-auto overscroll-contain [scrollbar-color:color-mix(in_oklab,var(--border)_80%,transparent)_transparent]"
  >
    <p class="hidden px-2.5 text-muted-foreground text-sm" data-sidebar-empty>
      No matches
    </p>
    {sections.map((section) => (
      <div data-sidebar-section={section.title.toLowerCase()}>
        <p class="docs-label mb-3 px-2.5">{section.title}</p>
        <ul class="space-y-px">
          {section.items.map((item) => {
            const href = frameworkPath(framework, item.slug);
            const active = isNavActive(normalizePath(href));
            return (
              <li data-sidebar-item={item.title.toLowerCase()}>
                {item.status === "soon" ? (
                  <span class="docs-nav-link flex items-center justify-between rounded-md px-2.5 py-1.5 text-foreground/40">
                    {item.title}
                    <span class="rounded border border-border/50 px-1.5 py-px font-semibold text-2.5 text-muted-foreground/70 uppercase tracking-[0.06em]">
                      Soon
                    </span>
                  </span>
                ) : (
                  <a
                    aria-current={active ? "page" : undefined}
                    class:list={[
                      "docs-press docs-nav-link flex items-center rounded-md px-2.5 py-1.5",
                      active
                        ? "bg-accent/80 font-medium text-accent-foreground"
                        : "text-foreground/65 hover:bg-accent/40 hover:text-foreground",
                    ]}
                    href={href}
                  >
                    {item.title}
                  </a>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>
</div>

<script>
function bindSidebarFilter(root: HTMLElement) {
  if (root.dataset.bound === "1") return;
  root.dataset.bound = "1";
  const input = root.querySelector<HTMLInputElement>("[data-sidebar-filter]");
  const empty = root.querySelector<HTMLElement>("[data-sidebar-empty]");
  const sections = [
    ...root.querySelectorAll<HTMLElement>("[data-sidebar-section]"),
  ];
  input?.addEventListener("input", () => {
    const q = input.value.trim().toLowerCase();
    let any = false;
    for (const section of sections) {
      const sectionMatch = (section.dataset.sidebarSection ?? "").includes(q);
      let visible = 0;
      for (const item of section.querySelectorAll<HTMLElement>(
        "[data-sidebar-item]",
      )) {
        const show =
          !q || sectionMatch || (item.dataset.sidebarItem ?? "").includes(q);
        item.hidden = !show;
        if (show) visible++;
      }
      section.hidden = visible === 0;
      if (visible > 0) any = true;
    }
    empty?.classList.toggle("hidden", any);
  });
}

for (const root of document.querySelectorAll<HTMLElement>(
  "[data-sidebar-nav]",
)) {
  bindSidebarFilter(root);
}
</script>
