---
import { Button, Separator } from "@pisagor/astro";

interface Props {
  /** One or more packages, e.g. "@pisagor/react" */
  packages?: string | string[];
  /** Optional import / setup snippet shown under Manual */
  manual?: string;
  class?: string;
}

const packagesProp = Astro.props.packages;
const pkgs = (Array.isArray(packagesProp) ? packagesProp : [packagesProp])
  .filter((p): p is string => typeof p === "string" && p.trim().length > 0)
  .map((p) => p.trim());
const resolvedPkgs = pkgs.length > 0 ? pkgs : ["@pisagor/react"];
const pkgList = resolvedPkgs.join(" ");

const managers = [
  { command: `bun add ${pkgList}`, id: "bun", label: "bun" },
  { command: `npm install ${pkgList}`, id: "npm", label: "npm" },
  { command: `pnpm add ${pkgList}`, id: "pnpm", label: "pnpm" },
  { command: `yarn add ${pkgList}`, id: "yarn", label: "yarn" },
] as const;

const defaultManager = managers[0];

const defaultManual =
  Astro.props.manual ??
  (resolvedPkgs.length === 1
    ? `import { /* … */ } from "${resolvedPkgs[0]}";`
    : resolvedPkgs.map((p) => `import { /* … */ } from "${p}";`).join("\n"));

const tabClass =
  "shrink-0 text-muted-foreground data-active:bg-background data-active:text-foreground data-active:shadow-sm";
---

<div
  data-installation
  class:list={["installation not-prose", Astro.props.class]}
>
  <div
    class="relative overflow-hidden rounded-xl border border-border/70 bg-card"
  >
    <div
      class="flex items-center gap-2 border-b border-border/60 bg-muted/30 px-2 py-1.5"
    >
      <span
        aria-hidden="true"
        class="ms-1 hidden size-7 shrink-0 items-center justify-center text-muted-foreground sm:inline-flex"
      >
        <svg
          aria-hidden="true"
          class="size-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            d="M4 17l6-6-6-6M12 19h8"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </span>

      <div
        aria-label="Installation method"
        class="flex min-w-0 flex-1 items-center gap-0.5 overflow-x-auto"
        role="tablist"
      >
        {managers.map((manager) => (
          <Button
            aria-selected={manager.id === defaultManager.id ? "true" : "false"}
            class={tabClass}
            data-active={manager.id === defaultManager.id ? "" : undefined}
            data-command={manager.command}
            data-mode="cli"
            data-pm={manager.id}
            data-tab
            role="tab"
            size="sm"
            type="button"
            variant="ghost"
          >
            {manager.label}
          </Button>
        ))}
        <Separator class="mx-1 h-4" orientation="vertical" />
        <Button
          aria-selected="false"
          class={tabClass}
          data-mode="manual"
          data-tab
          role="tab"
          size="sm"
          type="button"
          variant="ghost"
        >
          Manual
        </Button>
      </div>
    </div>

    <div data-panel="cli" role="tabpanel">
      <pre
        class="overflow-x-auto py-3.5 ps-4 pe-12 font-mono text-3.25 leading-relaxed text-foreground"
      ><code data-command-text>{defaultManager.command}</code></pre>
    </div>

    <div class="hidden" data-panel="manual" role="tabpanel">
      <pre
        class="overflow-x-auto py-3.5 ps-4 pe-12 font-mono text-3.25 leading-relaxed text-foreground"
        data-manual-source
      ><code>{defaultManual}</code></pre>
      <p
        class="border-t border-border/60 px-4 py-2.5 text-xs text-muted-foreground"
      >
        Install the package with your package manager, then import the
        components you need.
      </p>
    </div>

    <Button
      aria-label="Copy to clipboard"
      class="absolute end-2 bottom-2 data-copied:text-emerald-500 data-[mode=manual]:bottom-auto data-[mode=manual]:top-12"
      data-copy
      size="icon-sm"
      type="button"
      variant="ghost"
    >
      <svg
        aria-hidden="true"
        class="size-3.5"
        data-copy-idle
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <rect height="13" rx="2" width="13" x="9" y="9"></rect>
        <path
          d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
        ></path>
      </svg>
      <svg
        aria-hidden="true"
        class="size-3.5"
        data-copy-done
        fill="none"
        hidden
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          d="M20 6L9 17l-5-5"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </Button>
  </div>
</div>

<script>
const STORAGE_KEY = "pisagor.docs.package-manager";

function markCopied(btn: HTMLElement) {
  const idle = btn.querySelector<HTMLElement>("[data-copy-idle]");
  const done = btn.querySelector<HTMLElement>("[data-copy-done]");
  if (idle) idle.hidden = true;
  if (done) done.hidden = false;
  btn.dataset.copied = "";
  window.setTimeout(() => {
    if (idle) idle.hidden = false;
    if (done) done.hidden = true;
    delete btn.dataset.copied;
  }, 1400);
}

async function copyText(text: string) {
  try {
    await navigator.clipboard.writeText(text);
  } catch {
    const ta = document.createElement("textarea");
    ta.value = text;
    document.body.appendChild(ta);
    ta.select();
    document.execCommand("copy");
    ta.remove();
  }
}

function bindInstallation(root: HTMLElement) {
  if (root.dataset.bound === "1") return;
  root.dataset.bound = "1";

  const tabs = [...root.querySelectorAll<HTMLElement>("[data-tab]")];
  const pmTabs = tabs.filter((tab) => tab.dataset.pm);
  const cliPanel = root.querySelector<HTMLElement>('[data-panel="cli"]');
  const manualPanel = root.querySelector<HTMLElement>('[data-panel="manual"]');
  const commandEl = root.querySelector<HTMLElement>("[data-command-text]");
  const manualSource = root.querySelector<HTMLElement>("[data-manual-source]");
  const copyBtn = root.querySelector<HTMLElement>("[data-copy]");
  let mode: "cli" | "manual" = "cli";

  function activate(target: HTMLElement) {
    mode = target.dataset.mode === "manual" ? "manual" : "cli";
    for (const tab of tabs) {
      const active = tab === target;
      tab.toggleAttribute("data-active", active);
      tab.setAttribute("aria-selected", active ? "true" : "false");
    }
    cliPanel?.classList.toggle("hidden", mode !== "cli");
    manualPanel?.classList.toggle("hidden", mode !== "manual");
    if (copyBtn) copyBtn.dataset.mode = mode;

    if (mode === "cli" && target.dataset.pm) {
      if (commandEl && target.dataset.command) {
        commandEl.textContent = target.dataset.command;
      }
      try {
        localStorage.setItem(STORAGE_KEY, target.dataset.pm);
      } catch {
        /* ignore */
      }
    }
  }

  for (const tab of tabs) {
    tab.addEventListener("click", () => activate(tab));
  }

  copyBtn?.addEventListener("click", async () => {
    const source = mode === "manual" ? manualSource : commandEl;
    const text = source?.textContent?.trim() ?? "";
    if (!text) return;
    await copyText(text);
    markCopied(copyBtn);
  });

  let preferred: string | null = null;
  try {
    preferred = localStorage.getItem(STORAGE_KEY);
  } catch {
    /* ignore */
  }
  const initial =
    pmTabs.find((tab) => tab.dataset.pm === preferred) ?? pmTabs[0];
  if (initial) activate(initial);
}

function bindAll() {
  document
    .querySelectorAll<HTMLElement>("[data-installation]")
    .forEach(bindInstallation);
}

bindAll();
document.addEventListener("astro:page-load", bindAll);
</script>
