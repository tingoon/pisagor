---
import { Button } from "@pisagor/astro";
import { InstallationManagerTabs } from "./react/installation-manager-tabs";

interface Props {
  /** One or more packages, e.g. "@pisagor/react" */
  packages?: string | string[];
  class?: string;
}

const packagesProp = Astro.props.packages;
const pkgs = (Array.isArray(packagesProp) ? packagesProp : [packagesProp])
  .filter((p): p is string => typeof p === "string" && p.trim().length > 0)
  .map((p) => p.trim());
const resolvedPkgs = pkgs.length > 0 ? pkgs : ["@pisagor/react"];
const pkgList = resolvedPkgs.join(" ");

const managers = [
  { command: `bun add ${pkgList}`, id: "bun", label: "bun" },
  { command: `npm install ${pkgList}`, id: "npm", label: "npm" },
  { command: `pnpm add ${pkgList}`, id: "pnpm", label: "pnpm" },
  { command: `yarn add ${pkgList}`, id: "yarn", label: "yarn" },
] as const;

const defaultManager = managers[0];
---

<div
  data-installation
  class:list={["installation not-prose", Astro.props.class]}
>
  <div
    class="relative overflow-hidden rounded-xl border border-border/70 bg-card"
  >
    <div
      class="flex items-center gap-2 border-b border-border/60 bg-muted/30 px-2 py-1.5"
    >
      <span
        aria-hidden="true"
        class="ms-1 hidden size-7 shrink-0 items-center justify-center text-muted-foreground sm:inline-flex"
      >
        <svg
          aria-hidden="true"
          class="size-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            d="M4 17l6-6-6-6M12 19h8"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </span>

      <InstallationManagerTabs client:load managers={[...managers]} />
    </div>

    <div role="tabpanel">
      <pre
        class="overflow-x-auto py-3.5 ps-4 pe-12 font-mono text-sm leading-relaxed text-foreground"
      ><code data-command-text>{defaultManager.command}</code></pre>
    </div>

    <Button
      aria-label="Copy to clipboard"
      class="absolute end-2 bottom-2 data-copied:text-emerald-500"
      data-copy
      size="icon-sm"
      type="button"
      variant="ghost"
    >
      <svg
        aria-hidden="true"
        class="size-3.5"
        data-copy-idle
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <rect height="13" rx="2" width="13" x="9" y="9"></rect>
        <path
          d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
        ></path>
      </svg>
      <svg
        aria-hidden="true"
        class="size-3.5"
        data-copy-done
        fill="none"
        hidden
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          d="M20 6L9 17l-5-5"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </Button>
  </div>
</div>

<script>
function markCopied(btn: HTMLElement) {
  const idle = btn.querySelector<HTMLElement>("[data-copy-idle]");
  const done = btn.querySelector<HTMLElement>("[data-copy-done]");
  if (idle) idle.hidden = true;
  if (done) done.hidden = false;
  btn.dataset.copied = "";
  window.setTimeout(() => {
    if (idle) idle.hidden = false;
    if (done) done.hidden = true;
    delete btn.dataset.copied;
  }, 1400);
}

async function copyText(text: string) {
  try {
    await navigator.clipboard.writeText(text);
  } catch {
    const ta = document.createElement("textarea");
    ta.value = text;
    document.body.appendChild(ta);
    ta.select();
    document.execCommand("copy");
    ta.remove();
  }
}

function bindInstallation(root: HTMLElement) {
  if (root.dataset.bound === "1") return;
  root.dataset.bound = "1";

  const commandEl = root.querySelector<HTMLElement>("[data-command-text]");
  const copyBtn = root.querySelector<HTMLElement>("[data-copy]");

  copyBtn?.addEventListener("click", async () => {
    const text = commandEl?.textContent?.trim() ?? "";
    if (!text) return;
    await copyText(text);
    markCopied(copyBtn);
  });
}

function bindAll() {
  document
    .querySelectorAll<HTMLElement>("[data-installation]")
    .forEach(bindInstallation);
}

bindAll();
document.addEventListener("astro:page-load", bindAll);
</script>
