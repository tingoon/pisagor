---
import ComponentHeader from "#/components/docs/component-header.astro";
import DoDont from "#/components/docs/do-dont.astro";
import Example from "#/components/docs/example.astro";
import PropsTable from "#/components/docs/props-table.astro";
import DocsLayout from "#/layouts/docs-layout.astro";
import { loadProps } from "#/lib/component-doc";
import { setDocsExampleContext } from "#/lib/docs-example-context";
import { docsProseClass } from "#/lib/docs-prose";
import { listFormExampleNames, loadFormPage } from "#/lib/form-doc";
import type { Framework } from "#/lib/nav";
import { frameworks } from "#/lib/nav";

interface Props {
  id: string;
  framework: Framework;
}

const id = Astro.props.id;
const framework = Astro.props.framework;

setDocsExampleContext(Astro.locals, {
  exampleId: id,
  framework,
  kind: "form",
});

const {
  Content: FormContent,
  docs,
  getHeadings,
} = await loadFormPage(framework, id);
const Content = FormContent as (props?: {
  components?: Record<string, unknown>;
}) => unknown;
const exampleExportNames = await listFormExampleNames(framework, id);
const propsRows = loadProps(id);
const paneHeadings = getHeadings().filter(
  (h) => h.depth === 2 || h.depth === 3,
);
const headings = [...paneHeadings, { depth: 2, slug: "props", text: "Props" }];
const mdxComponents = { DoDont, Example };
const frameworkLabel =
  frameworks.find((item) => item.id === framework)?.label ?? framework;
const pkg = docs.packageName;
---

<DocsLayout
  description={docs.description}
  framework={framework}
  headings={headings}
  metaTitle={`${docs.title} – ${frameworkLabel} Forms`}
  title={docs.title}
>
  <ComponentHeader
    aliases={docs.aliases}
    api={docs.api}
    framework={framework}
    packageName={pkg}
    slot="title-actions"
    taxonomy={docs.taxonomy}
  />

  <div class={docsProseClass}>
    <Content components={mdxComponents} />
  </div>

  {exampleExportNames.length > 0 ? (
    <div
      data-component-id={id}
      data-docs-examples-host
      data-export-names={JSON.stringify(exampleExportNames)}
      data-kind="form"
      hidden
    />
  ) : null}

  <div class="mt-10">
    <h2 class="mb-3 font-semibold text-2xl tracking-tight" id="props">Props</h2>
    {propsRows ? (
      <PropsTable rows={propsRows} />
    ) : (
      <p class="text-muted-foreground text-sm">
        This utility has no dedicated entries in <code>@pisagor/contracts</code>{" "}
        yet.
      </p>
    )}
  </div>
</DocsLayout>
