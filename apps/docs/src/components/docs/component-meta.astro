---
import { componentMeta } from "../../lib/component-meta";

interface Props {
  id: string;
}

const meta = componentMeta[Astro.props.id as keyof typeof componentMeta];

const rows = meta
  ? [
      { label: "API", value: meta.api },
      { label: "Taxonomy", value: meta.taxonomy },
      ...(meta.aliases?.length ? [{ label: "Aliases", value: meta.aliases.join(", ") }] : []),
    ]
  : [];
---

{
  
  rows.length > 0 ? (
    <dl
      aria-label="Component metadata"
      class="flex flex-wrap items-baseline gap-x-6 gap-y-2 text-sm"
    >
      {rows.map((row) => (
        <div class="flex min-w-0 items-baseline gap-2">
          <dt class="docs-label shrink-0">{row.label}</dt>
          <dd class="font-mono text-3.25 text-foreground/90">{row.value}</dd>
        </div>
      ))}
    </dl>
  ) : null
}
