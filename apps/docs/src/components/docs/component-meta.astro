---
import type { ComponentDocs } from "#/lib/component-docs-types";

interface Props {
  api: ComponentDocs["api"];
  taxonomy: ComponentDocs["taxonomy"];
  aliases?: string[];
}

const rows = [
  { label: "API", value: Astro.props.api },
  { label: "Taxonomy", value: Astro.props.taxonomy },
  ...(Astro.props.aliases?.length
    ? [{ label: "Aliases", value: Astro.props.aliases.join(", ") }]
    : []),
];
---

<dl
  aria-label="Component metadata"
  class="flex flex-wrap items-baseline gap-x-6 gap-y-2 text-sm"
>
  {rows.map((row) => (
    <div class="flex min-w-0 items-baseline gap-2">
      <dt class="docs-label shrink-0">{row.label}</dt>
      <dd class="font-mono text-3.25 text-foreground/90">{row.value}</dd>
    </div>
  ))}
</dl>
