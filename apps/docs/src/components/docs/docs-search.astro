---
import { MagnifyingGlassIcon } from "@phosphor-icons/react";
import type { Framework } from "#/lib/nav";

interface Props {
  framework: Framework;
}
---

<div
  data-docs-search
  data-framework={Astro.props.framework}
  data-pagefind-base={import.meta.env.BASE_URL}
>
  <button
    aria-haspopup="dialog"
    aria-keyshortcuts="Control+K Meta+K"
    aria-label="Search docs"
    class="docs-press inline-flex h-8 items-center gap-2 rounded-lg border border-border/70 bg-background px-2 text-muted-foreground text-sm hover:bg-accent/60 hover:text-foreground sm:w-40 sm:px-2.5"
    data-docs-search-open
    type="button"
  >
    <MagnifyingGlassIcon
      aria-hidden
      className="size-4 shrink-0"
      weight="bold"
    />
    <span class="hidden flex-1 text-left sm:inline">Search</span>
    <kbd
      class="hidden rounded border border-border/70 px-1 font-mono text-2.5 text-muted-foreground sm:inline"
      >⌘K</kbd
    >
  </button>

  <dialog
    aria-label="Search documentation"
    class="docs-search-dialog m-0 mx-auto mt-[10vh] w-[min(40rem,calc(100vw-1.5rem))] max-w-none rounded-2xl border border-border/70 bg-background p-0 text-foreground shadow-xl backdrop:bg-black/30 backdrop:backdrop-blur-[2px]"
    data-docs-search-dialog
  >
    <div class="flex items-center gap-2 border-border/60 border-b px-3">
      <MagnifyingGlassIcon
        aria-hidden
        className="size-4 shrink-0 text-muted-foreground"
        weight="bold"
      />
      <label class="sr-only" for="docs-search-input">Search</label>
      <input
        aria-autocomplete="list"
        aria-controls="docs-search-results"
        aria-expanded="false"
        autocomplete="off"
        class="h-12 min-w-0 flex-1 bg-transparent text-base outline-none placeholder:text-muted-foreground/80 sm:text-sm"
        data-docs-search-input
        id="docs-search-input"
        placeholder="Search components, blocks, forms…"
        role="combobox"
        spellcheck="false"
        type="search"
      >
      <button
        aria-label="Close search"
        class="docs-press rounded-md border border-border/70 px-1.5 py-0.5 font-mono text-2.5 text-muted-foreground hover:text-foreground"
        data-docs-search-close
        type="button"
      >
        Esc
      </button>
    </div>
    <div class="max-h-[60vh] overflow-y-auto p-2" data-docs-search-body>
      <p
        aria-live="polite"
        class="px-2 py-6 text-center text-muted-foreground text-sm"
        data-docs-search-status
      >
        Type to search the {Astro.props.framework} docs.
      </p>
      <div
        class="flex flex-col gap-1"
        data-docs-search-results
        id="docs-search-results"
        role="listbox"
      ></div>
    </div>
  </dialog>
</div>

<script>
import { bindDocsSearch } from "#/lib/docs-search-client";

for (const root of document.querySelectorAll<HTMLElement>(
  "[data-docs-search]",
)) {
  bindDocsSearch(root);
}
</script>
