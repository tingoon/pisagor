---
import ComponentHeader from "#/components/docs/component-header.astro";
import ComponentPreview from "#/components/docs/component-preview.astro";
import PropsTable from "#/components/docs/props-table.astro";
import { ReactExampleIsland } from "#/components/docs/react-example-island";
import { SolidExampleIsland } from "#/components/docs/solid-example-island";
import SvelteExampleIsland from "#/components/docs/svelte-example-island.svelte";
import VueExampleIsland from "#/components/docs/vue-example-island.vue";
import DocsLayout from "#/layouts/docs-layout.astro";
import {
  type ComponentDocKind,
  defaultPackageName,
  getExampleExport,
  hasSkillFolder,
  listComponentDocTabs,
  loadExamples,
  loadProps,
  loadSkillMd,
  loadSkillPanes,
  PREVIEW_LANGUAGE,
  type SkillPaneId,
} from "#/lib/component-doc";
import type { ComponentDocs } from "#/lib/component-docs-types";
import type { Framework } from "#/lib/nav";
import { withDocsBase } from "#/lib/nav";
import { resolveComponentExamples } from "#/lib/parse-example-directives";
import { findSkillExamplesBody } from "#/lib/skill-doc";

interface Props {
  id: string;
  framework: Framework;
  tab: SkillPaneId;
  kind?: ComponentDocKind;
}

interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

const id = Astro.props.id;
const framework = Astro.props.framework;
const kind = Astro.props.kind ?? "component";
const activeTab = Astro.props.tab;

const { Content, frontmatter, getHeadings } = await loadSkillMd(
  framework,
  id,
  kind,
);
const panes = await loadSkillPanes(framework, id, kind);
const isSplit = hasSkillFolder(framework, id, kind);
const docs = frontmatter as ComponentDocs;
const examples = loadExamples(framework, id, kind);
const propsRows = loadProps(id);
const pkg = docs.packageName ?? defaultPackageName(framework, kind);
const language = PREVIEW_LANGUAGE[framework];
const areaSlug = kind === "form" ? "forms" : "components";

const examplesBody = findSkillExamplesBody(id, {
  framework,
  packageName: pkg,
});
const exampleDocs = resolveComponentExamples(examplesBody);
const tabs = await listComponentDocTabs(framework, id, kind);

if (!tabs.some((t) => t.id === activeTab)) {
  throw new Error(`Unknown tab "${activeTab}" for ${framework}/${kind}/${id}`);
}

const DesignContent = panes.design?.Content;
const UsageContent = panes.usage?.Content;
const DevelopContent = panes.develop?.Content;

const exampleSlugs = new Set(exampleDocs.map((ex) => ex.id));
const flatMdHeadings = isSplit
  ? []
  : getHeadings()
      .filter((h) => h.depth >= 2)
      .filter(
        (h) => h.slug !== "examples" && h.text.toLowerCase() !== "examples",
      )
      .filter((h) => !exampleSlugs.has(h.slug))
      .map(
        (h): TocHeading => ({
          depth: h.depth,
          slug: h.slug,
          text: h.text,
        }),
      );

const headingsByTab: Record<SkillPaneId, TocHeading[]> = {
  design: (panes.design?.getHeadings() ?? [])
    .filter((h) => h.depth >= 2)
    .map((h) => ({ depth: h.depth, slug: h.slug, text: h.text })),
  develop: [
    ...(panes.develop?.getHeadings() ?? [])
      .filter((h) => h.depth >= 2)
      .map((h) => ({ depth: h.depth, slug: h.slug, text: h.text })),
    { depth: 2, slug: "props", text: "Props" },
  ],
  examples: [
    { depth: 2, slug: "examples", text: "Examples" },
    ...exampleDocs.map((ex) => ({
      depth: 3,
      slug: ex.id,
      text: ex.title,
    })),
  ],
  usage: isSplit
    ? (panes.usage?.getHeadings() ?? [])
        .filter((h) => h.depth >= 2)
        .map((h) => ({ depth: h.depth, slug: h.slug, text: h.text }))
    : flatMdHeadings,
};

const headings = headingsByTab[activeTab] ?? [];

function tabHref(tabId: SkillPaneId): string {
  return withDocsBase(`/${framework}/${areaSlug}/${id}/${tabId}`);
}

const proseClass =
  "docs-skill-md space-y-4 text-sm leading-7 text-foreground/90 [&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-2 [&_code]:rounded-md [&_code]:bg-muted/60 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-3.25 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-foreground [&_h2:first-child]:mt-0 [&_li]:my-1 [&_ol]:my-3 [&_ol]:list-decimal [&_ol]:ps-5 [&_p]:my-3 [&_pre]:my-4 [&_pre]:overflow-x-auto [&_pre]:rounded-xl [&_pre]:border [&_pre]:border-border/60 [&_pre]:bg-muted/30 [&_pre]:p-4 [&_pre]:text-3.25 [&_strong]:font-semibold [&_table]:my-4 [&_table]:w-full [&_table]:text-left [&_td]:border-b [&_td]:border-border/50 [&_td]:py-2 [&_td]:pe-4 [&_th]:border-b [&_th]:border-border/70 [&_th]:py-2 [&_th]:pe-4 [&_th]:font-semibold [&_ul]:my-3 [&_ul]:list-disc [&_ul]:ps-5";
---

<DocsLayout
  description={docs.description}
  framework={framework}
  headings={headings}
  title={docs.title}
>
  <div
    class="sticky top-14 z-30 -mx-4 mb-8 border-b border-border/60 bg-background/90 px-4 py-3 backdrop-blur-md sm:-mx-8 sm:px-8 lg:-mx-10 lg:px-10"
    slot="nav"
  >
    <div
      aria-label="Documentation sections"
      class="inline-flex flex-wrap rounded-lg border border-border/70 bg-muted/30 p-0.5"
      role="tablist"
    >
      {tabs.map((tab) => (
  <a
    aria-controls={`doc-panel-${tab.id}`}
    aria-selected={tab.id === activeTab ? "true" : "false"}
    class="rounded-md px-3 py-1.5 font-medium text-muted-foreground text-sm transition-colors hover:text-foreground data-active:bg-background data-active:text-foreground data-active:shadow-sm"
    data-active={tab.id === activeTab ? "" : undefined}
    href={tabHref(tab.id)}
    id={`doc-tab-${tab.id}`}
    role="tab"
  >
    {tab.label}
  </a>
))}
    </div>
  </div>

  <ComponentHeader framework={framework} id={id} packageName={pkg} />

  <div class="mt-8">
    {activeTab === "examples" ? (
  <div
    aria-labelledby="doc-tab-examples"
    id="doc-panel-examples"
    role="tabpanel"
  >
    <h2 class="mb-3 font-semibold text-2xl tracking-tight" id="examples">
      Examples
    </h2>
    {exampleDocs.map((ex) => {
      const Example = getExampleExport(examples, ex.exportName);
      const code = examples.sources[ex.exportName];
      if (!code) return null;
      return (
        <>
          <h3
            class="mt-10 mb-3 font-semibold text-xl tracking-tight"
            id={ex.id}
          >
            {ex.title}
          </h3>
          {ex.description ? (
            <p class="mb-3 text-foreground/80 text-sm leading-7">
              {ex.description}
            </p>
          ) : null}
          <ComponentPreview
            code={code}
            language={language}
            packageName={pkg}
            title={ex.title}
          >
            {framework === "react" ? (
              <ReactExampleIsland
                client:only="react"
                componentId={id}
                exportName={ex.exportName}
                kind={kind}
              />
            ) : null}
            {framework === "vue" ? (
              <VueExampleIsland
                client:only="vue"
                componentId={id}
                exportName={ex.exportName}
                kind={kind}
              />
            ) : null}
            {framework === "solid" ? (
              <SolidExampleIsland
                client:only="solid-js"
                componentId={id}
                exportName={ex.exportName}
                kind={kind}
              />
            ) : null}
            {framework === "svelte" ? (
              <SvelteExampleIsland
                client:only="svelte"
                componentId={id}
                exportName={ex.exportName}
                kind={kind}
              />
            ) : null}
            {framework === "astro" ? <Example /> : null}
          </ComponentPreview>
        </>
      );
    })}
  </div>
) : null}

    {activeTab === "usage" ? (
  <div
    aria-labelledby="doc-tab-usage"
    class={proseClass}
    id="doc-panel-usage"
    role="tabpanel"
  >
    {isSplit && UsageContent ? <UsageContent /> : <Content />}
  </div>
) : null}

    {activeTab === "design" && DesignContent ? (
  <div
    aria-labelledby="doc-tab-design"
    class={proseClass}
    id="doc-panel-design"
    role="tabpanel"
  >
    <DesignContent />
  </div>
) : null}

    {activeTab === "develop" ? (
  <div aria-labelledby="doc-tab-develop" id="doc-panel-develop" role="tabpanel">
    {DevelopContent ? (
      <div class:list={[proseClass, "mb-10"]}>
        <DevelopContent />
      </div>
    ) : null}
    <h2 class="mb-3 font-semibold text-2xl tracking-tight" id="props">
      Props
    </h2>
    {propsRows ? (
      <PropsTable rows={propsRows} />
    ) : (
      <p class="text-muted-foreground text-sm">
        This utility has no dedicated entries in <code>@pisagor/props</code>{" "}
        yet.
      </p>
    )}
  </div>
) : null}
  </div>
</DocsLayout>
