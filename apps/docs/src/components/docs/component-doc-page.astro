---
import ComponentHeader from "#/components/docs/component-header.astro";
import ComponentPreview from "#/components/docs/component-preview.astro";
import PropsTable from "#/components/docs/props-table.astro";
import DocsLayout from "#/layouts/docs-layout.astro";
import { resolveAnatomySrc } from "#/lib/anatomy";
import {
  assertExampleSource,
  type ComponentDocKind,
  defaultPackageName,
  getExampleExport,
  listComponentDocTabs,
  loadExamples,
  loadProps,
  loadSkillMd,
  loadSkillPanes,
  PREVIEW_LANGUAGE,
  type SkillPaneId,
} from "#/lib/component-doc";
import type { ComponentDocs } from "#/lib/component-docs-types";
import { renderDevelopSegments } from "#/lib/develop-markdown";
import type { Framework } from "#/lib/nav";
import { withDocsBase } from "#/lib/nav";
import { extractTocHeadings } from "#/lib/parse-example-directives";
import { findDisplayedSkillBody } from "#/lib/skill-doc";

interface Props {
  id: string;
  framework: Framework;
  tab: SkillPaneId;
  kind?: ComponentDocKind;
}

const id = Astro.props.id;
const framework = Astro.props.framework;
const kind = Astro.props.kind ?? "component";
const activeTab = Astro.props.tab;
const anatomySrc = resolveAnatomySrc(id);

const { frontmatter } = await loadSkillMd(framework, id, kind);
const panes = await loadSkillPanes(framework, id, kind);
const docs = frontmatter as ComponentDocs;
const examples =
  activeTab === "develop" ? await loadExamples(framework, id, kind) : null;
const propsRows = loadProps(id);
const pkg = docs.packageName ?? defaultPackageName(framework, kind);
const language = PREVIEW_LANGUAGE[framework];
const areaSlug = kind === "form" ? "forms" : "components";

const skillOpts = { framework, packageName: pkg };
const tabs = await listComponentDocTabs(framework, id, kind);

if (!tabs.some((t) => t.id === activeTab)) {
  throw new Error(`Unknown tab "${activeTab}" for ${framework}/${kind}/${id}`);
}

const DesignContent = panes.design?.Content;

const paneForToc = activeTab === "design" ? "design" : "develop";
const developBody = findDisplayedSkillBody(id, "develop", skillOpts);
const paneHeadings = extractTocHeadings(
  findDisplayedSkillBody(id, paneForToc, skillOpts),
);
// Develop markdown is the SSOT: page sections and TOC follow its heading order.
const developSegments =
  activeTab === "develop" ? await renderDevelopSegments(developBody) : [];
const headings = [
  ...paneHeadings,
  ...(activeTab === "develop"
    ? [{ depth: 2, slug: "props", text: "Props" }]
    : []),
];

const exampleExportNames =
  examples == null
    ? []
    : developSegments.flatMap((segment) => {
        if (segment.type !== "example-section") return [];
        return segment.items.flatMap((item) => {
          if (item.type !== "example") return [];
          assertExampleSource(examples, item.doc.exportName);
          return examples.sources[item.doc.exportName]
            ? [item.doc.exportName]
            : [];
        });
      });

function tabHref(tabId: SkillPaneId): string {
  return withDocsBase(`/${framework}/${areaSlug}/${id}/${tabId}`);
}

const proseClass =
  "docs-skill-md space-y-4 text-sm leading-7 text-foreground/90 [&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-2 [&_code]:rounded-md [&_code]:bg-muted/60 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-3.25 [&_pre_code]:rounded-none [&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-foreground [&>h2:first-child]:!mt-0 [&_li]:my-1 [&_ol]:my-3 [&_ol]:list-decimal [&_ol]:ps-5 [&_p]:my-3 [&_pre]:my-4 [&_pre]:overflow-x-auto [&_pre]:rounded-xl [&_pre]:border [&_pre]:border-border/60 [&_pre]:bg-muted/30 [&_pre]:p-4 [&_pre]:text-3.25 [&_strong]:font-semibold [&_table]:my-4 [&_table]:w-full [&_table]:text-left [&_td]:border-b [&_td]:border-border/50 [&_td]:py-2 [&_td]:pe-4 [&_th]:border-b [&_th]:border-border/70 [&_th]:py-2 [&_th]:pe-4 [&_th]:font-semibold [&_ul]:my-3 [&_ul]:list-disc [&_ul]:ps-5";

const tablistClass =
  "inline-flex flex-wrap rounded-lg border border-border/70 bg-muted/30 p-0.5";
const tabLinkClass =
  "rounded-md px-3 py-1.5 font-medium text-muted-foreground text-sm transition-colors hover:text-foreground data-active:bg-background data-active:text-foreground data-active:shadow-sm";
const tocTablistClass =
  "flex w-full rounded-lg border border-border/70 bg-muted/30 p-0.5";
const tocTabLinkClass =
  "min-w-0 flex-1 rounded-md px-2 py-1.5 text-center font-medium text-muted-foreground text-sm transition-colors hover:text-foreground data-active:bg-background data-active:text-foreground data-active:shadow-sm";
---

<DocsLayout
  description={docs.description}
  framework={framework}
  headings={headings}
  title={docs.title}
>
  {anatomySrc && (
    <figure class="docs-anatomy" slot="hero">
      <img
        alt={`${docs.title} anatomy`}
        class="docs-anatomy-image"
        decoding="async"
        height="450"
        src={anatomySrc}
        width="800"
      />
    </figure>
  )}

  <div
    aria-label="Documentation sections"
    class={tocTablistClass}
    role="tablist"
    slot="toc-actions"
  >
    {tabs.map((tab) => (
      <a
        aria-controls={`doc-panel-${tab.id}`}
        aria-selected={tab.id === activeTab ? "true" : "false"}
        class={tocTabLinkClass}
        data-active={tab.id === activeTab ? "" : undefined}
        href={tabHref(tab.id)}
        id={`doc-tab-${tab.id}`}
        role="tab"
      >
        {tab.label}
      </a>
    ))}
  </div>

  <div class="mb-8 xl:hidden" slot="nav">
    <div
      aria-label="Documentation sections"
      class={tablistClass}
      role="tablist"
    >
      {tabs.map((tab) => (
        <a
          aria-controls={`doc-panel-${tab.id}`}
          aria-selected={tab.id === activeTab ? "true" : "false"}
          class={tabLinkClass}
          data-active={tab.id === activeTab ? "" : undefined}
          href={tabHref(tab.id)}
          role="tab"
        >
          {tab.label}
        </a>
      ))}
    </div>
  </div>

  {activeTab === "develop" && (
    <ComponentHeader framework={framework} id={id} packageName={pkg} />
  )}

  <div>
    {activeTab === "develop" ? (
      <div
        aria-labelledby="doc-tab-develop"
        id="doc-panel-develop"
        role="tabpanel"
      >
        {developSegments.length > 0 && examples ? (
          <div class={proseClass}>
            {developSegments.map((segment) => {
              if (segment.type === "html") {
                return <Fragment set:html={segment.html} />;
              }

              if (segment.type !== "example-section") return null;

              return (
                <>
                  <h2 id={segment.id}>{segment.title}</h2>
                  {segment.items.map((item) => {
                    if (item.type === "html") {
                      return <Fragment set:html={item.html} />;
                    }
                    const ex = item.doc;
                    assertExampleSource(examples, ex.exportName);
                    const Example =
                      framework === "astro"
                        ? getExampleExport(examples, ex.exportName)
                        : null;
                    if (!examples.sources[ex.exportName]) return null;
                    const HeadingTag = `h${Math.min(Math.max(ex.depth, 3), 6)}`;
                    return (
                      <>
                        {item.headed ? (
                          <HeadingTag
                            class="mt-10 mb-3 font-semibold text-xl tracking-tight"
                            id={ex.id}
                          >
                            {ex.title}
                          </HeadingTag>
                        ) : null}
                        {item.descriptionHtml ? (
                          <div
                            class="mb-3 text-foreground/80 text-sm leading-7 [&_p]:my-0!"
                            set:html={item.descriptionHtml}
                          />
                        ) : null}
                        <ComponentPreview
                          exampleId={id}
                          exportName={ex.exportName}
                          framework={framework}
                          kind={kind}
                          language={language}
                          packageName={pkg}
                          title={ex.title}
                        >
                          {framework === "astro" ? (
                            <Example />
                          ) : (
                            <div
                              class="min-h-12 w-full"
                              data-example-slot={ex.exportName}
                            />
                          )}
                        </ComponentPreview>
                      </>
                    );
                  })}
                </>
              );
            })}
          </div>
        ) : null}

        {framework !== "astro" && exampleExportNames.length > 0 ? (
          <div
            data-component-id={id}
            data-docs-examples-host
            data-export-names={JSON.stringify(exampleExportNames)}
            data-kind={kind}
            hidden
          />
        ) : null}

        <div class="mt-10">
          <h2 class="mb-3 font-semibold text-2xl tracking-tight" id="props">
            Props
          </h2>
          {propsRows ? (
            <PropsTable rows={propsRows} />
          ) : (
            <p class="text-muted-foreground text-sm">
              This utility has no dedicated entries in{" "}
              <code>@pisagor/props</code> yet.
            </p>
          )}
        </div>
      </div>
    ) : null}

    {activeTab === "design" && DesignContent ? (
      <div
        aria-labelledby="doc-tab-design"
        class:list={[proseClass, "[&>h2:first-child]:!mt-0"]}
        id="doc-panel-design"
        role="tabpanel"
      >
        <DesignContent />
      </div>
    ) : null}
  </div>
</DocsLayout>
