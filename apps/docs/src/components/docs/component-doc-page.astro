---
import ComponentHeader from "#/components/docs/component-header.astro";
import DoDont from "#/components/docs/do-dont.astro";
import Example from "#/components/docs/example.astro";
import PropsTable from "#/components/docs/props-table.astro";
import DocsLayout from "#/layouts/docs-layout.astro";
import { resolveAnatomySrc } from "#/lib/anatomy";
import {
  defaultPackageName,
  extractExampleNames,
  listComponentDocTabs,
  loadProps,
  loadSkillBody,
  loadSkillMd,
  loadSkillPane,
  type SkillPaneId,
} from "#/lib/component-doc";
import type { ComponentDocs } from "#/lib/component-docs-types";
import { setDocsExampleContext } from "#/lib/docs-example-context";
import { docsProseClass } from "#/lib/docs-prose";
import type { Framework } from "#/lib/nav";
import { frameworks, withDocsBase } from "#/lib/nav";

interface Props {
  id: string;
  framework: Framework;
  tab: SkillPaneId;
}

const id = Astro.props.id;
const framework = Astro.props.framework;
const activeTab = Astro.props.tab;
const anatomySrc = resolveAnatomySrc(id);

setDocsExampleContext(Astro.locals, {
  exampleId: id,
  framework,
  kind: "component",
});

const { frontmatter } = await loadSkillMd(framework, id);
const pane = await loadSkillPane(framework, id, activeTab);
const docs = frontmatter as ComponentDocs;
const propsRows = loadProps(id);
const pkg = docs.packageName ?? defaultPackageName(framework);

const tabs = listComponentDocTabs(framework, id);

if (!tabs.some((t) => t.id === activeTab)) {
  throw new Error(`Unknown tab "${activeTab}" for ${framework}/${id}`);
}

const PaneContent = pane.Content as (props?: {
  components?: Record<string, unknown>;
}) => unknown;
const mdxComponents = { DoDont, Example };

const paneHeadings = pane
  .getHeadings()
  .filter((h) => h.depth === 2 || h.depth === 3);
const headings = [
  ...paneHeadings,
  ...(activeTab === "develop"
    ? [{ depth: 2, slug: "props", text: "Props" }]
    : []),
];

const exampleExportNames =
  activeTab === "develop"
    ? extractExampleNames(await loadSkillBody(framework, id, "develop"))
    : [];

function tabHref(tabId: SkillPaneId): string {
  return withDocsBase(`/${framework}/components/${id}/${tabId}`);
}

const frameworkLabel =
  frameworks.find((item) => item.id === framework)?.label ?? framework;
const tabLabel = tabs.find((t) => t.id === activeTab)?.label ?? activeTab;
const metaTitle = `${docs.title} ${tabLabel} – ${frameworkLabel}`;

const proseClass = docsProseClass;

const tablistClass =
  "inline-flex flex-wrap rounded-lg border border-border/70 bg-muted/30 p-0.5";
const tabLinkClass =
  "rounded-md px-3 py-1.5 font-medium text-muted-foreground text-sm transition-colors hover:text-foreground data-active:bg-background data-active:text-foreground data-active:shadow-sm";
const tocTablistClass =
  "flex w-full rounded-lg border border-border/70 bg-muted/30 p-0.5";
const tocTabLinkClass =
  "min-w-0 flex-1 rounded-md px-2 py-1.5 text-center font-medium text-muted-foreground text-sm transition-colors hover:text-foreground data-active:bg-background data-active:text-foreground data-active:shadow-sm";
---

<DocsLayout
  description={docs.description}
  framework={framework}
  headings={headings}
  metaTitle={metaTitle}
  title={docs.title}
>
  {anatomySrc && (
    <figure class="docs-anatomy" slot="hero">
      <img
        alt={`${docs.title} anatomy`}
        class="docs-anatomy-image"
        decoding="async"
        height="450"
        src={anatomySrc}
        width="800"
      />
    </figure>
  )}

  <div
    aria-label="Documentation sections"
    class={tocTablistClass}
    role="tablist"
    slot="toc-actions"
  >
    {tabs.map((tab) => (
      <a
        aria-controls={`doc-panel-${tab.id}`}
        aria-selected={tab.id === activeTab ? "true" : "false"}
        class={tocTabLinkClass}
        data-active={tab.id === activeTab ? "" : undefined}
        href={tabHref(tab.id)}
        id={`doc-tab-${tab.id}`}
        role="tab"
      >
        {tab.label}
      </a>
    ))}
  </div>

  <div class="mb-8 xl:hidden" slot="nav">
    <div
      aria-label="Documentation sections"
      class={tablistClass}
      role="tablist"
    >
      {tabs.map((tab) => (
        <a
          aria-controls={`doc-panel-${tab.id}`}
          aria-selected={tab.id === activeTab ? "true" : "false"}
          class={tabLinkClass}
          data-active={tab.id === activeTab ? "" : undefined}
          href={tabHref(tab.id)}
          role="tab"
        >
          {tab.label}
        </a>
      ))}
    </div>
  </div>

  <ComponentHeader
    aliases={docs.aliases}
    api={docs.api}
    framework={framework}
    packageName={pkg}
    slot="title-actions"
    taxonomy={docs.taxonomy}
  />

  <div>
    {activeTab === "develop" ? (
      <div
        aria-labelledby="doc-tab-develop"
        id="doc-panel-develop"
        role="tabpanel"
      >
        <div class={proseClass}>
          <PaneContent components={mdxComponents} />
        </div>

        {framework !== "astro" && exampleExportNames.length > 0 ? (
          <div
            data-component-id={id}
            data-docs-examples-host
            data-export-names={JSON.stringify(exampleExportNames)}
            data-kind="component"
            hidden
          />
        ) : null}

        <div class="mt-10">
          <h2 class="mb-3 font-semibold text-2xl tracking-tight" id="props">
            Props
          </h2>
          {propsRows ? (
            <PropsTable rows={propsRows} />
          ) : (
            <p class="text-muted-foreground text-sm">
              This utility has no dedicated entries in{" "}
              <code>@pisagor/contracts</code> yet.
            </p>
          )}
        </div>
      </div>
    ) : (
      <div
        aria-labelledby="doc-tab-design"
        class:list={[proseClass, "[&>h2:first-child]:!mt-0"]}
        id="doc-panel-design"
        role="tabpanel"
      >
        <PaneContent components={mdxComponents} />
      </div>
    )}
  </div>
</DocsLayout>
