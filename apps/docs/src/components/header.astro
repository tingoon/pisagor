---
import { Pi } from "@phosphor-icons/react";
import type { DocsArea, Framework, NavSection } from "../lib/nav";
import { frameworkPath } from "../lib/nav";
import FrameworkSwitcher from "./docs/framework-switcher";
import MainNav from "./docs/main-nav.astro";
import MobileNav from "./docs/mobile-nav";
import ThemeToggle from "./docs/theme-toggle";

interface Props {
  framework: Framework;
  area: DocsArea;
  currentPath: string;
  sections: NavSection[];
}
---

<header class="docs-material docs-scroll-edge-b sticky top-0 z-40">
  <div
    class="relative mx-auto flex h-14 max-w-384 items-center gap-3 px-4 sm:px-6"
  >
    <MobileNav
      currentPath={Astro.props.currentPath}
      framework={Astro.props.framework}
      sections={Astro.props.sections}
      client:load
    />
    <a
      class="docs-press group flex items-center gap-2.5 font-semibold tracking-tight"
      href={frameworkPath(Astro.props.framework)}
    >
      <span
        class="inline-flex size-8 items-center justify-center rounded-xl bg-primary text-primary-foreground shadow-[0_0_24px_-6px] shadow-primary/40 transition duration-100 group-hover:scale-[1.03] group-active:scale-[0.97]"
      >
        <Pi aria-hidden size={18} weight="bold" />
      </span>
      <span class="hidden sm:inline">Pisagor</span>
    </a>

    <MainNav area={Astro.props.area} framework={Astro.props.framework} />

    <div class="ms-auto flex items-center gap-2">
      <FrameworkSwitcher
        framework={Astro.props.framework}
        pathname={Astro.props.currentPath}
        client:load
      />
      <ThemeToggle client:load />
    </div>
  </div>
</header>
