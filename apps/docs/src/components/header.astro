---
import { PiIcon } from "@phosphor-icons/react";
import type { DocsArea, Framework, NavSection } from "#/lib/nav";
import { withDocsBase } from "#/lib/nav";
import DocsSearch from "./docs/docs-search.astro";
import FrameworkSwitcher from "./docs/framework-switcher.astro";
import MainNav from "./docs/main-nav.astro";
import MobileNav from "./docs/mobile-nav.astro";
import ThemeToggle from "./docs/theme-toggle.astro";

interface Props {
  framework: Framework;
  area: DocsArea;
  currentPath: string;
  sections: NavSection[];
}
---

<header class="sticky top-0 z-40 border-border/60 border-b bg-background">
  <div
    class="relative mx-auto flex h-12 w-full max-w-6xl items-center gap-2 px-4 sm:gap-3 sm:px-5"
  >
    <MobileNav
      currentPath={Astro.props.currentPath}
      framework={Astro.props.framework}
      sections={Astro.props.sections}
    />
    <a
      aria-label="Pisagor home"
      class="docs-press group flex items-center gap-2.5 font-semibold tracking-tight"
      href={withDocsBase("/")}
    >
      <span
        class="inline-flex size-7 items-center justify-center rounded-lg bg-primary text-primary-foreground transition duration-100 group-hover:scale-[1.03] group-active:scale-[0.97]"
      >
        <PiIcon aria-hidden size={16} weight="bold" />
      </span>
      <span class="hidden sm:inline">Pisagor</span>
    </a>

    <MainNav area={Astro.props.area} framework={Astro.props.framework} />

    <div class="ms-auto flex items-center gap-1.5 sm:gap-2">
      <DocsSearch framework={Astro.props.framework} />
      <FrameworkSwitcher
        framework={Astro.props.framework}
        pathname={Astro.props.currentPath}
      />
      <ThemeToggle />
    </div>
  </div>
</header>
