---
import Installation from "#/components/docs/installation.astro";
import PackageLinks from "#/components/docs/package-links.astro";
import DocsLayout from "#/layouts/docs-layout.astro";
import { withDocsBase } from "#/lib/nav";

const headings = [
  { depth: 2, slug: "overview", text: "Overview" },
  { depth: 2, slug: "install", text: "Install" },
];
const tanstackHref = withDocsBase("/react/forms/tanstack");
---

<DocsLayout
  description="Labeled form fields with validation, built on Pisagor primitives."
  framework="react"
  headings={headings}
  kicker="Get started"
  title="Introduction"
>
  <PackageLinks
    framework="react"
    packageName="@pisagor/react-form"
    slot="title-actions"
  />
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">
    Overview
  </h2>
  <p class="mb-6 text-muted-foreground">
    <code class="rounded bg-muted px-1.5 py-0.5 text-sm"
      >@pisagor/react-form</code
    >
    provides labeled field compositions with descriptions and error messages on
    top of
    <code class="rounded bg-muted px-1.5 py-0.5 text-sm">@pisagor/react</code>
    primitives. Browse a field for when to use it. For validated forms, see
    <a class="text-foreground underline underline-offset-2" href={tanstackHref}
      >TanStack Form</a
    >. Control usage lives on the underlying components.
  </p>

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="install">
    Install
  </h2>
  <Installation class="mb-6" packages="@pisagor/react-form" />
</DocsLayout>
