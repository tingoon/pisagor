---
import Changelog from "#/components/docs/changelog.astro";
import DocsLayout from "#/layouts/docs-layout.astro";
import { Content, getHeadings } from "#/react-form/CHANGELOG.md";

const headings = getHeadings().filter((heading) => heading.depth === 2);
---

<DocsLayout
  description="Release notes for @pisagor/react-form."
  framework="react"
  headings={headings}
  kicker="Get started"
  title="Changelog"
>
  <Changelog Content={Content} />
</DocsLayout>
