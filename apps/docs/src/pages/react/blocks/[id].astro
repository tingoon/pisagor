---
import BlockDocPage from "#/components/docs/block-doc-page.astro";
import { ReactExamplesHost } from "#/components/docs/react/examples-host";
import { listBlockStaticPaths } from "#/lib/block-doc";

export async function getStaticPaths() {
  return listBlockStaticPaths("react");
}

const id = Astro.params.id as string;
---

<BlockDocPage framework="react" id={id} />
<ReactExamplesHost client:only="react" />
