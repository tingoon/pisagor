---
import BlockDocPage from "#/components/docs/block-doc-page.astro";
import { ReactBlockExamplesHost } from "#/components/docs/react-block-examples-host";
import { listBlockStaticPaths } from "#/lib/block-doc";

export function getStaticPaths() {
  return listBlockStaticPaths("react");
}

const id = Astro.params.id as string;
---

<BlockDocPage framework="react" id={id} />
<ReactBlockExamplesHost client:only="react" />
