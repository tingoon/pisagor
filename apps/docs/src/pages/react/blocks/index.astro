---
import Installation from "#/components/docs/installation.astro";
import PackageLinks from "#/components/docs/package-links.astro";
import DocsLayout from "#/layouts/docs-layout.astro";
import { withDocsBase } from "#/lib/nav";

const headings = [
  { depth: 2, slug: "overview", text: "Overview" },
  { depth: 2, slug: "install", text: "Install" },
  { depth: 2, slug: "blocks", text: "Blocks" },
];
---

<DocsLayout
  description="Source and composition demos built from Pisagor primitives. Styles come from @pisagor/recipes."
  framework="react"
  headings={headings}
  kicker="Get started"
  title="Introduction"
>
  <PackageLinks framework="react" packageName="@pisagor/recipes" />
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">
    Overview
  </h2>
  <p class="mb-6 text-muted-foreground">
    Blocks are copy-ready source and composition demos built from Pisagor
    primitives. Visual styles still come from{" "}
    <code class="rounded bg-muted px-1.5 py-0.5 text-sm">@pisagor/recipes</code>
    {" "}(shared
    <code class="rounded bg-muted px-1.5 py-0.5 text-sm">tv()</code>
    recipes) — these pages show how to assemble components, not a separate style
    package. Every Storybook block example is mirrored here; pages can include
    multiple examples, each under its own title.
  </p>

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="install">
    Install
  </h2>
  <Installation class="mb-8" packages="@pisagor/recipes" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="blocks">Blocks</h2>
  <ul class="list-disc space-y-3 ps-5 text-muted-foreground">
    <li>
      <a
        class="text-foreground underline-offset-4 hover:underline"
        href={withDocsBase("/react/blocks/app-shell")}
        >App Shell</a
      >{" "}
      — Standard application shell with top navigation, icon rail, side panel,
      main content, and inspector regions ready for menus and page content.
    </li>
    <li>
      <a
        class="text-foreground underline-offset-4 hover:underline"
        href={withDocsBase("/react/blocks/card")}
        >Card</a
      >{" "}
      — Card compositions for login flows, custom spacing, and product display.
    </li>
    <li>
      <a
        class="text-foreground underline-offset-4 hover:underline"
        href={withDocsBase("/react/blocks/editors")}
        >Editors</a
      >{" "}
      — Editor compositions for IDE layouts, rich text toolbars, and editable
      user cards.
    </li>
    <li>
      <a
        class="text-foreground underline-offset-4 hover:underline"
        href={withDocsBase("/react/blocks/field")}
        >Field</a
      >{" "}
      — Field layout compositions for grids, sections, labels, and settings
      rows.
    </li>
    <li>
      <a
        class="text-foreground underline-offset-4 hover:underline"
        href={withDocsBase("/react/blocks/input-group")}
        >Input Group</a
      >{" "}
      — Input group compositions for code editing, menus, inline actions,
      labels, number inputs, and tooltips.
    </li>
    <li>
      <a
        class="text-foreground underline-offset-4 hover:underline"
        href={withDocsBase("/react/blocks/overlay")}
        >Overlay</a
      >{" "}
      — Overlay compositions for menus, dialogs, popovers, item pickers, and
      avatar overflow.
    </li>
    <li>
      <a
        class="text-foreground underline-offset-4 hover:underline"
        href={withDocsBase("/react/blocks/password")}
        >Password Input</a
      >{" "}
      — Compose PasswordInput with live strength feedback, a segmented progress
      bar, and a requirement checklist for password creation flows.
    </li>
    <li>
      <a
        class="text-foreground underline-offset-4 hover:underline"
        href={withDocsBase("/react/blocks/search-field")}
        >Search Field</a
      >{" "}
      — Search input compositions with button group and inline field layouts.
    </li>
    <li>
      <a
        class="text-foreground underline-offset-4 hover:underline"
        href={withDocsBase("/react/blocks/sign-in-form")}
        >Sign In</a
      >{" "}
      — Complete sign-in flow with email, password, validation, and remember-me
      checkbox using form fields.
    </li>
    <li>
      <a
        class="text-foreground underline-offset-4 hover:underline"
        href={withDocsBase("/react/blocks/table")}
        >Table</a
      >{" "}
      — Table compositions with bulk actions, row menus, and pagination
      controls.
    </li>
    <li>
      <a
        class="text-foreground underline-offset-4 hover:underline"
        href={withDocsBase("/react/blocks/tags-input")}
        >Tags Input</a
      >{" "}
      — Tags input paired with a combobox for searchable tag selection and
      custom value entry.
    </li>
  </ul>
</DocsLayout>
