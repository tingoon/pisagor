---
import ComponentPreview from "#/components/docs/component-preview.astro";
import DocsLayout from "#/layouts/docs-layout.astro";
import { AvatarGroupOverflow } from "#/react/blocks/overlay/avatar-group-overflow";
import AvatarGroupOverflowSource from "#/react/blocks/overlay/avatar-group-overflow.tsx?raw";
import { ItemPicker } from "#/react/blocks/overlay/item-picker";
import ItemPickerSource from "#/react/blocks/overlay/item-picker.tsx?raw";
import { MenuDialog } from "#/react/blocks/overlay/menu-dialog";
import MenuDialogSource from "#/react/blocks/overlay/menu-dialog.tsx?raw";
import { PopoverDialog } from "#/react/blocks/overlay/popover-dialog";
import PopoverDialogSource from "#/react/blocks/overlay/popover-dialog.tsx?raw";

const headings = [
  {
    depth: 2,
    slug: "overview",
    text: "Overview",
  },
  {
    depth: 2,
    slug: "menu-dialog",
    text: "Menu Dialog",
  },
  {
    depth: 2,
    slug: "popover-dialog",
    text: "Popover Dialog",
  },
  {
    depth: 2,
    slug: "item-picker",
    text: "Item Picker",
  },
  {
    depth: 2,
    slug: "avatar-group-overflow",
    text: "Avatar Group Overflow",
  },
];
---

<DocsLayout
  description="Overlay compositions for menus, dialogs, popovers, item pickers, and avatar overflow."
  framework="react"
  headings={headings}
  title="Overlay"
>
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">
    Overview
  </h2>
  <p class="mb-8 text-muted-foreground">
    Overlay compositions for menus, dialogs, popovers, item pickers, and avatar
    overflow.
  </p>

  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="menu-dialog">
    Menu Dialog
  </h2>
  <ComponentPreview code={MenuDialogSource} language="tsx" title="Menu Dialog">
    <MenuDialog client:only="react" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="popover-dialog"
  >
    Popover Dialog
  </h2>
  <ComponentPreview
    code={PopoverDialogSource}
    language="tsx"
    title="Popover Dialog"
  >
    <PopoverDialog client:only="react" />
  </ComponentPreview>
  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="item-picker">
    Item Picker
  </h2>
  <ComponentPreview code={ItemPickerSource} language="tsx" title="Item Picker">
    <ItemPicker client:only="react" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="avatar-group-overflow"
  >
    Avatar Group Overflow
  </h2>
  <ComponentPreview
    code={AvatarGroupOverflowSource}
    language="tsx"
    title="Avatar Group Overflow"
  >
    <AvatarGroupOverflow client:only="react" />
  </ComponentPreview>
</DocsLayout>
