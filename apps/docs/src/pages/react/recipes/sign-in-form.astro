---
import { SignInForm } from "@recipes-react/sign-in-form/sign-in-form";
import SignInFormSource from "@recipes-react/sign-in-form/sign-in-form.tsx?raw";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";

const headings = [
  {
    depth: 2,
    slug: "overview",
    text: "Overview",
  },
  {
    depth: 2,
    slug: "sign-in-form",
    text: "Sign In Form",
  },
];
---

<DocsLayout
  description="Complete sign-in flow with email, password, validation, and remember-me checkbox using form fields."
  framework="react"
  headings={headings}
  title="Sign In"
>
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">
    Overview
  </h2>
  <p class="mb-8 text-muted-foreground">
    Complete sign-in flow with email, password, validation, and remember-me
    checkbox using form fields.
  </p>

  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="sign-in-form"
  >
    Sign In Form
  </h2>
  <ComponentPreview code={SignInFormSource} language="tsx" title="Sign In Form">
    <SignInForm client:only="react" />
  </ComponentPreview>
</DocsLayout>
