---
import DocsLayout from "../../../layouts/docs-layout.astro";

const headings = [
  { depth: 2, slug: "overview", text: "Overview" },
  { depth: 2, slug: "recipes", text: "Recipes" },
];

export { DocsLayout, headings };

import { withDocsBase } from "../../../lib/nav";
---

<DocsLayout
  description="Composable UI recipes with live examples. Each page can include multiple examples."
  framework="react"
  headings={headings}
  title="Recipes"
>

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">Overview</h2>
  <p class="mb-8 text-muted-foreground">
    Recipes are opinionated compositions built from Pisagor primitives. Every Storybook recipe
    example is mirrored here — pages can include multiple examples, each under its own title.
  </p>

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="recipes">Recipes</h2>
  <ul class="list-disc space-y-3 ps-5 text-muted-foreground">
    <li><a class="text-foreground underline-offset-4 hover:underline" href={withDocsBase("/react/recipes/app-shell")}>App Shell</a> — Standard application shell with top navigation, icon rail, side panel, main content, and inspector regions ready for menus and page content.</li>
    <li><a class="text-foreground underline-offset-4 hover:underline" href={withDocsBase("/react/recipes/card")}>Card</a> — Card compositions for login flows, custom spacing, and product display.</li>
    <li><a class="text-foreground underline-offset-4 hover:underline" href={withDocsBase("/react/recipes/editors")}>Editors</a> — Editor compositions for IDE layouts, rich text toolbars, and editable user cards.</li>
    <li><a class="text-foreground underline-offset-4 hover:underline" href={withDocsBase("/react/recipes/field")}>Field</a> — Field layout compositions for grids, sections, labels, and settings rows.</li>
    <li><a class="text-foreground underline-offset-4 hover:underline" href={withDocsBase("/react/recipes/input-group")}>Input Group</a> — Input group compositions for code editing, menus, inline actions, labels, number inputs, and tooltips.</li>
    <li><a class="text-foreground underline-offset-4 hover:underline" href={withDocsBase("/react/recipes/overlay")}>Overlay</a> — Overlay compositions for menus, dialogs, popovers, item pickers, and avatar overflow.</li>
    <li><a class="text-foreground underline-offset-4 hover:underline" href={withDocsBase("/react/recipes/password")}>Password Input</a> — Compose PasswordInput with live strength feedback, a segmented progress bar, and a requirement checklist for password creation flows.</li>
    <li><a class="text-foreground underline-offset-4 hover:underline" href={withDocsBase("/react/recipes/search-field")}>Search Field</a> — Search input compositions with button group and inline field layouts.</li>
    <li><a class="text-foreground underline-offset-4 hover:underline" href={withDocsBase("/react/recipes/sign-in-form")}>Sign In</a> — Complete sign-in flow with email, password, validation, and remember-me checkbox using form fields.</li>
    <li><a class="text-foreground underline-offset-4 hover:underline" href={withDocsBase("/react/recipes/table")}>Table</a> — Table compositions with bulk actions, row menus, and pagination controls.</li>
    <li><a class="text-foreground underline-offset-4 hover:underline" href={withDocsBase("/react/recipes/tags-input")}>Tags Input</a> — Tags input paired with a combobox for searchable tag selection and custom value entry.</li>
  </ul>
</DocsLayout>
