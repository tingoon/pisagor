---
import DocsLayout from "../../../layouts/docs-layout.astro";
import { withDocsBase } from "../../../lib/nav";

const headings = [{ depth: 2, slug: "overview", text: "Overview" }];
---

<DocsLayout
  description="Chart components for dashboards and data visualization."
  framework="react"
  headings={headings}
  title="Charts"
>

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">Overview</h2>
  <p class="mb-6 text-muted-foreground">
    Charts build on Pisagor styling with framework-specific data bindings. Browse the sidebar for
    available chart docs.
  </p>
  <p class="text-muted-foreground">
    Start with
    <a class="text-foreground underline-offset-4 hover:underline" href={withDocsBase("/react/charts/chart")}>Chart</a>.
  </p>
</DocsLayout>
