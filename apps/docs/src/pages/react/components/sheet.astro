---
import {
  CloseBehavior,
  CustomSpacing,
  Default,
  sources as examples,
  Inset,
  imports,
  NoCloseButton,
  NonModal,
  ScrollArea,
  Sides,
} from "@pisagor/react/sheet/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { sheetProps } from "../../../lib/props/sheet";

export const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 3, slug: "custom-spacing", text: "Custom Spacing" },
  { depth: 3, slug: "inset", text: "Inset" },
  { depth: 3, slug: "no-close-button", text: "No Close Button" },
  { depth: 3, slug: "non-modal", text: "Non Modal" },
  { depth: 3, slug: "scroll-area", text: "Scroll Area" },
  { depth: 3, slug: "sides", text: "Sides" },
  { depth: 3, slug: "close-behavior", text: "Close Behavior" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];

export {
  CloseBehavior,
  CodeBlock,
  ComponentHeader,
  ComponentPreview,
  CustomSpacing,
  Default,
  DocsLayout,
  examples,
  Inset,
  Installation,
  imports,
  NoCloseButton,
  NonModal,
  PropsTable,
  ScrollArea,
  Sides,
  sheetProps,
};
---

<DocsLayout
  description="Slides a panel in from the edge of the screen for secondary tasks on mobile and desktop."
  framework="react"
  headings={headings}
  title="Sheet"
>

  <ComponentHeader framework="react" id="sheet" />


  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="tsx" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">Default</h3>
  <ComponentPreview code={examples.Default} language="tsx" title="Default">
    <Default client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="custom-spacing">Custom Spacing</h3>
  <ComponentPreview code={examples.CustomSpacing} language="tsx" title="Custom Spacing">
    <CustomSpacing client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="inset">Inset</h3>
  <ComponentPreview code={examples.Inset} language="tsx" title="Inset">
    <Inset client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="no-close-button">No Close Button</h3>
  <ComponentPreview code={examples.NoCloseButton} language="tsx" title="No Close Button">
    <NoCloseButton client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="non-modal">Non Modal</h3>
  <ComponentPreview code={examples.NonModal} language="tsx" title="Non Modal">
    <NonModal client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="scroll-area">Scroll Area</h3>
  <ComponentPreview code={examples.ScrollArea} language="tsx" title="Scroll Area">
    <ScrollArea client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="sides">Sides</h3>
  <ComponentPreview code={examples.Sides} language="tsx" title="Sides">
    <Sides client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="close-behavior">Close Behavior</h3>
  <ComponentPreview code={examples.CloseBehavior} language="tsx" title="Close Behavior">
    <CloseBehavior client:only="react" />
  </ComponentPreview>

  <h2 class="mb-3 mt-12 text-2xl font-semibold tracking-tight" id="installation">Installation</h2>
  <Installation class="mb-8" packages="@pisagor/react" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/sheet</code>. Native HTML attributes are also supported and omitted from this table.
  </p>
  <PropsTable rows={sheetProps} />
</DocsLayout>
