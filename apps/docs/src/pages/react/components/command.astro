---
import {
  Default,
  sources as examples,
  Groups,
  imports,
  Scrollable,
  Shortcuts,
  WithDialog,
  WithFooter,
} from "@pisagor/react/command/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { commandProps } from "../../../lib/props/command";

export const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "scrollable", text: "Scrollable" },
  { depth: 3, slug: "shortcuts", text: "Shortcuts" },
  { depth: 3, slug: "with-dialog", text: "With Dialog" },
  { depth: 3, slug: "groups", text: "Groups" },
  { depth: 3, slug: "with-footer", text: "With Footer" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];

export {
  CodeBlock,
  ComponentHeader,
  ComponentPreview,
  commandProps,
  Default,
  DocsLayout,
  examples,
  Groups,
  Installation,
  imports,
  PropsTable,
  Scrollable,
  Shortcuts,
  WithDialog,
  WithFooter,
};
---

<DocsLayout
  description="Offers a searchable command palette for jumping to actions, pages, or settings from the keyboard."
  framework="react"
  headings={headings}
  title="Command"
>

  <ComponentHeader framework="react" id="command" />


  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="tsx" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="scrollable">Scrollable</h3>
  <ComponentPreview code={examples.Scrollable} language="tsx" title="Scrollable">
    <Scrollable client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="shortcuts">Shortcuts</h3>
  <ComponentPreview code={examples.Shortcuts} language="tsx" title="Shortcuts">
    <Shortcuts client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="with-dialog">With Dialog</h3>
  <ComponentPreview code={examples.WithDialog} language="tsx" title="With Dialog">
    <WithDialog client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="groups">Groups</h3>
  <ComponentPreview code={examples.Groups} language="tsx" title="Groups">
    <Groups client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="with-footer">With Footer</h3>
  <ComponentPreview code={examples.WithFooter} language="tsx" title="With Footer">
    <WithFooter client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">Default</h3>
  <ComponentPreview code={examples.Default} language="tsx" title="Default">
    <Default client:only="react" />
  </ComponentPreview>

  <h2 class="mb-3 mt-12 text-2xl font-semibold tracking-tight" id="installation">Installation</h2>
  <Installation class="mb-8" packages="@pisagor/react" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/command</code>. Native HTML attributes are also supported and omitted from this table.
  </p>
  <PropsTable rows={commandProps} />
</DocsLayout>
