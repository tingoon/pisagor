---
import {
  AutocompleteField,
  CheckboxField,
  CheckboxGroupField,
  ComboboxField,
  ComboboxMultipleField,
  Default,
  DisabledField,
  sources as examples,
  FieldGroup,
  imports,
  NumberInputStory,
  OrientationHorizontal,
  OrientationVertical,
  RadioGroupField,
  RequiredField,
  SelectField,
  SliderField,
  SwitchField,
  TextareaField,
  WithError,
  WithInputGroup,
} from "@pisagor/react/field/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { fieldProps } from "../../../lib/props/field";

export const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 3, slug: "orientation-horizontal", text: "Orientation Horizontal" },
  { depth: 3, slug: "orientation-vertical", text: "Orientation Vertical" },
  { depth: 3, slug: "autocomplete-field", text: "Autocomplete Field" },
  { depth: 3, slug: "checkbox-field", text: "Checkbox Field" },
  { depth: 3, slug: "checkbox-group-field", text: "Checkbox Group Field" },
  { depth: 3, slug: "combobox-field", text: "Combobox Field" },
  { depth: 3, slug: "combobox-multiple-field", text: "Combobox Multiple Field" },
  { depth: 3, slug: "disabled-field", text: "Disabled Field" },
  { depth: 3, slug: "field-group", text: "Field Group" },
  { depth: 3, slug: "with-input-group", text: "With Input Group" },
  { depth: 3, slug: "number-input-story", text: "Number Input Story" },
  { depth: 3, slug: "radio-group-field", text: "Radio Group Field" },
  { depth: 3, slug: "required-field", text: "Required Field" },
  { depth: 3, slug: "select-field", text: "Select Field" },
  { depth: 3, slug: "slider-field", text: "Slider Field" },
  { depth: 3, slug: "switch-field", text: "Switch Field" },
  { depth: 3, slug: "textarea-field", text: "Textarea Field" },
  { depth: 3, slug: "with-error", text: "With Error" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];

export {
  AutocompleteField,
  CheckboxField,
  CheckboxGroupField,
  CodeBlock,
  ComboboxField,
  ComboboxMultipleField,
  ComponentHeader,
  ComponentPreview,
  Default,
  DisabledField,
  DocsLayout,
  examples,
  FieldGroup,
  fieldProps,
  Installation,
  imports,
  NumberInputStory,
  OrientationHorizontal,
  OrientationVertical,
  PropsTable,
  RadioGroupField,
  RequiredField,
  SelectField,
  SliderField,
  SwitchField,
  TextareaField,
  WithError,
  WithInputGroup,
};
---

<DocsLayout
  description="Wraps a form control with label, description, and error text so inputs are easier to understand and fix."
  framework="react"
  headings={headings}
  title="Field"
>

  <ComponentHeader framework="react" id="field" />


  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="tsx" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">Default</h3>
  <ComponentPreview code={examples.Default} language="tsx" title="Default">
    <Default client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="orientation-horizontal">Orientation Horizontal</h3>
  <ComponentPreview code={examples.OrientationHorizontal} language="tsx" title="Orientation Horizontal">
    <OrientationHorizontal client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="orientation-vertical">Orientation Vertical</h3>
  <ComponentPreview code={examples.OrientationVertical} language="tsx" title="Orientation Vertical">
    <OrientationVertical client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="autocomplete-field">Autocomplete Field</h3>
  <ComponentPreview code={examples.AutocompleteField} language="tsx" title="Autocomplete Field">
    <AutocompleteField client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="checkbox-field">Checkbox Field</h3>
  <ComponentPreview code={examples.CheckboxField} language="tsx" title="Checkbox Field">
    <CheckboxField client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="checkbox-group-field">Checkbox Group Field</h3>
  <ComponentPreview code={examples.CheckboxGroupField} language="tsx" title="Checkbox Group Field">
    <CheckboxGroupField client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="combobox-field">Combobox Field</h3>
  <ComponentPreview code={examples.ComboboxField} language="tsx" title="Combobox Field">
    <ComboboxField client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="combobox-multiple-field">Combobox Multiple Field</h3>
  <ComponentPreview code={examples.ComboboxMultipleField} language="tsx" title="Combobox Multiple Field">
    <ComboboxMultipleField client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="disabled-field">Disabled Field</h3>
  <ComponentPreview code={examples.DisabledField} language="tsx" title="Disabled Field">
    <DisabledField client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="field-group">Field Group</h3>
  <ComponentPreview code={examples.FieldGroup} language="tsx" title="Field Group">
    <FieldGroup client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="with-input-group">With Input Group</h3>
  <ComponentPreview code={examples.WithInputGroup} language="tsx" title="With Input Group">
    <WithInputGroup client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="number-input-story">Number Input Story</h3>
  <ComponentPreview code={examples.NumberInputStory} language="tsx" title="Number Input Story">
    <NumberInputStory client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="radio-group-field">Radio Group Field</h3>
  <ComponentPreview code={examples.RadioGroupField} language="tsx" title="Radio Group Field">
    <RadioGroupField client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="required-field">Required Field</h3>
  <ComponentPreview code={examples.RequiredField} language="tsx" title="Required Field">
    <RequiredField client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="select-field">Select Field</h3>
  <ComponentPreview code={examples.SelectField} language="tsx" title="Select Field">
    <SelectField client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="slider-field">Slider Field</h3>
  <ComponentPreview code={examples.SliderField} language="tsx" title="Slider Field">
    <SliderField client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="switch-field">Switch Field</h3>
  <ComponentPreview code={examples.SwitchField} language="tsx" title="Switch Field">
    <SwitchField client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="textarea-field">Textarea Field</h3>
  <ComponentPreview code={examples.TextareaField} language="tsx" title="Textarea Field">
    <TextareaField client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="with-error">With Error</h3>
  <ComponentPreview code={examples.WithError} language="tsx" title="With Error">
    <WithError client:only="react" />
  </ComponentPreview>

  <h2 class="mb-3 mt-12 text-2xl font-semibold tracking-tight" id="installation">Installation</h2>
  <Installation class="mb-8" packages="@pisagor/react" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/field</code>. Native HTML attributes are also supported and omitted from this table.
  </p>
  <PropsTable rows={fieldProps} />
</DocsLayout>
