---
import {
  Controlled,
  Countdown,
  CountdownDate,
  CustomSeparator,
  Default,
  sources as examples,
  Interval,
  imports,
  OrientationHorizontal,
  OrientationVertical,
  Pomodoro,
} from "@pisagor/react/timer/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { timerProps } from "../../../lib/props/timer";

const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 3, slug: "orientation-horizontal", text: "Orientation Horizontal" },
  { depth: 3, slug: "orientation-vertical", text: "Orientation Vertical" },
  { depth: 3, slug: "countdown-date", text: "Countdown Date" },
  { depth: 3, slug: "countdown", text: "Countdown" },
  { depth: 3, slug: "custom-separator", text: "Custom Separator" },
  { depth: 3, slug: "interval", text: "Interval" },
  { depth: 3, slug: "pomodoro", text: "Pomodoro" },
  { depth: 3, slug: "controlled", text: "Controlled" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];
---

<DocsLayout
  description="Counts up or down through intervals so users can track elapsed time or remaining time."
  framework="react"
  headings={headings}
  title="Timer"
>
  <ComponentHeader framework="react" id="timer" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="tsx" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">
    Default
  </h3>
  <ComponentPreview code={examples.Default} language="tsx" title="Default">
    <Default client:only="react" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="orientation-horizontal"
  >
    Orientation Horizontal
  </h3>
  <ComponentPreview
    code={examples.OrientationHorizontal}
    language="tsx"
    title="Orientation Horizontal"
  >
    <OrientationHorizontal client:only="react" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="orientation-vertical"
  >
    Orientation Vertical
  </h3>
  <ComponentPreview
    code={examples.OrientationVertical}
    language="tsx"
    title="Orientation Vertical"
  >
    <OrientationVertical client:only="react" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="countdown-date"
  >
    Countdown Date
  </h3>
  <ComponentPreview
    code={examples.CountdownDate}
    language="tsx"
    title="Countdown Date"
  >
    <CountdownDate client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="countdown">
    Countdown
  </h3>
  <ComponentPreview code={examples.Countdown} language="tsx" title="Countdown">
    <Countdown client:only="react" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="custom-separator"
  >
    Custom Separator
  </h3>
  <ComponentPreview
    code={examples.CustomSeparator}
    language="tsx"
    title="Custom Separator"
  >
    <CustomSeparator client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="interval">
    Interval
  </h3>
  <ComponentPreview code={examples.Interval} language="tsx" title="Interval">
    <Interval client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="pomodoro">
    Pomodoro
  </h3>
  <ComponentPreview code={examples.Pomodoro} language="tsx" title="Pomodoro">
    <Pomodoro client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="controlled">
    Controlled
  </h3>
  <ComponentPreview
    code={examples.Controlled}
    language="tsx"
    title="Controlled"
  >
    <Controlled client:only="react" />
  </ComponentPreview>

  <h2
    class="mb-3 mt-12 text-2xl font-semibold tracking-tight"
    id="installation"
  >
    Installation
  </h2>
  <Installation class="mb-8" packages="@pisagor/react" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/timer</code>. Native HTML attributes are
    also supported and omitted from this table.
  </p>
  <PropsTable rows={timerProps} />
</DocsLayout>
