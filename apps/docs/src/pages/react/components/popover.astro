---
import {
  Anchor,
  CloseBehavior,
  CloseButton,
  CustomSpacing,
  Default,
  sources as examples,
  imports,
  Modal,
  Nested,
  Placements,
  ScrollArea,
} from "@pisagor/react/popover/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { popoverProps } from "../../../lib/props/popover";

export const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 3, slug: "custom-spacing", text: "Custom Spacing" },
  { depth: 3, slug: "anchor", text: "Anchor" },
  { depth: 3, slug: "close-button", text: "Close Button" },
  { depth: 3, slug: "nested", text: "Nested" },
  { depth: 3, slug: "modal", text: "Modal" },
  { depth: 3, slug: "scroll-area", text: "Scroll Area" },
  { depth: 3, slug: "close-behavior", text: "Close Behavior" },
  { depth: 3, slug: "placements", text: "Placements" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];

export {
  Anchor,
  CloseBehavior,
  CloseButton,
  CodeBlock,
  ComponentHeader,
  ComponentPreview,
  CustomSpacing,
  Default,
  DocsLayout,
  examples,
  Installation,
  imports,
  Modal,
  Nested,
  Placements,
  PropsTable,
  popoverProps,
  ScrollArea,
};
---

<DocsLayout
  description="Anchors extra content to a trigger for compact forms, menus, or details without a full modal."
  framework="react"
  headings={headings}
  title="Popover"
>

  <ComponentHeader framework="react" id="popover" />


  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="tsx" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">Default</h3>
  <ComponentPreview code={examples.Default} language="tsx" title="Default">
    <Default client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="custom-spacing">Custom Spacing</h3>
  <ComponentPreview code={examples.CustomSpacing} language="tsx" title="Custom Spacing">
    <CustomSpacing client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="anchor">Anchor</h3>
  <ComponentPreview code={examples.Anchor} language="tsx" title="Anchor">
    <Anchor client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="close-button">Close Button</h3>
  <ComponentPreview code={examples.CloseButton} language="tsx" title="Close Button">
    <CloseButton client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="nested">Nested</h3>
  <ComponentPreview code={examples.Nested} language="tsx" title="Nested">
    <Nested client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="modal">Modal</h3>
  <ComponentPreview code={examples.Modal} language="tsx" title="Modal">
    <Modal client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="scroll-area">Scroll Area</h3>
  <ComponentPreview code={examples.ScrollArea} language="tsx" title="Scroll Area">
    <ScrollArea client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="close-behavior">Close Behavior</h3>
  <ComponentPreview code={examples.CloseBehavior} language="tsx" title="Close Behavior">
    <CloseBehavior client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="placements">Placements</h3>
  <ComponentPreview code={examples.Placements} language="tsx" title="Placements">
    <Placements client:only="react" />
  </ComponentPreview>

  <h2 class="mb-3 mt-12 text-2xl font-semibold tracking-tight" id="installation">Installation</h2>
  <Installation class="mb-8" packages="@pisagor/react" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/popover</code>. Native HTML attributes are also supported and omitted from this table.
  </p>
  <PropsTable rows={popoverProps} />
</DocsLayout>
