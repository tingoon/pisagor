---
import {
  CloseTrigger,
  Controlled,
  CustomSpacing,
  Default,
  sources as examples,
  Gutter,
  imports,
  Placements,
  WithDialog,
  WithMenu,
} from "@pisagor/react/action-bar/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { actionBarProps } from "../../../lib/props/action-bar";

export const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 3, slug: "custom-spacing", text: "Custom Spacing" },
  { depth: 3, slug: "gutter", text: "Gutter" },
  { depth: 3, slug: "close-trigger", text: "Close Trigger" },
  { depth: 3, slug: "with-dialog", text: "With Dialog" },
  { depth: 3, slug: "with-menu", text: "With Menu" },
  { depth: 3, slug: "controlled", text: "Controlled" },
  { depth: 3, slug: "placements", text: "Placements" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];

export {
  actionBarProps,
  CloseTrigger,
  CodeBlock,
  ComponentHeader,
  ComponentPreview,
  Controlled,
  CustomSpacing,
  Default,
  DocsLayout,
  examples,
  Gutter,
  Installation,
  imports,
  Placements,
  PropsTable,
  WithDialog,
  WithMenu,
};
---

<DocsLayout
  description="Surfaces bulk actions when one or more items are selected, keeping primary tools close without cluttering the page."
  framework="react"
  headings={headings}
  title="Action Bar"
>

  <ComponentHeader framework="react" id="action-bar" />


  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="tsx" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">Default</h3>
  <ComponentPreview code={examples.Default} language="tsx" title="Default">
    <Default client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="custom-spacing">Custom Spacing</h3>
  <ComponentPreview code={examples.CustomSpacing} language="tsx" title="Custom Spacing">
    <CustomSpacing client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="gutter">Gutter</h3>
  <ComponentPreview code={examples.Gutter} language="tsx" title="Gutter">
    <Gutter client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="close-trigger">Close Trigger</h3>
  <ComponentPreview code={examples.CloseTrigger} language="tsx" title="Close Trigger">
    <CloseTrigger client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="with-dialog">With Dialog</h3>
  <ComponentPreview code={examples.WithDialog} language="tsx" title="With Dialog">
    <WithDialog client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="with-menu">With Menu</h3>
  <ComponentPreview code={examples.WithMenu} language="tsx" title="With Menu">
    <WithMenu client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="controlled">Controlled</h3>
  <ComponentPreview code={examples.Controlled} language="tsx" title="Controlled">
    <Controlled client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="placements">Placements</h3>
  <ComponentPreview code={examples.Placements} language="tsx" title="Placements">
    <Placements client:only="react" />
  </ComponentPreview>

  <h2 class="mb-3 mt-12 text-2xl font-semibold tracking-tight" id="installation">Installation</h2>
  <Installation class="mb-8" packages="@pisagor/react" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/action-bar</code>. Native HTML attributes are also supported and omitted from this table.
  </p>
  <PropsTable rows={actionBarProps} />
</DocsLayout>
