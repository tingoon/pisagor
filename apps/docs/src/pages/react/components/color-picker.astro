  },
  { depth: 3, slug: "slider-alpha-channel", text: "Slider Alpha Channel" },
  { depth: 3, slug: "slider-controlled", text: "Slider Controlled" },
  { depth: 3, slug: "slider-disabled", text: "Slider Disabled" },
