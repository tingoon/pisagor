  { depth: 3, slug: "swatch-picker", text: "Swatch Picker" },
  { depth: 3, slug: "clearable", text: "Clearable" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];
---

<DocsLayout
  description="Lets users choose a color visually and fine-tune it with sliders or numeric inputs."
  framework="react"
  headings={headings}
  title="Color Picker"
>
