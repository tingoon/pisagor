---
import ComponentHeader from "#/components/docs/component-header.astro";
import ComponentPreview from "#/components/docs/component-preview.astro";
import Installation from "#/components/docs/installation.astro";
import PropsTable from "#/components/docs/props-table.astro";
import DocsLayout from "#/layouts/docs-layout.astro";
import type { ComponentDocs } from "#/lib/component-docs-types";
import { accordionProps } from "#/lib/props/accordion";
import {
  Compound,
  Controlled,
  Default,
  Disabled,
  sources as examples,
  Multiple,
  NonCollapsible,
  WithCard,
} from "#/react/examples/accordion";
import {
  frontmatter as accordionDocs,
  Content,
  getHeadings,
} from "#/react/references/primitives/accordion.md";

const docs = accordionDocs as ComponentDocs;

const mdHeadings = getHeadings()
  .filter((h) => h.depth >= 2)
  .map((h) => ({ depth: h.depth, slug: h.slug, text: h.text }));

const headings = [
  ...mdHeadings,
  { depth: 2, slug: "examples", text: "Examples" },
  ...docs.examples.map((ex) => ({
    depth: 3,
    slug: ex.id,
    text: ex.title,
  })),
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];

function exampleMeta(exportName: string) {
  return docs.examples.find((ex) => ex.exportName === exportName);
}
---

<DocsLayout
  description={docs.description}
  framework="react"
  headings={headings}
  title={docs.title}
>
  <ComponentHeader framework="react" id={docs.id} />

  <div
    class="docs-skill-md mb-10 space-y-4 text-[0.9375rem] leading-7 text-foreground/90 [&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-2 [&_code]:rounded-md [&_code]:bg-muted/60 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-3.25 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-foreground [&_li]:my-1 [&_ol]:my-3 [&_ol]:list-decimal [&_ol]:ps-5 [&_p]:my-3 [&_pre]:my-4 [&_pre]:overflow-x-auto [&_pre]:rounded-xl [&_pre]:border [&_pre]:border-border/60 [&_pre]:bg-muted/30 [&_pre]:p-4 [&_pre]:text-3.25 [&_strong]:font-semibold [&_ul]:my-3 [&_ul]:list-disc [&_ul]:ps-5"
  >
    <Content />
  </div>

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="examples">
    Examples
  </h2>
  {docs.usageIntro ? (
  <p class="mb-4 text-muted-foreground">{docs.usageIntro}</p>
) : null}

  {(() => {
  const ex = exampleMeta("Default");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview code={examples.Default} language="tsx" title={ex.title}>
        <Default client:only="react" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("Multiple");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview
        code={examples.Multiple}
        language="tsx"
        title={ex.title}
      >
        <Multiple client:only="react" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("NonCollapsible");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview
        code={examples.NonCollapsible}
        language="tsx"
        title={ex.title}
      >
        <NonCollapsible client:only="react" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("Disabled");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview
        code={examples.Disabled}
        language="tsx"
        title={ex.title}
      >
        <Disabled client:only="react" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("Controlled");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview
        code={examples.Controlled}
        language="tsx"
        title={ex.title}
      >
        <Controlled client:only="react" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("Compound");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview
        code={examples.Compound}
        language="tsx"
        title={ex.title}
      >
        <Compound client:only="react" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("WithCard");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview
        code={examples.WithCard}
        language="tsx"
        title={ex.title}
      >
        <WithCard client:only="react" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  <h2
    class="mb-3 mt-16 text-2xl font-semibold tracking-tight"
    id="installation"
  >
    Installation
  </h2>
  <Installation
    class="mb-12"
    manual={docs.importStatement}
    packages={docs.packageName}
  />

  <h2 class="mb-3 mt-16 text-2xl font-semibold tracking-tight" id="props">
    Props
  </h2>
  <PropsTable rows={accordionProps} />
</DocsLayout>
