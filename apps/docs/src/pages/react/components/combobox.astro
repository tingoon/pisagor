---
import {
  Autohighlight,
  Compound,
  Controlled,
  Default,
  Disabled,
  sources as examples,
  Group,
  Invalid,
  imports,
  Multiple,
  Sizes,
  Variants,
  WithClearButton,
  WithScroll,
  WithStartIcon,
} from "@pisagor/react/combobox/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { comboboxProps } from "../../../lib/props/combobox";

const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "sizes", text: "Sizes" },
  { depth: 3, slug: "variants", text: "Variants" },
  { depth: 3, slug: "autohighlight", text: "Autohighlight" },
  { depth: 3, slug: "multiple", text: "Multiple" },
  { depth: 3, slug: "disabled", text: "Disabled" },
  { depth: 3, slug: "invalid", text: "Invalid" },
  { depth: 3, slug: "group", text: "Group" },
  { depth: 3, slug: "with-clear-button", text: "With Clear Button" },
  { depth: 3, slug: "with-scroll", text: "With Scroll" },
  { depth: 3, slug: "with-start-icon", text: "With Start Icon" },
  { depth: 3, slug: "controlled", text: "Controlled" },
  { depth: 3, slug: "compound", text: "Compound" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];
---

<DocsLayout
  description="Internal selection engine that combines search with a filterable list. Prefer Select, Autocomplete, or Listbox in application code."
  framework="react"
  headings={headings}
  title="Combobox"
>
  <ComponentHeader framework="react" id="combobox" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="tsx" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="sizes">
    Sizes
  </h3>
  <ComponentPreview code={examples.Sizes} language="tsx" title="Sizes">
    <Sizes client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="variants">
    Variants
  </h3>
  <ComponentPreview code={examples.Variants} language="tsx" title="Variants">
    <Variants client:only="react" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="autohighlight"
  >
    Autohighlight
  </h3>
  <ComponentPreview
    code={examples.Autohighlight}
    language="tsx"
    title="Autohighlight"
  >
    <Autohighlight client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="multiple">
    Multiple
  </h3>
  <ComponentPreview code={examples.Multiple} language="tsx" title="Multiple">
    <Multiple client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="disabled">
    Disabled
  </h3>
  <ComponentPreview code={examples.Disabled} language="tsx" title="Disabled">
    <Disabled client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="invalid">
    Invalid
  </h3>
  <ComponentPreview code={examples.Invalid} language="tsx" title="Invalid">
    <Invalid client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="group">
    Group
  </h3>
  <ComponentPreview code={examples.Group} language="tsx" title="Group">
    <Group client:only="react" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="with-clear-button"
  >
    With Clear Button
  </h3>
  <ComponentPreview
    code={examples.WithClearButton}
    language="tsx"
    title="With Clear Button"
  >
    <WithClearButton client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="with-scroll">
    With Scroll
  </h3>
  <ComponentPreview
    code={examples.WithScroll}
    language="tsx"
    title="With Scroll"
  >
    <WithScroll client:only="react" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="with-start-icon"
  >
    With Start Icon
  </h3>
  <ComponentPreview
    code={examples.WithStartIcon}
    language="tsx"
    title="With Start Icon"
  >
    <WithStartIcon client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="controlled">
    Controlled
  </h3>
  <ComponentPreview
    code={examples.Controlled}
    language="tsx"
    title="Controlled"
  >
    <Controlled client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="compound">
    Compound
  </h3>
  <ComponentPreview code={examples.Compound} language="tsx" title="Compound">
    <Compound client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">
    Default
  </h3>
  <ComponentPreview code={examples.Default} language="tsx" title="Default">
    <Default client:only="react" />
  </ComponentPreview>

  <h2
    class="mb-3 mt-12 text-2xl font-semibold tracking-tight"
    id="installation"
  >
    Installation
  </h2>
  <Installation class="mb-8" packages="@pisagor/react" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/combobox</code>. Native HTML attributes
    are also supported and omitted from this table.
  </p>
  <PropsTable rows={comboboxProps} />
</DocsLayout>
