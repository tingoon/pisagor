---
import {
  CheckboxTree,
  Controlled,
  CustomIcons,
  CustomIconsFolder,
  CustomIconsItem,
  Default,
  sources as examples,
  imports,
  Links,
  MultipleSelection,
  Rename,
  WithContextMenu,
} from "@pisagor/react/tree-view/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { treeViewProps } from "../../../lib/props/tree-view";

const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "links", text: "Links" },
  { depth: 3, slug: "checkbox-tree", text: "Checkbox Tree" },
  { depth: 3, slug: "with-context-menu", text: "With Context Menu" },
  { depth: 3, slug: "custom-icons-folder", text: "Custom Icons Folder" },
  { depth: 3, slug: "custom-icons-item", text: "Custom Icons Item" },
  { depth: 3, slug: "custom-icons", text: "Custom Icons" },
  { depth: 3, slug: "multiple-selection", text: "Multiple Selection" },
  { depth: 3, slug: "rename", text: "Rename" },
  { depth: 3, slug: "controlled", text: "Controlled" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];
---

<DocsLayout
  description="Browses nested folders or categories in an expandable tree for files, navigation, and hierarchies."
  framework="react"
  headings={headings}
  title="Tree View"
>
  <ComponentHeader framework="react" id="tree-view" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="tsx" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="links">
    Links
  </h3>
  <ComponentPreview code={examples.Links} language="tsx" title="Links">
    <Links client:only="react" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="checkbox-tree"
  >
    Checkbox Tree
  </h3>
  <ComponentPreview
    code={examples.CheckboxTree}
    language="tsx"
    title="Checkbox Tree"
  >
    <CheckboxTree client:only="react" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="with-context-menu"
  >
    With Context Menu
  </h3>
  <ComponentPreview
    code={examples.WithContextMenu}
    language="tsx"
    title="With Context Menu"
  >
    <WithContextMenu client:only="react" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="custom-icons-folder"
  >
    Custom Icons Folder
  </h3>
  <ComponentPreview
    code={examples.CustomIconsFolder}
    language="tsx"
    title="Custom Icons Folder"
  >
    <CustomIconsFolder client:only="react" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="custom-icons-item"
  >
    Custom Icons Item
  </h3>
  <ComponentPreview
    code={examples.CustomIconsItem}
    language="tsx"
    title="Custom Icons Item"
  >
    <CustomIconsItem client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="custom-icons">
    Custom Icons
  </h3>
  <ComponentPreview
    code={examples.CustomIcons}
    language="tsx"
    title="Custom Icons"
  >
    <CustomIcons client:only="react" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="multiple-selection"
  >
    Multiple Selection
  </h3>
  <ComponentPreview
    code={examples.MultipleSelection}
    language="tsx"
    title="Multiple Selection"
  >
    <MultipleSelection client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="rename">
    Rename
  </h3>
  <ComponentPreview code={examples.Rename} language="tsx" title="Rename">
    <Rename client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="controlled">
    Controlled
  </h3>
  <ComponentPreview
    code={examples.Controlled}
    language="tsx"
    title="Controlled"
  >
    <Controlled client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">
    Default
  </h3>
  <ComponentPreview code={examples.Default} language="tsx" title="Default">
    <Default client:only="react" />
  </ComponentPreview>

  <h2
    class="mb-3 mt-12 text-2xl font-semibold tracking-tight"
    id="installation"
  >
    Installation
  </h2>
  <Installation class="mb-8" packages="@pisagor/react" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/tree-view</code>. Native HTML attributes
    are also supported and omitted from this table.
  </p>
  <PropsTable rows={treeViewProps} />
</DocsLayout>
