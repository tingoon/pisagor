---
import ComponentHeader from "#/components/docs/component-header.astro";
import ComponentPreview from "#/components/docs/component-preview.astro";
import Installation from "#/components/docs/installation.astro";
import PropsTable from "#/components/docs/props-table.astro";
import DocsLayout from "#/layouts/docs-layout.astro";
import type { ComponentDocs } from "#/lib/component-docs-types";
import { treeViewProps } from "#/lib/props/tree-view";
import { getSkillDocImportStatement } from "#/lib/skill-doc";
import {
  CheckboxTree,
  Controlled,
  CustomIcons,
  CustomIconsFolder,
  CustomIconsItem,
  Default,
  sources as examples,
  Links,
  MultipleSelection,
  Rename,
  WithContextMenu,
} from "#/react/examples/tree-view";
import {
  frontmatter,
  getHeadings,
  Content as SkillContent,
} from "#/react/references/primitives/tree-view.md";

const id = "tree-view";
const docs = frontmatter as ComponentDocs;
const importStatement = getSkillDocImportStatement(
  id,
  docs.packageName ?? "@pisagor/react",
);

const mdHeadings = getHeadings()
  .filter((h) => h.depth >= 2)
  .map((h) => ({ depth: h.depth, slug: h.slug, text: h.text }));

const headings = [
  ...mdHeadings,
  { depth: 2, slug: "examples", text: "Examples" },
  ...docs.examples.map((ex) => ({
    depth: 3,
    slug: ex.id,
    text: ex.title,
  })),
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];

function exampleMeta(exportName: string) {
  return docs.examples.find((ex) => ex.exportName === exportName);
}
---

<DocsLayout
  description={docs.description}
  framework="react"
  headings={headings}
  title={docs.title}
>
  <ComponentHeader framework="react" id={id} />

  <div
    class="docs-skill-md mb-10 space-y-4 text-[0.9375rem] leading-7 text-foreground/90 [&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-2 [&_code]:rounded-md [&_code]:bg-muted/60 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-3.25 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-foreground [&_li]:my-1 [&_ol]:my-3 [&_ol]:list-decimal [&_ol]:ps-5 [&_p]:my-3 [&_pre]:my-4 [&_pre]:overflow-x-auto [&_pre]:rounded-xl [&_pre]:border [&_pre]:border-border/60 [&_pre]:bg-muted/30 [&_pre]:p-4 [&_pre]:text-3.25 [&_strong]:font-semibold [&_ul]:my-3 [&_ul]:list-disc [&_ul]:ps-5"
  >
    <SkillContent />
  </div>

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="examples">
    Examples
  </h2>

  {(() => {
  const ex = exampleMeta("Links");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview code={examples.Links} language="tsx" title={ex.title}>
        <Links client:only="react" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("CheckboxTree");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview
        code={examples.CheckboxTree}
        language="tsx"
        title={ex.title}
      >
        <CheckboxTree client:only="react" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("WithContextMenu");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview
        code={examples.WithContextMenu}
        language="tsx"
        title={ex.title}
      >
        <WithContextMenu client:only="react" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("CustomIconsFolder");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview
        code={examples.CustomIconsFolder}
        language="tsx"
        title={ex.title}
      >
        <CustomIconsFolder client:only="react" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("CustomIconsItem");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview
        code={examples.CustomIconsItem}
        language="tsx"
        title={ex.title}
      >
        <CustomIconsItem client:only="react" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("CustomIcons");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview
        code={examples.CustomIcons}
        language="tsx"
        title={ex.title}
      >
        <CustomIcons client:only="react" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("MultipleSelection");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview
        code={examples.MultipleSelection}
        language="tsx"
        title={ex.title}
      >
        <MultipleSelection client:only="react" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("Rename");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview code={examples.Rename} language="tsx" title={ex.title}>
        <Rename client:only="react" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("Controlled");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview
        code={examples.Controlled}
        language="tsx"
        title={ex.title}
