---
import {
  Autoplay,
  Compound,
  Controlled,
  Default,
  sources as examples,
  imports,
  Loop,
  MouseDrag,
  OrientationHorizontal,
  OrientationVertical,
  SlidesPerPage,
  Spacing,
  ThumbnailIndicator,
  ThumbnailIndicatorVertical,
} from "@pisagor/react/carousel/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { carouselProps } from "../../../lib/props/carousel";

export const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 3, slug: "autoplay", text: "Autoplay" },
  { depth: 3, slug: "loop", text: "Loop" },
  { depth: 3, slug: "mouse-drag", text: "Mouse Drag" },
  { depth: 3, slug: "orientation-horizontal", text: "Orientation Horizontal" },
  { depth: 3, slug: "orientation-vertical", text: "Orientation Vertical" },
  { depth: 3, slug: "spacing", text: "Spacing" },
  { depth: 3, slug: "slides-per-page", text: "Slides Per Page" },
  { depth: 3, slug: "thumbnail-indicator-vertical", text: "Thumbnail Indicator Vertical" },
  { depth: 3, slug: "thumbnail-indicator", text: "Thumbnail Indicator" },
  { depth: 3, slug: "controlled", text: "Controlled" },
  { depth: 3, slug: "compound", text: "Compound" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];

export {
  Autoplay,
  CodeBlock,
  ComponentHeader,
  ComponentPreview,
  Compound,
  Controlled,
  carouselProps,
  Default,
  DocsLayout,
  examples,
  Installation,
  imports,
  Loop,
  MouseDrag,
  OrientationHorizontal,
  OrientationVertical,
  PropsTable,
  SlidesPerPage,
  Spacing,
  ThumbnailIndicator,
  ThumbnailIndicatorVertical,
};
---

<DocsLayout
  description="Steps through a set of slides or images so users can browse one item at a time without leaving the page."
  framework="react"
  headings={headings}
  title="Carousel"
>

  <ComponentHeader framework="react" id="carousel" />


  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="tsx" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">Default</h3>
  <ComponentPreview code={examples.Default} language="tsx" title="Default">
    <Default client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="autoplay">Autoplay</h3>
  <ComponentPreview code={examples.Autoplay} language="tsx" title="Autoplay">
    <Autoplay client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="loop">Loop</h3>
  <ComponentPreview code={examples.Loop} language="tsx" title="Loop">
    <Loop client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="mouse-drag">Mouse Drag</h3>
  <ComponentPreview code={examples.MouseDrag} language="tsx" title="Mouse Drag">
    <MouseDrag client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="orientation-horizontal">Orientation Horizontal</h3>
  <ComponentPreview code={examples.OrientationHorizontal} language="tsx" title="Orientation Horizontal">
    <OrientationHorizontal client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="orientation-vertical">Orientation Vertical</h3>
  <ComponentPreview code={examples.OrientationVertical} language="tsx" title="Orientation Vertical">
    <OrientationVertical client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="spacing">Spacing</h3>
  <ComponentPreview code={examples.Spacing} language="tsx" title="Spacing">
    <Spacing client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="slides-per-page">Slides Per Page</h3>
  <ComponentPreview code={examples.SlidesPerPage} language="tsx" title="Slides Per Page">
    <SlidesPerPage client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="thumbnail-indicator-vertical">Thumbnail Indicator Vertical</h3>
  <ComponentPreview code={examples.ThumbnailIndicatorVertical} language="tsx" title="Thumbnail Indicator Vertical">
    <ThumbnailIndicatorVertical client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="thumbnail-indicator">Thumbnail Indicator</h3>
  <ComponentPreview code={examples.ThumbnailIndicator} language="tsx" title="Thumbnail Indicator">
    <ThumbnailIndicator client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="controlled">Controlled</h3>
  <ComponentPreview code={examples.Controlled} language="tsx" title="Controlled">
    <Controlled client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="compound">Compound</h3>
  <ComponentPreview code={examples.Compound} language="tsx" title="Compound">
    <Compound client:only="react" />
  </ComponentPreview>

  <h2 class="mb-3 mt-12 text-2xl font-semibold tracking-tight" id="installation">Installation</h2>
  <Installation class="mb-8" packages="@pisagor/react" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/carousel</code>. Native HTML attributes are also supported and omitted from this table.
  </p>
  <PropsTable rows={carouselProps} />
</DocsLayout>
