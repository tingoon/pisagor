---
import {
  CustomSpacing,
  Default,
  sources as examples,
  Group,
  Header,
  Icon,
  Image,
  imports,
  Link,
  Variants,
  WithAvatar,
  WithMedia,
} from "@pisagor/react/item/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { itemProps } from "../../../lib/props/item";

const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 3, slug: "variants", text: "Variants" },
  { depth: 3, slug: "icon", text: "Icon" },
  { depth: 3, slug: "custom-spacing", text: "Custom Spacing" },
  { depth: 3, slug: "with-media", text: "With Media" },
  { depth: 3, slug: "with-avatar", text: "With Avatar" },
  { depth: 3, slug: "image", text: "Image" },
  { depth: 3, slug: "link", text: "Link" },
  { depth: 3, slug: "group", text: "Group" },
  { depth: 3, slug: "header", text: "Header" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];
---

<DocsLayout
  description="Lays out a row of media, title, description, and actions for lists, menus, and pickers."
  framework="react"
  headings={headings}
  title="Item"
>
  <ComponentHeader framework="react" id="item" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="tsx" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">
    Default
  </h3>
  <ComponentPreview code={examples.Default} language="tsx" title="Default">
    <Default client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="variants">
    Variants
  </h3>
  <ComponentPreview code={examples.Variants} language="tsx" title="Variants">
    <Variants client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="icon">
    Icon
  </h3>
  <ComponentPreview code={examples.Icon} language="tsx" title="Icon">
    <Icon client:only="react" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="custom-spacing"
  >
    Custom Spacing
  </h3>
  <ComponentPreview
    code={examples.CustomSpacing}
    language="tsx"
    title="Custom Spacing"
  >
    <CustomSpacing client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="with-media">
    With Media
  </h3>
  <ComponentPreview code={examples.WithMedia} language="tsx" title="With Media">
    <WithMedia client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="with-avatar">
    With Avatar
  </h3>
  <ComponentPreview
    code={examples.WithAvatar}
    language="tsx"
    title="With Avatar"
  >
    <WithAvatar client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="image">
    Image
  </h3>
  <ComponentPreview code={examples.Image} language="tsx" title="Image">
    <Image client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="link">
    Link
  </h3>
  <ComponentPreview code={examples.Link} language="tsx" title="Link">
    <Link client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="group">
    Group
  </h3>
  <ComponentPreview code={examples.Group} language="tsx" title="Group">
    <Group client:only="react" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="header">
    Header
  </h3>
  <ComponentPreview code={examples.Header} language="tsx" title="Header">
    <Header client:only="react" />
  </ComponentPreview>

  <h2
    class="mb-3 mt-12 text-2xl font-semibold tracking-tight"
    id="installation"
  >
    Installation
  </h2>
  <Installation class="mb-8" packages="@pisagor/react" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/item</code>. Native HTML attributes are
    also supported and omitted from this table.
  </p>
  <PropsTable rows={itemProps} />
</DocsLayout>
