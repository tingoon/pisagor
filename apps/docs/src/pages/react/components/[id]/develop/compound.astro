---
import ComponentDocPage from "#/components/docs/component-doc-page.astro";
import { listCompoundStaticPaths } from "#/lib/component-doc";

export async function getStaticPaths() {
  return listCompoundStaticPaths("react");
}

const id = Astro.params.id as string;
---

<ComponentDocPage framework="react" id={id} surface="compound" tab="develop" />
