---
import ComponentDocPage from "#/components/docs/component-doc-page.astro";
import { ReactExamplesHost } from "#/components/docs/react/examples-host";
import { listComponentPaneStaticPaths } from "#/lib/component-doc";

export async function getStaticPaths() {
  return listComponentPaneStaticPaths("react", "develop");
}

const id = Astro.params.id as string;
---

<ComponentDocPage framework="react" id={id} tab="develop" />
<ReactExamplesHost client:only="react" />
