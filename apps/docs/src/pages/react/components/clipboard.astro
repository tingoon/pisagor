---
import {
  Controlled,
  CustomTimeout,
  Default,
  DifferentIcon,
  sources as examples,
  imports,
  Variants,
  WithLabel,
} from "@pisagor/react/clipboard/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { clipboardProps } from "../../../lib/props/clipboard";

export const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "variants", text: "Variants" },
  { depth: 3, slug: "custom-timeout", text: "Custom Timeout" },
  { depth: 3, slug: "different-icon", text: "Different Icon" },
  { depth: 3, slug: "with-label", text: "With Label" },
  { depth: 3, slug: "controlled", text: "Controlled" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];

export {
  CodeBlock,
  ComponentHeader,
  ComponentPreview,
  Controlled,
  CustomTimeout,
  clipboardProps,
  Default,
  DifferentIcon,
  DocsLayout,
  examples,
  Installation,
  imports,
  PropsTable,
  Variants,
  WithLabel,
};
---

<DocsLayout
  description="Copies text to the clipboard with clear feedback so users can reuse values without selecting manually."
  framework="react"
  headings={headings}
  title="Clipboard"
>

  <ComponentHeader framework="react" id="clipboard" />


  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="tsx" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="variants">Variants</h3>
  <ComponentPreview code={examples.Variants} language="tsx" title="Variants">
    <Variants client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="custom-timeout">Custom Timeout</h3>
  <ComponentPreview code={examples.CustomTimeout} language="tsx" title="Custom Timeout">
    <CustomTimeout client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="different-icon">Different Icon</h3>
  <ComponentPreview code={examples.DifferentIcon} language="tsx" title="Different Icon">
    <DifferentIcon client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="with-label">With Label</h3>
  <ComponentPreview code={examples.WithLabel} language="tsx" title="With Label">
    <WithLabel client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="controlled">Controlled</h3>
  <ComponentPreview code={examples.Controlled} language="tsx" title="Controlled">
    <Controlled client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">Default</h3>
  <ComponentPreview code={examples.Default} language="tsx" title="Default">
    <Default client:only="react" />
  </ComponentPreview>

  <h2 class="mb-3 mt-12 text-2xl font-semibold tracking-tight" id="installation">Installation</h2>
  <Installation class="mb-8" packages="@pisagor/react" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/clipboard</code>. Native HTML attributes are also supported and omitted from this table.
  </p>
  <PropsTable rows={clipboardProps} />
</DocsLayout>
