---
import {
  Controlled,
  Default,
  Disabled,
  sources as examples,
  FieldOnly,
  Formatted,
  Invalid,
  imports,
  MouseWheel,
  Range,
  Scrub,
  Sizes,
  Step,
  Variants,
} from "@pisagor/react/number-input/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { numberInputProps } from "../../../lib/props/number-input";

export const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "sizes", text: "Sizes" },
  { depth: 3, slug: "variants", text: "Variants" },
  { depth: 3, slug: "field-only", text: "Field Only" },
  { depth: 3, slug: "formatted", text: "Formatted" },
  { depth: 3, slug: "mouse-wheel", text: "Mouse Wheel" },
  { depth: 3, slug: "range", text: "Range" },
  { depth: 3, slug: "scrub", text: "Scrub" },
  { depth: 3, slug: "step", text: "Step" },
  { depth: 3, slug: "disabled", text: "Disabled" },
  { depth: 3, slug: "invalid", text: "Invalid" },
  { depth: 3, slug: "controlled", text: "Controlled" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];

export {
  CodeBlock,
  ComponentHeader,
  ComponentPreview,
  Controlled,
  Default,
  Disabled,
  DocsLayout,
  examples,
  FieldOnly,
  Formatted,
  Installation,
  Invalid,
  imports,
  MouseWheel,
  numberInputProps,
  PropsTable,
  Range,
  Scrub,
  Sizes,
  Step,
  Variants,
};
---

<DocsLayout
  description="Captures numeric values with optional steppers and validation for quantities and settings."
  framework="react"
  headings={headings}
  title="Number Input"
>

  <ComponentHeader framework="react" id="number-input" />


  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="tsx" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="sizes">Sizes</h3>
  <ComponentPreview code={examples.Sizes} language="tsx" title="Sizes">
    <Sizes client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="variants">Variants</h3>
  <ComponentPreview code={examples.Variants} language="tsx" title="Variants">
    <Variants client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="field-only">Field Only</h3>
  <ComponentPreview code={examples.FieldOnly} language="tsx" title="Field Only">
    <FieldOnly client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="formatted">Formatted</h3>
  <ComponentPreview code={examples.Formatted} language="tsx" title="Formatted">
    <Formatted client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="mouse-wheel">Mouse Wheel</h3>
  <ComponentPreview code={examples.MouseWheel} language="tsx" title="Mouse Wheel">
    <MouseWheel client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="range">Range</h3>
  <ComponentPreview code={examples.Range} language="tsx" title="Range">
    <Range client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="scrub">Scrub</h3>
  <ComponentPreview code={examples.Scrub} language="tsx" title="Scrub">
    <Scrub client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="step">Step</h3>
  <ComponentPreview code={examples.Step} language="tsx" title="Step">
    <Step client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="disabled">Disabled</h3>
  <ComponentPreview code={examples.Disabled} language="tsx" title="Disabled">
    <Disabled client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="invalid">Invalid</h3>
  <ComponentPreview code={examples.Invalid} language="tsx" title="Invalid">
    <Invalid client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="controlled">Controlled</h3>
  <ComponentPreview code={examples.Controlled} language="tsx" title="Controlled">
    <Controlled client:only="react" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">Default</h3>
  <ComponentPreview code={examples.Default} language="tsx" title="Default">
    <Default client:only="react" />
  </ComponentPreview>

  <h2 class="mb-3 mt-12 text-2xl font-semibold tracking-tight" id="installation">Installation</h2>
  <Installation class="mb-8" packages="@pisagor/react" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/number-input</code>. Native HTML attributes are also supported and omitted from this table.
  </p>
  <PropsTable rows={numberInputProps} />
</DocsLayout>
