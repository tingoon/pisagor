---
import Installation from "#/components/docs/installation.astro";
import PackageLinks from "#/components/docs/package-links.astro";
import DocsLayout from "#/layouts/docs-layout.astro";
import { withDocsBase } from "#/lib/nav";

const headings = [
  { depth: 2, slug: "overview", text: "Overview" },
  { depth: 2, slug: "install", text: "Install" },
  { depth: 2, slug: "next", text: "Next" },
];
---

<DocsLayout
  description="Build with Pisagor Vue components and live docs demos."
  framework="vue"
  headings={headings}
  title="Introduction"
>
  <PackageLinks framework="vue" />
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">
    Overview
  </h2>
  <p class="mb-6 text-muted-foreground">
    <code class="rounded bg-muted px-1.5 py-0.5 text-sm">@pisagor/vue</code>
    is the Vue UI kit — accessible primitives on Ark UI and Tailwind v4, styled
    with
    <code class="rounded bg-muted px-1.5 py-0.5 text-sm">@pisagor/recipes</code>
    and typed via
    <code class="rounded bg-muted px-1.5 py-0.5 text-sm">@pisagor/props</code>.
    Browse a component for when to use it, installation, and live examples you
    can copy into your app.
  </p>

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="install">
    Install
  </h2>
  <Installation class="mb-6" packages="@pisagor/vue" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="next">Next</h2>
  <p class="text-muted-foreground">
    Start with the{" "}
    <a
      class="text-foreground underline-offset-4 hover:underline"
      href={withDocsBase("/vue/components/button")}
      >Button</a
    >
    or{" "}
    <a
      class="text-foreground underline-offset-4 hover:underline"
      href={withDocsBase("/vue/components/accordion")}
      >Accordion</a
    >{" "}
    page.
  </p>
</DocsLayout>
