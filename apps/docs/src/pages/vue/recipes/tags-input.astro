---
import { TagsWithCombobox } from "#recipes-vue/tags-input/tags-with-combobox";
import TagsWithComboboxSource from "#recipes-vue/tags-input/tags-with-combobox.ts?raw";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";

const headings = [
  {
    depth: 2,
    slug: "overview",
    text: "Overview",
  },
  {
    depth: 2,
    slug: "tags-with-combobox",
    text: "Tags With Combobox",
  },
];
---

<DocsLayout
  description="Tags input paired with a combobox for searchable tag selection and custom value entry."
  framework="vue"
  headings={headings}
  title="Tags Input"
>
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">
    Overview
  </h2>
  <p class="mb-8 text-muted-foreground">
    Tags input paired with a combobox for searchable tag selection and custom
    value entry.
  </p>

  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="tags-with-combobox"
  >
    Tags With Combobox
  </h2>
  <ComponentPreview
    code={TagsWithComboboxSource}
    language="ts"
    title="Tags With Combobox"
  >
    <TagsWithCombobox client:only="vue" />
  </ComponentPreview>
</DocsLayout>
