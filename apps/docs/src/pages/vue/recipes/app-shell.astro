---
import { StandardAppShell } from "#recipes-vue/app-shell/standard-app-shell";
import StandardAppShellSource from "#recipes-vue/app-shell/standard-app-shell.ts?raw";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";

const headings = [
  {
    depth: 2,
    slug: "overview",
    text: "Overview",
  },
  {
    depth: 2,
    slug: "standard-app-shell",
    text: "Standard App Shell",
  },
];
---

<DocsLayout
  description="Standard application shell with top navigation, icon rail, side panel, main content, and inspector regions ready for menus and page content."
  framework="vue"
  headings={headings}
  title="App Shell"
>
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">
    Overview
  </h2>
  <p class="mb-8 text-muted-foreground">
    Standard application shell with top navigation, icon rail, side panel, main
    content, and inspector regions ready for menus and page content.
  </p>

  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="standard-app-shell"
  >
    Standard App Shell
  </h2>
  <ComponentPreview
    code={StandardAppShellSource}
    language="ts"
    title="Standard App Shell"
  >
    <StandardAppShell client:only="vue" />
  </ComponentPreview>
</DocsLayout>
