---
import { AvatarGroupOverflow } from "@recipes-vue/overlay/avatar-group-overflow";
import AvatarGroupOverflowSource from "@recipes-vue/overlay/avatar-group-overflow.ts?raw";
import { ItemPicker } from "@recipes-vue/overlay/item-picker";
import ItemPickerSource from "@recipes-vue/overlay/item-picker.ts?raw";
import { MenuDialog } from "@recipes-vue/overlay/menu-dialog";
import MenuDialogSource from "@recipes-vue/overlay/menu-dialog.ts?raw";
import { PopoverDialog } from "@recipes-vue/overlay/popover-dialog";
import PopoverDialogSource from "@recipes-vue/overlay/popover-dialog.ts?raw";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";

const headings = [
  {
    depth: 2,
    slug: "overview",
    text: "Overview",
  },
  {
    depth: 2,
    slug: "menu-dialog",
    text: "Menu Dialog",
  },
  {
    depth: 2,
    slug: "popover-dialog",
    text: "Popover Dialog",
  },
  {
    depth: 2,
    slug: "item-picker",
    text: "Item Picker",
  },
  {
    depth: 2,
    slug: "avatar-group-overflow",
    text: "Avatar Group Overflow",
  },
];

export {
  AvatarGroupOverflow,
  AvatarGroupOverflowSource,
  ComponentPreview,
  DocsLayout,
  headings,
  ItemPicker,
  ItemPickerSource,
  MenuDialog,
  MenuDialogSource,
  PopoverDialog,
  PopoverDialogSource,
};
---

<DocsLayout
  description="Overlay compositions for menus, dialogs, popovers, item pickers, and avatar overflow."
  framework="vue"
  headings={headings}
  title="Overlay"
>

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">Overview</h2>
  <p class="mb-8 text-muted-foreground">Overlay compositions for menus, dialogs, popovers, item pickers, and avatar overflow.</p>

  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="menu-dialog">Menu Dialog</h2>
  <ComponentPreview code={MenuDialogSource} language="ts" title="Menu Dialog">
    <MenuDialog client:only="vue" />
  </ComponentPreview>
  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="popover-dialog">Popover Dialog</h2>
  <ComponentPreview code={PopoverDialogSource} language="ts" title="Popover Dialog">
    <PopoverDialog client:only="vue" />
  </ComponentPreview>
  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="item-picker">Item Picker</h2>
  <ComponentPreview code={ItemPickerSource} language="ts" title="Item Picker">
    <ItemPicker client:only="vue" />
  </ComponentPreview>
  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="avatar-group-overflow">Avatar Group Overflow</h2>
  <ComponentPreview code={AvatarGroupOverflowSource} language="ts" title="Avatar Group Overflow">
    <AvatarGroupOverflow client:only="vue" />
  </ComponentPreview>

</DocsLayout>
