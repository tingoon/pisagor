---
import { SearchFieldButtonGroup } from "@recipes-vue/search-field/search-field-button-group";
import SearchFieldButtonGroupSource from "@recipes-vue/search-field/search-field-button-group.ts?raw";
import { SearchFieldInline } from "@recipes-vue/search-field/search-field-inline";
import SearchFieldInlineSource from "@recipes-vue/search-field/search-field-inline.ts?raw";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";

const headings = [
  {
    depth: 2,
    slug: "overview",
    text: "Overview",
  },
  {
    depth: 2,
    slug: "search-field-button-group",
    text: "Search Field Button Group",
  },
  {
    depth: 2,
    slug: "search-field-inline",
    text: "Search Field Inline",
  },
];
---

<DocsLayout
  description="Search input compositions with button group and inline field layouts."
  framework="vue"
  headings={headings}
  title="Search Field"
>
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">
    Overview
  </h2>
  <p class="mb-8 text-muted-foreground">
    Search input compositions with button group and inline field layouts.
  </p>

  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="search-field-button-group"
  >
    Search Field Button Group
  </h2>
  <ComponentPreview
    code={SearchFieldButtonGroupSource}
    language="ts"
    title="Search Field Button Group"
  >
    <SearchFieldButtonGroup client:only="vue" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="search-field-inline"
  >
    Search Field Inline
  </h2>
  <ComponentPreview
    code={SearchFieldInlineSource}
    language="ts"
    title="Search Field Inline"
  >
    <SearchFieldInline client:only="vue" />
  </ComponentPreview>
</DocsLayout>
