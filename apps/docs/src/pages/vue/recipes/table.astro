---
import { TableBulkActions } from "@recipes-vue/table/table-bulk-actions";
import TableBulkActionsSource from "@recipes-vue/table/table-bulk-actions.ts?raw";
import { TablePagination } from "@recipes-vue/table/table-pagination";
import TablePaginationSource from "@recipes-vue/table/table-pagination.ts?raw";
import { TableRowMenu } from "@recipes-vue/table/table-row-menu";
import TableRowMenuSource from "@recipes-vue/table/table-row-menu.ts?raw";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";

const headings = [
  {
    depth: 2,
    slug: "overview",
    text: "Overview",
  },
  {
    depth: 2,
    slug: "table-bulk-actions",
    text: "Table Bulk Actions",
  },
  {
    depth: 2,
    slug: "table-row-menu",
    text: "Table Row Menu",
  },
  {
    depth: 2,
    slug: "table-pagination",
    text: "Table Pagination",
  },
];
---

<DocsLayout
  description="Table compositions with bulk actions, row menus, and pagination controls."
  framework="vue"
  headings={headings}
  title="Table"
>
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">Overview</h2>
  <p class="mb-8 text-muted-foreground">
    Table compositions with bulk actions, row menus, and pagination controls.
  </p>

  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="table-bulk-actions">
    Table Bulk Actions
  </h2>
  <ComponentPreview code={TableBulkActionsSource} language="ts" title="Table Bulk Actions">
    <TableBulkActions client:only="vue" />
  </ComponentPreview>
  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="table-row-menu">
    Table Row Menu
  </h2>
  <ComponentPreview code={TableRowMenuSource} language="ts" title="Table Row Menu">
    <TableRowMenu client:only="vue" />
  </ComponentPreview>
  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="table-pagination">
    Table Pagination
  </h2>
  <ComponentPreview code={TablePaginationSource} language="ts" title="Table Pagination">
    <TablePagination client:only="vue" />
  </ComponentPreview>
</DocsLayout>
