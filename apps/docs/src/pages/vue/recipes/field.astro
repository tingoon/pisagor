---
import ComponentPreview from "#/components/docs/component-preview.astro";
import DocsLayout from "#/layouts/docs-layout.astro";
import { FormGrid } from "#/vue/recipes/field/form-grid";
import FormGridSource from "#/vue/recipes/field/form-grid.ts?raw";
import { FormSection } from "#/vue/recipes/field/form-section";
import FormSectionSource from "#/vue/recipes/field/form-section.ts?raw";
import { FormSectionTextarea } from "#/vue/recipes/field/form-section-textarea";
import FormSectionTextareaSource from "#/vue/recipes/field/form-section-textarea.ts?raw";
import { LabelAccessory } from "#/vue/recipes/field/label-accessory";
import LabelAccessorySource from "#/vue/recipes/field/label-accessory.ts?raw";
import { SettingsPanel } from "#/vue/recipes/field/settings-panel";
import SettingsPanelSource from "#/vue/recipes/field/settings-panel.ts?raw";
import { SettingsRow } from "#/vue/recipes/field/settings-row";
import SettingsRowSource from "#/vue/recipes/field/settings-row.ts?raw";

const headings = [
  {
    depth: 2,
    slug: "overview",
    text: "Overview",
  },
  {
    depth: 2,
    slug: "form-grid",
    text: "Form Grid",
  },
  {
    depth: 2,
    slug: "form-section",
    text: "Form Section",
  },
  {
    depth: 2,
    slug: "form-section-textarea",
    text: "Form Section Textarea",
  },
  {
    depth: 2,
    slug: "label-accessory",
    text: "Label Accessory",
  },
  {
    depth: 2,
    slug: "settings-panel",
    text: "Settings Panel",
  },
  {
    depth: 2,
    slug: "settings-row",
    text: "Settings Row",
  },
];
---

<DocsLayout
  description="Field layout compositions for grids, sections, labels, and settings rows."
  framework="vue"
  headings={headings}
  title="Field"
>
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">
    Overview
  </h2>
  <p class="mb-8 text-muted-foreground">
    Field layout compositions for grids, sections, labels, and settings rows.
  </p>

  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="form-grid">
    Form Grid
  </h2>
  <ComponentPreview code={FormGridSource} language="ts" title="Form Grid">
    <FormGrid client:only="vue" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="form-section"
  >
    Form Section
  </h2>
  <ComponentPreview code={FormSectionSource} language="ts" title="Form Section">
    <FormSection client:only="vue" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="form-section-textarea"
  >
    Form Section Textarea
  </h2>
  <ComponentPreview
    code={FormSectionTextareaSource}
    language="ts"
    title="Form Section Textarea"
  >
    <FormSectionTextarea client:only="vue" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="label-accessory"
  >
    Label Accessory
  </h2>
  <ComponentPreview
    code={LabelAccessorySource}
    language="ts"
    title="Label Accessory"
  >
    <LabelAccessory client:only="vue" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="settings-panel"
  >
    Settings Panel
  </h2>
  <ComponentPreview
    code={SettingsPanelSource}
    language="ts"
    title="Settings Panel"
  >
    <SettingsPanel client:only="vue" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="settings-row"
  >
    Settings Row
  </h2>
  <ComponentPreview code={SettingsRowSource} language="ts" title="Settings Row">
    <SettingsRow client:only="vue" />
  </ComponentPreview>
</DocsLayout>
