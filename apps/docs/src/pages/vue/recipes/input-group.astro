---
import { CodeEditorInput } from "@recipes-vue/input-group/code-editor-input";
import CodeEditorInputSource from "@recipes-vue/input-group/code-editor-input.ts?raw";
import { InputGroupWithButton } from "@recipes-vue/input-group/input-group-with-button";
import InputGroupWithButtonSource from "@recipes-vue/input-group/input-group-with-button.ts?raw";
import { InputGroupWithInnerLabel } from "@recipes-vue/input-group/input-group-with-inner-label";
import InputGroupWithInnerLabelSource from "@recipes-vue/input-group/input-group-with-inner-label.ts?raw";
import { InputGroupWithMenu } from "@recipes-vue/input-group/input-group-with-menu";
import InputGroupWithMenuSource from "@recipes-vue/input-group/input-group-with-menu.ts?raw";
import { InputGroupWithNumberInput } from "@recipes-vue/input-group/input-group-with-number-input";
import InputGroupWithNumberInputSource from "@recipes-vue/input-group/input-group-with-number-input.ts?raw";
import { InputGroupWithTooltip } from "@recipes-vue/input-group/input-group-with-tooltip";
import InputGroupWithTooltipSource from "@recipes-vue/input-group/input-group-with-tooltip.ts?raw";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";

const headings = [
  {
    depth: 2,
    slug: "overview",
    text: "Overview",
  },
  {
    depth: 2,
    slug: "code-editor-input",
    text: "Code Editor Input",
  },
  {
    depth: 2,
    slug: "input-group-with-menu",
    text: "Input Group With Menu",
  },
  {
    depth: 2,
    slug: "input-group-with-button",
    text: "Input Group With Button",
  },
  {
    depth: 2,
    slug: "input-group-with-inner-label",
    text: "Input Group With Inner Label",
  },
  {
    depth: 2,
    slug: "input-group-with-number-input",
    text: "Input Group With Number Input",
  },
  {
    depth: 2,
    slug: "input-group-with-tooltip",
    text: "Input Group With Tooltip",
  },
];

export {
  CodeEditorInput,
  CodeEditorInputSource,
  ComponentPreview,
  DocsLayout,
  headings,
  InputGroupWithButton,
  InputGroupWithButtonSource,
  InputGroupWithInnerLabel,
  InputGroupWithInnerLabelSource,
  InputGroupWithMenu,
  InputGroupWithMenuSource,
  InputGroupWithNumberInput,
  InputGroupWithNumberInputSource,
  InputGroupWithTooltip,
  InputGroupWithTooltipSource,
};
---

<DocsLayout
  description="Input group compositions for code editing, menus, inline actions, labels, number inputs, and tooltips."
  framework="vue"
  headings={headings}
  title="Input Group"
>

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">Overview</h2>
  <p class="mb-8 text-muted-foreground">Input group compositions for code editing, menus, inline actions, labels, number inputs, and tooltips.</p>

  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="code-editor-input">Code Editor Input</h2>
  <ComponentPreview code={CodeEditorInputSource} language="ts" title="Code Editor Input">
    <CodeEditorInput client:only="vue" />
  </ComponentPreview>
  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="input-group-with-menu">Input Group With Menu</h2>
  <ComponentPreview code={InputGroupWithMenuSource} language="ts" title="Input Group With Menu">
    <InputGroupWithMenu client:only="vue" />
  </ComponentPreview>
  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="input-group-with-button">Input Group With Button</h2>
  <ComponentPreview code={InputGroupWithButtonSource} language="ts" title="Input Group With Button">
    <InputGroupWithButton client:only="vue" />
  </ComponentPreview>
  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="input-group-with-inner-label">Input Group With Inner Label</h2>
  <ComponentPreview code={InputGroupWithInnerLabelSource} language="ts" title="Input Group With Inner Label">
    <InputGroupWithInnerLabel client:only="vue" />
  </ComponentPreview>
  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="input-group-with-number-input">Input Group With Number Input</h2>
  <ComponentPreview code={InputGroupWithNumberInputSource} language="ts" title="Input Group With Number Input">
    <InputGroupWithNumberInput client:only="vue" />
  </ComponentPreview>
  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="input-group-with-tooltip">Input Group With Tooltip</h2>
  <ComponentPreview code={InputGroupWithTooltipSource} language="ts" title="Input Group With Tooltip">
    <InputGroupWithTooltip client:only="vue" />
  </ComponentPreview>

</DocsLayout>
