---
import BlockDocPage from "#/components/docs/block-doc-page.astro";
import VueBlockExamplesHost from "#/components/docs/vue-block-examples-host.vue";
import { listBlockStaticPaths } from "#/lib/block-doc";

export function getStaticPaths() {
  return listBlockStaticPaths("vue");
}

const id = Astro.params.id as string;
---

<BlockDocPage framework="vue" id={id} />
<VueBlockExamplesHost client:only="vue" />
