---
import DocsLayout from "#/layouts/docs-layout.astro";

const headings = [{ depth: 2, slug: "overview", text: "Overview" }];
---

<DocsLayout
  description="Ready-made page sections built with Pisagor components."
  framework="vue"
  headings={headings}
  kicker="Get started"
  title="Introduction"
>
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">
    Overview
  </h2>
  <p class="mb-6 text-muted-foreground">
    Blocks are packaged page sections built from Pisagor primitives. This
    package is not published yet — docs will land here when it ships.
  </p>
  <p class="text-muted-foreground">
    Use Components, Forms, Charts, and Recipes in the meantime.
  </p>
</DocsLayout>
