---
import ComponentPreview from "#/components/docs/component-preview.astro";
import DocsLayout from "#/layouts/docs-layout.astro";
import { PasswordStrength } from "#/vue/blocks/password/password-strength";
import PasswordStrengthSource from "#/vue/blocks/password/password-strength.ts?raw";

const headings = [
  {
    depth: 2,
    slug: "overview",
    text: "Overview",
  },
  {
    depth: 2,
    slug: "password-strength",
    text: "Password Strength",
  },
];
---

<DocsLayout
  description="Compose a password field with live strength feedback, a segmented progress bar, and a requirement checklist for password creation flows."
  framework="vue"
  headings={headings}
  title="Password Input"
>
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">
    Overview
  </h2>
  <p class="mb-8 text-muted-foreground">
    Compose a password field with live strength feedback, a segmented progress
    bar, and a requirement checklist for password creation flows.
  </p>

  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="password-strength"
  >
    Password Strength
  </h2>
  <p class="mb-3 text-[0.9375rem] text-foreground/80 leading-7">
    Live strength meter, segmented progress, and a requirement checklist for
    password creation flows.
  </p>
  <ComponentPreview
    code={PasswordStrengthSource}
    language="ts"
    title="Password Strength"
  >
    <PasswordStrength client:only="vue" />
  </ComponentPreview>
</DocsLayout>
