---
import {
  Autohighlight,
  Compound,
  Controlled,
  Default,
  Disabled,
  sources as examples,
  Group,
  Invalid,
  imports,
  Multiple,
  OnSurface,
  Sizes,
  Variants,
  WithClearButton,
  WithScroll,
  WithStartIcon,
} from "@pisagor/vue/combobox/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { comboboxProps } from "../../../lib/props/combobox";

const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "sizes", text: "Sizes" },
  { depth: 3, slug: "variants", text: "Variants" },
  { depth: 3, slug: "on-surface", text: "On Surface" },
  { depth: 3, slug: "autohighlight", text: "Autohighlight" },
  { depth: 3, slug: "multiple", text: "Multiple" },
  { depth: 3, slug: "disabled", text: "Disabled" },
  { depth: 3, slug: "invalid", text: "Invalid" },
  { depth: 3, slug: "group", text: "Group" },
  { depth: 3, slug: "with-clear-button", text: "With Clear Button" },
  { depth: 3, slug: "with-scroll", text: "With Scroll" },
  { depth: 3, slug: "with-start-icon", text: "With Start Icon" },
  { depth: 3, slug: "controlled", text: "Controlled" },
  { depth: 3, slug: "compound", text: "Compound" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];
---

<DocsLayout
  description="Lets users filter options while typing and pick a single result."
  framework="vue"
  headings={headings}
  title="Combobox"
>
  <ComponentHeader framework="vue" id="combobox" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="ts" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="sizes">Sizes</h3>
  <ComponentPreview code={examples.Sizes} language="vue" title="Sizes">
    <Sizes client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="variants">Variants</h3>
  <ComponentPreview code={examples.Variants} language="vue" title="Variants">
    <Variants client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="on-surface">On Surface</h3>
  <ComponentPreview code={examples.OnSurface} language="vue" title="On Surface">
    <OnSurface client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="autohighlight">Autohighlight</h3>
  <ComponentPreview code={examples.Autohighlight} language="vue" title="Autohighlight">
    <Autohighlight client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="multiple">Multiple</h3>
  <ComponentPreview code={examples.Multiple} language="vue" title="Multiple">
    <Multiple client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="disabled">Disabled</h3>
  <ComponentPreview code={examples.Disabled} language="vue" title="Disabled">
    <Disabled client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="invalid">Invalid</h3>
  <ComponentPreview code={examples.Invalid} language="vue" title="Invalid">
    <Invalid client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="group">Group</h3>
  <ComponentPreview code={examples.Group} language="vue" title="Group">
    <Group client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="with-clear-button">
    With Clear Button
  </h3>
  <ComponentPreview code={examples.WithClearButton} language="vue" title="With Clear Button">
    <WithClearButton client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="with-scroll">With Scroll</h3>
  <ComponentPreview code={examples.WithScroll} language="vue" title="With Scroll">
    <WithScroll client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="with-start-icon">
    With Start Icon
  </h3>
  <ComponentPreview code={examples.WithStartIcon} language="vue" title="With Start Icon">
    <WithStartIcon client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="controlled">Controlled</h3>
  <ComponentPreview code={examples.Controlled} language="vue" title="Controlled">
    <Controlled client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="compound">Compound</h3>
  <ComponentPreview code={examples.Compound} language="vue" title="Compound">
    <Compound client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">Default</h3>
  <ComponentPreview code={examples.Default} language="vue" title="Default">
    <Default client:only="vue" />
  </ComponentPreview>

  <h2 class="mb-3 mt-12 text-2xl font-semibold tracking-tight" id="installation">Installation</h2>
  <Installation class="mb-8" packages="@pisagor/vue" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/combobox</code>. Native HTML attributes are also supported
    and omitted from this table.
  </p>
  <PropsTable rows={comboboxProps} />
</DocsLayout>
