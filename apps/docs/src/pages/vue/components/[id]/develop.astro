---
import ComponentDocPage from "#/components/docs/component-doc-page.astro";
import VueExamplesHost from "#/components/docs/vue/examples-host.vue";
import { listComponentPaneStaticPaths } from "#/lib/component-doc";

export async function getStaticPaths() {
  return listComponentPaneStaticPaths("vue", "develop");
}

const id = Astro.params.id as string;
---

<ComponentDocPage framework="vue" id={id} tab="develop" />
<VueExamplesHost client:only="vue" />
