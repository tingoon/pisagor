---
import {
  CustomSpacing,
  Default,
  sources as examples,
  Icon,
  imports,
  Product,
} from "@pisagor/vue/card/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { cardProps } from "../../../lib/props/card";

const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "custom-spacing", text: "Custom Spacing" },
  { depth: 3, slug: "icon", text: "Icon" },
  { depth: 3, slug: "product", text: "Product" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];
---

<DocsLayout
  description="Groups related content and actions into a contained surface that people can scan and compare."
  framework="vue"
  headings={headings}
  title="Card"
>
  <ComponentHeader framework="vue" id="card" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="ts" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="custom-spacing">
    Custom Spacing
  </h3>
  <ComponentPreview code={examples.CustomSpacing} language="vue" title="Custom Spacing">
    <CustomSpacing client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="icon">Icon</h3>
  <ComponentPreview code={examples.Icon} language="vue" title="Icon">
    <Icon client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="product">Product</h3>
  <ComponentPreview code={examples.Product} language="vue" title="Product">
    <Product client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">Default</h3>
  <ComponentPreview code={examples.Default} language="vue" title="Default">
    <Default client:only="vue" />
  </ComponentPreview>

  <h2 class="mb-3 mt-12 text-2xl font-semibold tracking-tight" id="installation">Installation</h2>
  <Installation class="mb-8" packages="@pisagor/vue" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/card</code>. Native HTML attributes are also supported and
    omitted from this table.
  </p>
  <PropsTable rows={cardProps} />
</DocsLayout>
