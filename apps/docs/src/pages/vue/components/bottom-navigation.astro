---
import {
  Default,
  sources as examples,
  IconOnly,
  imports,
  WithLinks,
} from "@pisagor/vue/bottom-navigation/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { bottomNavigationProps } from "../../../lib/props/bottom-navigation";

export const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "icon-only", text: "Icon Only" },
  { depth: 3, slug: "with-links", text: "With Links" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];

export {
  bottomNavigationProps,
  CodeBlock,
  ComponentHeader,
  ComponentPreview,
  Default,
  DocsLayout,
  examples,
  IconOnly,
  Installation,
  imports,
  PropsTable,
  WithLinks,
};
---

<DocsLayout
  description="Fixed bottom bar for switching between primary app sections on mobile."
  framework="vue"
  headings={headings}
  title="Bottom Navigation"
>

  <ComponentHeader framework="vue" id="bottom-navigation" />


  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="ts" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="icon-only">Icon Only</h3>
  <ComponentPreview code={examples.IconOnly} language="vue" title="Icon Only">
    <IconOnly client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="with-links">With Links</h3>
  <ComponentPreview code={examples.WithLinks} language="vue" title="With Links">
    <WithLinks client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">Default</h3>
  <ComponentPreview code={examples.Default} language="vue" title="Default">
    <Default client:only="vue" />
  </ComponentPreview>

  <h2 class="mb-3 mt-12 text-2xl font-semibold tracking-tight" id="installation">Installation</h2>
  <Installation class="mb-8" packages="@pisagor/vue" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/bottom-navigation</code>. Native HTML attributes are also supported and omitted from this table.
  </p>
  <PropsTable rows={bottomNavigationProps} />
</DocsLayout>
