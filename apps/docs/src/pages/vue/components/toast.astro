---
import {
  Action,
  Closable,
  Dedupe,
  Default,
  Duration,
  sources as examples,
  imports,
  Placements,
  Variants,
  WithPromise,
} from "@pisagor/vue/toast/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { toastProps } from "../../../lib/props/toast";

export const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "variants", text: "Variants" },
  { depth: 3, slug: "duration", text: "Duration" },
  { depth: 3, slug: "closable", text: "Closable" },
  { depth: 3, slug: "dedupe", text: "Dedupe" },
  { depth: 3, slug: "action", text: "Action" },
  { depth: 3, slug: "with-promise", text: "With Promise" },
  { depth: 3, slug: "placements", text: "Placements" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];

export {
  Action,
  Closable,
  CodeBlock,
  ComponentHeader,
  ComponentPreview,
  Dedupe,
  Default,
  DocsLayout,
  Duration,
  examples,
  Installation,
  imports,
  Placements,
  PropsTable,
  toastProps,
  Variants,
  WithPromise,
};
---

<DocsLayout
  description="Shows brief feedback messages that appear and dismiss automatically after an action completes."
  framework="vue"
  headings={headings}
  title="Toast"
>

  <ComponentHeader framework="vue" id="toast" />


  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="ts" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="variants">Variants</h3>
  <ComponentPreview code={examples.Variants} language="vue" title="Variants">
    <Variants client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="duration">Duration</h3>
  <ComponentPreview code={examples.Duration} language="vue" title="Duration">
    <Duration client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="closable">Closable</h3>
  <ComponentPreview code={examples.Closable} language="vue" title="Closable">
    <Closable client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="dedupe">Dedupe</h3>
  <ComponentPreview code={examples.Dedupe} language="vue" title="Dedupe">
    <Dedupe client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="action">Action</h3>
  <ComponentPreview code={examples.Action} language="vue" title="Action">
    <Action client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="with-promise">With Promise</h3>
  <ComponentPreview code={examples.WithPromise} language="vue" title="With Promise">
    <WithPromise client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="placements">Placements</h3>
  <ComponentPreview code={examples.Placements} language="vue" title="Placements">
    <Placements client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">Default</h3>
  <ComponentPreview code={examples.Default} language="vue" title="Default">
    <Default client:only="vue" />
  </ComponentPreview>

  <h2 class="mb-3 mt-12 text-2xl font-semibold tracking-tight" id="installation">Installation</h2>
  <Installation class="mb-8" packages="@pisagor/vue" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/toast</code>. Native HTML attributes are also supported and omitted from this table.
  </p>
  <PropsTable rows={toastProps} />
</DocsLayout>
