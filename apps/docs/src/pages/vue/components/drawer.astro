---
import {
  CustomSpacing,
  Default,
  DrawerContentInner,
  sources as examples,
  Inset,
  imports,
  SnapPoints,
  SwipeDirections,
} from "@pisagor/vue/drawer/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { drawerProps } from "../../../lib/props/drawer";

const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "custom-spacing", text: "Custom Spacing" },
  { depth: 3, slug: "drawer-content-inner", text: "Drawer Content Inner" },
  { depth: 3, slug: "inset", text: "Inset" },
  { depth: 3, slug: "snap-points", text: "Snap Points" },
  { depth: 3, slug: "swipe-directions", text: "Swipe Directions" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];
---

<DocsLayout
  description="Slides a panel over the page for secondary tasks or details without leaving the current context."
  framework="vue"
  headings={headings}
  title="Drawer"
>
  <ComponentHeader framework="vue" id="drawer" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="ts" title="Import" />

  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="custom-spacing"
  >
    Custom Spacing
  </h3>
  <ComponentPreview
    code={examples.CustomSpacing}
    language="vue"
    title="Custom Spacing"
  >
    <CustomSpacing client:only="vue" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="drawer-content-inner"
  >
    Drawer Content Inner
  </h3>
  <ComponentPreview
    code={examples.DrawerContentInner}
    language="vue"
    title="Drawer Content Inner"
  >
    <DrawerContentInner client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="inset">
    Inset
  </h3>
  <ComponentPreview code={examples.Inset} language="vue" title="Inset">
    <Inset client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="snap-points">
    Snap Points
  </h3>
  <ComponentPreview
    code={examples.SnapPoints}
    language="vue"
    title="Snap Points"
  >
    <SnapPoints client:only="vue" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="swipe-directions"
  >
    Swipe Directions
  </h3>
  <ComponentPreview
    code={examples.SwipeDirections}
    language="vue"
    title="Swipe Directions"
  >
    <SwipeDirections client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">
    Default
  </h3>
  <ComponentPreview code={examples.Default} language="vue" title="Default">
    <Default client:only="vue" />
  </ComponentPreview>

  <h2
    class="mb-3 mt-12 text-2xl font-semibold tracking-tight"
    id="installation"
  >
    Installation
  </h2>
  <Installation class="mb-8" packages="@pisagor/vue" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/drawer</code>. Native HTML attributes
    are also supported and omitted from this table.
  </p>
  <PropsTable rows={drawerProps} />
</DocsLayout>
