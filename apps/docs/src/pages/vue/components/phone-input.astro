---
import {
  Controlled,
  Disabled,
  sources as examples,
  Invalid,
  imports,
  OnSurface,
  Sizes,
  Variants,
} from "@pisagor/vue/phone-input/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { phoneInputProps } from "../../../lib/props/phone-input";

const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "controlled", text: "Controlled" },
  { depth: 3, slug: "disabled", text: "Disabled" },
  { depth: 3, slug: "invalid", text: "Invalid" },
  { depth: 3, slug: "on-surface", text: "On Surface" },
  { depth: 3, slug: "sizes", text: "Sizes" },
  { depth: 3, slug: "variants", text: "Variants" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];
---

<DocsLayout
  description="Enter and format international phone numbers with country selection."
  framework="vue"
  headings={headings}
  title="Phone Input"
>
  <ComponentHeader framework="vue" id="phone-input" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <CodeBlock class="mb-8" code={imports} lang="ts" title="Import" />

  <h3 class="mb-3 text-xl font-semibold tracking-tight" id="controlled">Controlled</h3>
  <ComponentPreview class="mb-8" code={examples.Controlled} title="Controlled">
    <Controlled client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 text-xl font-semibold tracking-tight" id="disabled">Disabled</h3>
  <ComponentPreview class="mb-8" code={examples.Disabled} title="Disabled">
    <Disabled client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 text-xl font-semibold tracking-tight" id="invalid">Invalid</h3>
  <ComponentPreview class="mb-8" code={examples.Invalid} title="Invalid">
    <Invalid client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 text-xl font-semibold tracking-tight" id="on-surface">On Surface</h3>
  <ComponentPreview class="mb-8" code={examples.OnSurface} title="On Surface">
    <OnSurface client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 text-xl font-semibold tracking-tight" id="sizes">Sizes</h3>
  <ComponentPreview class="mb-8" code={examples.Sizes} title="Sizes">
    <Sizes client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 text-xl font-semibold tracking-tight" id="variants">Variants</h3>
  <ComponentPreview class="mb-8" code={examples.Variants} title="Variants">
    <Variants client:only="vue" />
  </ComponentPreview>

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="installation">Installation</h2>
  <Installation class="mb-8" packages="@pisagor/vue" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/phone-input</code>. Native HTML attributes are also
    supported and omitted from this table.
  </p>
  <PropsTable rows={phoneInputProps} />
</DocsLayout>
