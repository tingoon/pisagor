---
import ComponentHeader from "#/components/docs/component-header.astro";
import ComponentPreview from "#/components/docs/component-preview.astro";
import Installation from "#/components/docs/installation.astro";
import PropsTable from "#/components/docs/props-table.astro";
import DocsLayout from "#/layouts/docs-layout.astro";
import type { ComponentDocs } from "#/lib/component-docs-types";
import { popoverProps } from "#/lib/props/popover";
import { getSkillDocImportStatement } from "#/lib/skill-doc";
import {
  Anchor,
  CloseBehavior,
  CloseButton,
  CustomSpacing,
  Default,
  sources as examples,
  Modal,
  Nested,
  Placements,
  ScrollArea,
} from "#/vue/examples/popover";
import {
  Content,
  frontmatter,
  getHeadings,
} from "#/vue/references/primitives/popover.md";

const id = "popover";
const docs = frontmatter as ComponentDocs;
const importStatement = getSkillDocImportStatement(
  id,
  docs.packageName ?? "@pisagor/vue",
  "vue",
);

const mdHeadings = getHeadings()
  .filter((h) => h.depth >= 2)
  .map((h) => ({ depth: h.depth, slug: h.slug, text: h.text }));

const headings = [
  ...mdHeadings,
  { depth: 2, slug: "examples", text: "Examples" },
  ...docs.examples.map((ex) => ({
    depth: 3,
    slug: ex.id,
    text: ex.title,
  })),
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];

function exampleMeta(exportName: string) {
  return docs.examples.find((ex) => ex.exportName === exportName);
}
---

<DocsLayout
  description={docs.description}
  framework="vue"
  headings={headings}
  title={docs.title}
>
  <ComponentHeader
    framework="vue"
    id={id}
    packageName={docs.packageName ?? "@pisagor/vue"}
  />

  <div
    class="docs-skill-md mb-10 space-y-4 text-[0.9375rem] leading-7 text-foreground/90 [&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-2 [&_code]:rounded-md [&_code]:bg-muted/60 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-3.25 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-foreground [&_li]:my-1 [&_ol]:my-3 [&_ol]:list-decimal [&_ol]:ps-5 [&_p]:my-3 [&_pre]:my-4 [&_pre]:overflow-x-auto [&_pre]:rounded-xl [&_pre]:border [&_pre]:border-border/60 [&_pre]:bg-muted/30 [&_pre]:p-4 [&_pre]:text-3.25 [&_strong]:font-semibold [&_ul]:my-3 [&_ul]:list-disc [&_ul]:ps-5"
  >
    <Content />
  </div>

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="examples">
    Examples
  </h2>

  {(() => {
  const ex = exampleMeta("Default");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview code={examples.Default} language="vue" title={ex.title}>
        <Default client:only="vue" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("CustomSpacing");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview
        code={examples.CustomSpacing}
        language="vue"
        title={ex.title}
      >
        <CustomSpacing client:only="vue" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("Anchor");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview code={examples.Anchor} language="vue" title={ex.title}>
        <Anchor client:only="vue" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("CloseButton");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview
        code={examples.CloseButton}
        language="vue"
        title={ex.title}
      >
        <CloseButton client:only="vue" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("Nested");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview code={examples.Nested} language="vue" title={ex.title}>
        <Nested client:only="vue" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("Modal");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview code={examples.Modal} language="vue" title={ex.title}>
        <Modal client:only="vue" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("ScrollArea");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview
        code={examples.ScrollArea}
        language="vue"
        title={ex.title}
      >
        <ScrollArea client:only="vue" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("CloseBehavior");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview
        code={examples.CloseBehavior}
        language="vue"
        title={ex.title}
      >
        <CloseBehavior client:only="vue" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  {(() => {
  const ex = exampleMeta("Placements");
  return ex ? (
    <>
      <h3 class="mt-10 mb-3 font-semibold text-xl tracking-tight" id={ex.id}>
        {ex.title}
      </h3>
      <ComponentPreview
        code={examples.Placements}
        language="vue"
        title={ex.title}
      >
        <Placements client:only="vue" />
      </ComponentPreview>
    </>
  ) : null;
})()}

  <h2
    class="mb-3 mt-16 text-2xl font-semibold tracking-tight"
    id="installation"
  >
    Installation
  </h2>
  <Installation
    class="mb-12"
    manual={importStatement}
    packages={docs.packageName ?? "@pisagor/vue"}
  />

  <h2 class="mb-3 mt-16 text-2xl font-semibold tracking-tight" id="props">
    Props
  </h2>
  <PropsTable rows={popoverProps} />
</DocsLayout>
