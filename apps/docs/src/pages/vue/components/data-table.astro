---
import { Empty, sources as examples, imports, Sorting } from "@pisagor/vue/data-table/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { dataTableProps } from "../../../lib/props/data-table";

const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "empty", text: "Empty" },
  { depth: 3, slug: "sorting", text: "Sorting" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];
---

<DocsLayout
  description="Present structured tabular data with headers, rows, and optional selection."
  framework="vue"
  headings={headings}
  title="Data Table"
>
  <ComponentHeader framework="vue" id="data-table" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <CodeBlock class="mb-8" code={imports} lang="ts" title="Import" />

  <h3 class="mb-3 text-xl font-semibold tracking-tight" id="empty">Empty</h3>
  <ComponentPreview class="mb-8" code={examples.Empty} title="Empty">
    <Empty client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 text-xl font-semibold tracking-tight" id="sorting">Sorting</h3>
  <ComponentPreview class="mb-8" code={examples.Sorting} title="Sorting">
    <Sorting client:only="vue" />
  </ComponentPreview>

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="installation">Installation</h2>
  <Installation class="mb-8" packages="@pisagor/vue" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/data-table</code>. Native HTML attributes are also supported
    and omitted from this table.
  </p>
  <PropsTable rows={dataTableProps} />
</DocsLayout>
