---
import {
  Controlled,
  Count,
  CustomColor,
  CustomIcon,
  CustomSize,
  Default,
  Disabled,
  sources as examples,
  HalfStar,
  Invalid,
  imports,
  OnSurface,
  Readonly,
  Testimonial,
} from "@pisagor/vue/rating/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { ratingProps } from "../../../lib/props/rating";

const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "on-surface", text: "On Surface" },
  { depth: 3, slug: "custom-color", text: "Custom Color" },
  { depth: 3, slug: "count", text: "Count" },
  { depth: 3, slug: "custom-icon", text: "Custom Icon" },
  { depth: 3, slug: "custom-size", text: "Custom Size" },
  { depth: 3, slug: "half-star", text: "Half Star" },
  { depth: 3, slug: "testimonial", text: "Testimonial" },
  { depth: 3, slug: "invalid", text: "Invalid" },
  { depth: 3, slug: "disabled", text: "Disabled" },
  { depth: 3, slug: "readonly", text: "Readonly" },
  { depth: 3, slug: "controlled", text: "Controlled" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];
---

<DocsLayout
  description="A star rating component built on Ark UI rating-group."
  framework="vue"
  headings={headings}
  title="Rating"
>
  <ComponentHeader framework="vue" id="rating" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="ts" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="on-surface">On Surface</h3>
  <ComponentPreview code={examples.OnSurface} language="vue" title="On Surface">
    <OnSurface client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="custom-color">Custom Color</h3>
  <ComponentPreview code={examples.CustomColor} language="vue" title="Custom Color">
    <CustomColor client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="count">Count</h3>
  <ComponentPreview code={examples.Count} language="vue" title="Count">
    <Count client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="custom-icon">Custom Icon</h3>
  <ComponentPreview code={examples.CustomIcon} language="vue" title="Custom Icon">
    <CustomIcon client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="custom-size">Custom Size</h3>
  <ComponentPreview code={examples.CustomSize} language="vue" title="Custom Size">
    <CustomSize client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="half-star">Half Star</h3>
  <ComponentPreview code={examples.HalfStar} language="vue" title="Half Star">
    <HalfStar client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="testimonial">Testimonial</h3>
  <ComponentPreview code={examples.Testimonial} language="vue" title="Testimonial">
    <Testimonial client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="invalid">Invalid</h3>
  <ComponentPreview code={examples.Invalid} language="vue" title="Invalid">
    <Invalid client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="disabled">Disabled</h3>
  <ComponentPreview code={examples.Disabled} language="vue" title="Disabled">
    <Disabled client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="readonly">Readonly</h3>
  <ComponentPreview code={examples.Readonly} language="vue" title="Readonly">
    <Readonly client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="controlled">Controlled</h3>
  <ComponentPreview code={examples.Controlled} language="vue" title="Controlled">
    <Controlled client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">Default</h3>
  <ComponentPreview code={examples.Default} language="vue" title="Default">
    <Default client:only="vue" />
  </ComponentPreview>

  <h2 class="mb-3 mt-12 text-2xl font-semibold tracking-tight" id="installation">Installation</h2>
  <Installation class="mb-8" packages="@pisagor/vue" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/rating</code>. Native HTML attributes are also supported and
    omitted from this table.
  </p>
  <PropsTable rows={ratingProps} />
</DocsLayout>
