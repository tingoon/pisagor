---
import {
  BothDirections,
  Default,
  sources as examples,
  Horizontal,
  imports,
  Nested,
  ScrollFade,
} from "@pisagor/vue/scroll-area/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { scrollAreaProps } from "../../../lib/props/scroll-area";

export const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "horizontal", text: "Horizontal" },
  { depth: 3, slug: "scroll-fade", text: "Scroll Fade" },
  { depth: 3, slug: "both-directions", text: "Both Directions" },
  { depth: 3, slug: "nested", text: "Nested" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];

export {
  BothDirections,
  CodeBlock,
  ComponentHeader,
  ComponentPreview,
  Default,
  DocsLayout,
  examples,
  Horizontal,
  Installation,
  imports,
  Nested,
  PropsTable,
  ScrollFade,
  scrollAreaProps,
};
---

<DocsLayout
  description="Scrolls overflow content with styled scrollbars and optional fade edges that match the surrounding interface."
  framework="vue"
  headings={headings}
  title="Scroll Area"
>

  <ComponentHeader framework="vue" id="scroll-area" />


  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="ts" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="horizontal">Horizontal</h3>
  <ComponentPreview code={examples.Horizontal} language="vue" title="Horizontal">
    <Horizontal client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="scroll-fade">Scroll Fade</h3>
  <ComponentPreview code={examples.ScrollFade} language="vue" title="Scroll Fade">
    <ScrollFade client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="both-directions">Both Directions</h3>
  <ComponentPreview code={examples.BothDirections} language="vue" title="Both Directions">
    <BothDirections client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="nested">Nested</h3>
  <ComponentPreview code={examples.Nested} language="vue" title="Nested">
    <Nested client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">Default</h3>
  <ComponentPreview code={examples.Default} language="vue" title="Default">
    <Default client:only="vue" />
  </ComponentPreview>

  <h2 class="mb-3 mt-12 text-2xl font-semibold tracking-tight" id="installation">Installation</h2>
  <Installation class="mb-8" packages="@pisagor/vue" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/scroll-area</code>. Native HTML attributes are also supported and omitted from this table.
  </p>
  <PropsTable rows={scrollAreaProps} />
</DocsLayout>
