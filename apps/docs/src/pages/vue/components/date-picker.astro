---
import {
  Clearable,
  CustomFormat,
  Default,
  Disabled,
  sources as examples,
  Input,
  Invalid,
  imports,
  Range,
  Time,
  Variants,
  WithPresets,
} from "@pisagor/vue/date-picker/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { datePickerProps } from "../../../lib/props/date-picker";

export const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "variants", text: "Variants" },
  { depth: 3, slug: "range", text: "Range" },
  { depth: 3, slug: "custom-format", text: "Custom Format" },
  { depth: 3, slug: "input", text: "Input" },
  { depth: 3, slug: "invalid", text: "Invalid" },
  { depth: 3, slug: "disabled", text: "Disabled" },
  { depth: 3, slug: "clearable", text: "Clearable" },
  { depth: 3, slug: "time", text: "Time" },
  { depth: 3, slug: "with-presets", text: "With Presets" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];

export {
  Clearable,
  CodeBlock,
  ComponentHeader,
  ComponentPreview,
  CustomFormat,
  Default,
  Disabled,
  DocsLayout,
  datePickerProps,
  examples,
  Input,
  Installation,
  Invalid,
  imports,
  PropsTable,
  Range,
  Time,
  Variants,
  WithPresets,
};
---

<DocsLayout
  description="Pick a date from a calendar popover."
  framework="vue"
  headings={headings}
  title="Date Picker"
>

  <ComponentHeader framework="vue" id="date-picker" />


  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="ts" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="variants">Variants</h3>
  <ComponentPreview code={examples.Variants} language="vue" title="Variants">
    <Variants client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="range">Range</h3>
  <ComponentPreview code={examples.Range} language="vue" title="Range">
    <Range client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="custom-format">Custom Format</h3>
  <ComponentPreview code={examples.CustomFormat} language="vue" title="Custom Format">
    <CustomFormat client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="input">Input</h3>
  <ComponentPreview code={examples.Input} language="vue" title="Input">
    <Input client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="invalid">Invalid</h3>
  <ComponentPreview code={examples.Invalid} language="vue" title="Invalid">
    <Invalid client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="disabled">Disabled</h3>
  <ComponentPreview code={examples.Disabled} language="vue" title="Disabled">
    <Disabled client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="clearable">Clearable</h3>
  <ComponentPreview code={examples.Clearable} language="vue" title="Clearable">
    <Clearable client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="time">Time</h3>
  <ComponentPreview code={examples.Time} language="vue" title="Time">
    <Time client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="with-presets">With Presets</h3>
  <ComponentPreview code={examples.WithPresets} language="vue" title="With Presets">
    <WithPresets client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">Default</h3>
  <ComponentPreview code={examples.Default} language="vue" title="Default">
    <Default client:only="vue" />
  </ComponentPreview>

  <h2 class="mb-3 mt-12 text-2xl font-semibold tracking-tight" id="installation">Installation</h2>
  <Installation class="mb-8" packages="@pisagor/vue" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/date-picker</code>. Native HTML attributes are also supported and omitted from this table.
  </p>
  <PropsTable rows={datePickerProps} />
</DocsLayout>
