---
import {
  Controlled,
  CustomMarkers,
  Default,
  Disabled,
  sources as examples,
  imports,
  OnSurface,
  Sizes,
  Step,
  Thickness,
  WithMarkers,
  WithValue,
} from "@pisagor/vue/circular-slider/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { circularSliderProps } from "../../../lib/props/circular-slider";

const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "on-surface", text: "On Surface" },
  { depth: 3, slug: "sizes", text: "Sizes" },
  { depth: 3, slug: "step", text: "Step" },
  { depth: 3, slug: "thickness", text: "Thickness" },
  { depth: 3, slug: "with-value", text: "With Value" },
  { depth: 3, slug: "disabled", text: "Disabled" },
  { depth: 3, slug: "custom-markers", text: "Custom Markers" },
  { depth: 3, slug: "with-markers", text: "With Markers" },
  { depth: 3, slug: "controlled", text: "Controlled" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];
---

<DocsLayout
  description="Lets users choose a value by dragging around a circular control instead of a straight track."
  framework="vue"
  headings={headings}
  title="Circular Slider"
>
  <ComponentHeader framework="vue" id="circular-slider" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="ts" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="on-surface">
    On Surface
  </h3>
  <ComponentPreview code={examples.OnSurface} language="vue" title="On Surface">
    <OnSurface client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="sizes">
    Sizes
  </h3>
  <ComponentPreview code={examples.Sizes} language="vue" title="Sizes">
    <Sizes client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="step">
    Step
  </h3>
  <ComponentPreview code={examples.Step} language="vue" title="Step">
    <Step client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="thickness">
    Thickness
  </h3>
  <ComponentPreview code={examples.Thickness} language="vue" title="Thickness">
    <Thickness client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="with-value">
    With Value
  </h3>
  <ComponentPreview code={examples.WithValue} language="vue" title="With Value">
    <WithValue client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="disabled">
    Disabled
  </h3>
  <ComponentPreview code={examples.Disabled} language="vue" title="Disabled">
    <Disabled client:only="vue" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="custom-markers"
  >
    Custom Markers
  </h3>
  <ComponentPreview
    code={examples.CustomMarkers}
    language="vue"
    title="Custom Markers"
  >
    <CustomMarkers client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="with-markers">
    With Markers
  </h3>
  <ComponentPreview
    code={examples.WithMarkers}
    language="vue"
    title="With Markers"
  >
    <WithMarkers client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="controlled">
    Controlled
  </h3>
  <ComponentPreview
    code={examples.Controlled}
    language="vue"
    title="Controlled"
  >
    <Controlled client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">
    Default
  </h3>
  <ComponentPreview code={examples.Default} language="vue" title="Default">
    <Default client:only="vue" />
  </ComponentPreview>

  <h2
    class="mb-3 mt-12 text-2xl font-semibold tracking-tight"
    id="installation"
  >
    Installation
  </h2>
  <Installation class="mb-8" packages="@pisagor/vue" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/circular-slider</code>. Native HTML
    attributes are also supported and omitted from this table.
  </p>
  <PropsTable rows={circularSliderProps} />
</DocsLayout>
