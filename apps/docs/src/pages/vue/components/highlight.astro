---
import {
  CustomStyle,
  Default,
  sources as examples,
  imports,
  Multiple,
  MultipleQueries,
  SearchQuery,
  Squiggle,
} from "@pisagor/vue/highlight/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { highlightProps } from "../../../lib/props/highlight";

export const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "multiple", text: "Multiple" },
  { depth: 3, slug: "custom-style", text: "Custom Style" },
  { depth: 3, slug: "search-query", text: "Search Query" },
  { depth: 3, slug: "squiggle", text: "Squiggle" },
  { depth: 3, slug: "multiple-queries", text: "Multiple Queries" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];

export {
  CodeBlock,
  ComponentHeader,
  ComponentPreview,
  CustomStyle,
  Default,
  DocsLayout,
  examples,
  highlightProps,
  Installation,
  imports,
  Multiple,
  MultipleQueries,
  PropsTable,
  SearchQuery,
  Squiggle,
};
---

<DocsLayout
  description="Highlights matching text segments for search results and emphasis."
  framework="vue"
  headings={headings}
  title="Highlight"
>

  <ComponentHeader framework="vue" id="highlight" />


  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="ts" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="multiple">Multiple</h3>
  <ComponentPreview code={examples.Multiple} language="vue" title="Multiple">
    <Multiple client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="custom-style">Custom Style</h3>
  <ComponentPreview code={examples.CustomStyle} language="vue" title="Custom Style">
    <CustomStyle client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="search-query">Search Query</h3>
  <ComponentPreview code={examples.SearchQuery} language="vue" title="Search Query">
    <SearchQuery client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="squiggle">Squiggle</h3>
  <ComponentPreview code={examples.Squiggle} language="vue" title="Squiggle">
    <Squiggle client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="multiple-queries">Multiple Queries</h3>
  <ComponentPreview code={examples.MultipleQueries} language="vue" title="Multiple Queries">
    <MultipleQueries client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">Default</h3>
  <ComponentPreview code={examples.Default} language="vue" title="Default">
    <Default client:only="vue" />
  </ComponentPreview>

  <h2 class="mb-3 mt-12 text-2xl font-semibold tracking-tight" id="installation">Installation</h2>
  <Installation class="mb-8" packages="@pisagor/vue" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/highlight</code>. Native HTML attributes are also supported and omitted from this table.
  </p>
  <PropsTable rows={highlightProps} />
</DocsLayout>
