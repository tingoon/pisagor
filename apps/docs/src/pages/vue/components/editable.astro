---
import {
  ActivationClick,
  ActivationFocus,
  ActivationNone,
  Controlled,
  Dblclick,
  Default,
  Disabled,
  sources as examples,
  Invalid,
  imports,
  OnSurface,
  OrientationHorizontal,
  OrientationVertical,
  Sizes,
  Variants,
  WithoutControls,
  WithTextarea,
} from "@pisagor/vue/editable/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { editableProps } from "../../../lib/props/editable";

const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "invalid", text: "Invalid" },
  { depth: 3, slug: "disabled", text: "Disabled" },
  { depth: 3, slug: "sizes", text: "Sizes" },
  { depth: 3, slug: "variants", text: "Variants" },
  { depth: 3, slug: "on-surface", text: "On Surface" },
  { depth: 3, slug: "dblclick", text: "Dblclick" },
  { depth: 3, slug: "orientation-horizontal", text: "Orientation Horizontal" },
  { depth: 3, slug: "orientation-vertical", text: "Orientation Vertical" },
  { depth: 3, slug: "with-textarea", text: "With Textarea" },
  { depth: 3, slug: "without-controls", text: "Without Controls" },
  { depth: 3, slug: "activation-click", text: "Activation Click" },
  { depth: 3, slug: "activation-focus", text: "Activation Focus" },
  { depth: 3, slug: "activation-none", text: "Activation None" },
  { depth: 3, slug: "controlled", text: "Controlled" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];
---

<DocsLayout
  description="Turns static text into inline editing so users can update a value where it is shown."
  framework="vue"
  headings={headings}
  title="Editable"
>
  <ComponentHeader framework="vue" id="editable" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="ts" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="invalid">
    Invalid
  </h3>
  <ComponentPreview code={examples.Invalid} language="vue" title="Invalid">
    <Invalid client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="disabled">
    Disabled
  </h3>
  <ComponentPreview code={examples.Disabled} language="vue" title="Disabled">
    <Disabled client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="sizes">
    Sizes
  </h3>
  <ComponentPreview code={examples.Sizes} language="vue" title="Sizes">
    <Sizes client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="variants">
    Variants
  </h3>
  <ComponentPreview code={examples.Variants} language="vue" title="Variants">
    <Variants client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="on-surface">
    On Surface
  </h3>
  <ComponentPreview code={examples.OnSurface} language="vue" title="On Surface">
    <OnSurface client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="dblclick">
    Dblclick
  </h3>
  <ComponentPreview code={examples.Dblclick} language="vue" title="Dblclick">
    <Dblclick client:only="vue" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="orientation-horizontal"
  >
    Orientation Horizontal
  </h3>
  <ComponentPreview
    code={examples.OrientationHorizontal}
    language="vue"
    title="Orientation Horizontal"
  >
    <OrientationHorizontal client:only="vue" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="orientation-vertical"
  >
    Orientation Vertical
  </h3>
  <ComponentPreview
    code={examples.OrientationVertical}
    language="vue"
    title="Orientation Vertical"
  >
    <OrientationVertical client:only="vue" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="with-textarea"
  >
    With Textarea
  </h3>
  <ComponentPreview
    code={examples.WithTextarea}
    language="vue"
    title="With Textarea"
  >
    <WithTextarea client:only="vue" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="without-controls"
  >
    Without Controls
  </h3>
  <ComponentPreview
    code={examples.WithoutControls}
    language="vue"
    title="Without Controls"
  >
    <WithoutControls client:only="vue" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="activation-click"
  >
    Activation Click
  </h3>
  <ComponentPreview
    code={examples.ActivationClick}
    language="vue"
    title="Activation Click"
  >
    <ActivationClick client:only="vue" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="activation-focus"
  >
    Activation Focus
  </h3>
  <ComponentPreview
    code={examples.ActivationFocus}
    language="vue"
    title="Activation Focus"
  >
    <ActivationFocus client:only="vue" />
  </ComponentPreview>
  <h3
    class="mb-3 mt-10 text-xl font-semibold tracking-tight"
    id="activation-none"
  >
    Activation None
  </h3>
  <ComponentPreview
    code={examples.ActivationNone}
    language="vue"
    title="Activation None"
  >
    <ActivationNone client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="controlled">
    Controlled
  </h3>
  <ComponentPreview
    code={examples.Controlled}
    language="vue"
    title="Controlled"
  >
    <Controlled client:only="vue" />
  </ComponentPreview>
  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">
    Default
  </h3>
  <ComponentPreview code={examples.Default} language="vue" title="Default">
    <Default client:only="vue" />
  </ComponentPreview>

  <h2
    class="mb-3 mt-12 text-2xl font-semibold tracking-tight"
    id="installation"
  >
    Installation
  </h2>
  <Installation class="mb-8" packages="@pisagor/vue" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/editable</code>. Native HTML attributes
    are also supported and omitted from this table.
  </p>
  <PropsTable rows={editableProps} />
</DocsLayout>
