---
import {
  DataTypes,
  Default,
  ExpandDepth,
  sources as examples,
  imports,
  MapSet,
} from "@pisagor/vue/json-tree-view/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { jsonTreeViewProps } from "../../../lib/props/json-tree-view";

const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "data-types", text: "Data Types" },
  { depth: 3, slug: "expand-depth", text: "Expand Depth" },
  { depth: 3, slug: "map-set", text: "Map Set" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];

---

<DocsLayout
  description="Explores nested JSON as an expandable tree so structured data is easier to inspect."
  framework="vue"
  headings={headings}
  title="Json Tree View"
>

  <ComponentHeader framework="vue" id="json-tree-view" />


  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <p class="mb-4 text-muted-foreground">
    Each example matches a Storybook story, in the same order.
  </p>

  <CodeBlock class="mb-8" code={imports} lang="ts" title="Import" />

  <h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="data-types">Data Types</h3>
  <ComponentPreview code={examples.DataTypes} language="vue" title="Data Types">
    <DataTypes client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="expand-depth">Expand Depth</h3>
  <ComponentPreview code={examples.ExpandDepth} language="vue" title="Expand Depth">
    <ExpandDepth client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="map-set">Map Set</h3>
  <ComponentPreview code={examples.MapSet} language="vue" title="Map Set">
    <MapSet client:only="vue" />
  </ComponentPreview>
<h3 class="mb-3 mt-10 text-xl font-semibold tracking-tight" id="default">Default</h3>
  <ComponentPreview code={examples.Default} language="vue" title="Default">
    <Default client:only="vue" />
  </ComponentPreview>

  <h2 class="mb-3 mt-12 text-2xl font-semibold tracking-tight" id="installation">Installation</h2>
  <Installation class="mb-8" packages="@pisagor/vue" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/json-tree-view</code>. Native HTML attributes are also supported and omitted from this table.
  </p>
  <PropsTable rows={jsonTreeViewProps} />
</DocsLayout>
