---
import ComponentDocPage from "#/components/docs/component-doc-page.astro";
import VueExamplesHost from "#/components/docs/vue-examples-host.vue";
import {
  listComponentTabStaticPaths,
  type SkillPaneId,
} from "#/lib/component-doc";

export async function getStaticPaths() {
  return listComponentTabStaticPaths("vue", "form");
}

const id = Astro.params.id as string;
const tab = Astro.params.tab as SkillPaneId;
---

<ComponentDocPage framework="vue" id={id} kind="form" tab={tab} />
{tab === "develop" ? <VueExamplesHost client:only="vue" /> : null}
