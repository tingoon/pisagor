---
import FormDocPage from "#/components/docs/form-doc-page.astro";
import VueExamplesHost from "#/components/docs/vue/examples-host.vue";
import { listFormStaticPaths } from "#/lib/form-doc";

export async function getStaticPaths() {
  return listFormStaticPaths("vue");
}

const id = Astro.params.id as string;
---

<FormDocPage framework="vue" id={id} />
<VueExamplesHost client:only="vue" />
