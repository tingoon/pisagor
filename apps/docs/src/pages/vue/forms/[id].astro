---
import { getDefaultComponentTab, listComponentIds } from "#/lib/component-doc";
import { withDocsBase } from "#/lib/nav";

export function getStaticPaths() {
  return listComponentIds("vue", "form").map((id) => ({
    params: { id },
  }));
}

const id = Astro.params.id as string;
const tab = await getDefaultComponentTab("vue", id, "form");
return Astro.redirect(withDocsBase(`/vue/forms/${id}/${tab}`));
---

