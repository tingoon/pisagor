---
import {
  Circle,
  Composition,
  Default,
  sources as examples,
  imports,
  Text,
} from "@pisagor/astro/skeleton/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { skeletonProps } from "../../../lib/props/skeleton";

const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "circle", text: "Circle" },
  { depth: 3, slug: "composition", text: "Composition" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 3, slug: "text", text: "Text" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];
---

<DocsLayout
  description="Skeleton for Astro applications."
  framework="astro"
  headings={headings}
  title="Skeleton"
>
  <ComponentHeader framework="astro" id="skeleton" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <CodeBlock class="mb-8" code={imports} lang="astro" title="Import" />

  <h3 class="mb-3 text-xl font-semibold tracking-tight" id="circle">Circle</h3>
  <ComponentPreview class="mb-8" code={examples.Circle} title="Circle">
    <Circle />
  </ComponentPreview>
  <h3 class="mb-3 text-xl font-semibold tracking-tight" id="composition">
    Composition
  </h3>
  <ComponentPreview
    class="mb-8"
    code={examples.Composition}
    title="Composition"
  >
    <Composition />
  </ComponentPreview>
  <h3 class="mb-3 text-xl font-semibold tracking-tight" id="default">
    Default
  </h3>
  <ComponentPreview class="mb-8" code={examples.Default} title="Default">
    <Default />
  </ComponentPreview>
  <h3 class="mb-3 text-xl font-semibold tracking-tight" id="text">Text</h3>
  <ComponentPreview class="mb-8" code={examples.Text} title="Text">
    <Text />
  </ComponentPreview>

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="installation">
    Installation
  </h2>
  <Installation class="mb-8" packages="@pisagor/astro" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/skeleton</code>. Native HTML attributes
    are also supported and omitted from this table.
  </p>
  <PropsTable rows={skeletonProps} />
</DocsLayout>
