---
import ComponentDocPage from "#/components/docs/component-doc-page.astro";
import { listComponentIds } from "#/lib/component-doc";

export function getStaticPaths() {
  return listComponentIds("astro").map((id) => ({
    params: { id },
  }));
}

const id = Astro.params.id as string;
---

<ComponentDocPage framework="astro" id={id} />
