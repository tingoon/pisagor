---
import {
  Default,
  Disabled,
  sources as examples,
  imports,
  Loading,
  Sizes,
  Variants,
} from "@pisagor/astro/button/examples";
import CodeBlock from "../../../components/docs/code-block.astro";
import ComponentHeader from "../../../components/docs/component-header.astro";
import ComponentPreview from "../../../components/docs/component-preview.astro";
import Installation from "../../../components/docs/installation.astro";
import PropsTable from "../../../components/docs/props-table.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";
import { buttonProps } from "../../../lib/props/button";

const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 3, slug: "default", text: "Default" },
  { depth: 3, slug: "sizes", text: "Sizes" },
  { depth: 3, slug: "variants", text: "Variants" },
  { depth: 3, slug: "loading", text: "Loading" },
  { depth: 3, slug: "disabled", text: "Disabled" },
  { depth: 2, slug: "installation", text: "Installation" },
  { depth: 2, slug: "props", text: "Props" },
];
---

<DocsLayout
  description="Button for Astro applications."
  framework="astro"
  headings={headings}
  title="Button"
>
  <ComponentHeader framework="astro" id="button" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <CodeBlock class="mb-8" code={imports} lang="astro" title="Import" />

  <h3 class="mb-3 text-xl font-semibold tracking-tight" id="default">
    Default
  </h3>
  <ComponentPreview class="mb-8" code={examples.Default} title="Default">
    <Default />
  </ComponentPreview>
  <h3 class="mb-3 text-xl font-semibold tracking-tight" id="sizes">Sizes</h3>
  <ComponentPreview class="mb-8" code={examples.Sizes} title="Sizes">
    <Sizes />
  </ComponentPreview>
  <h3 class="mb-3 text-xl font-semibold tracking-tight" id="variants">
    Variants
  </h3>
  <ComponentPreview class="mb-8" code={examples.Variants} title="Variants">
    <Variants />
  </ComponentPreview>
  <h3 class="mb-3 text-xl font-semibold tracking-tight" id="loading">
    Loading
  </h3>
  <ComponentPreview class="mb-8" code={examples.Loading} title="Loading">
    <Loading />
  </ComponentPreview>
  <h3 class="mb-3 text-xl font-semibold tracking-tight" id="disabled">
    Disabled
  </h3>
  <ComponentPreview class="mb-8" code={examples.Disabled} title="Disabled">
    <Disabled />
  </ComponentPreview>

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="installation">
    Installation
  </h2>
  <Installation class="mb-8" packages="@pisagor/astro" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="props">Props</h2>
  <p class="mb-4 text-muted-foreground">
    Own props from <code>@pisagor/props/button</code>. Native HTML attributes
    are also supported and omitted from this table.
  </p>
  <PropsTable rows={buttonProps} />
</DocsLayout>
