---
import Installation from "#/components/docs/installation.astro";
import PackageLinks from "#/components/docs/package-links.astro";
import DocsLayout from "#/layouts/docs-layout.astro";

const headings = [
  { depth: 2, slug: "overview", text: "Overview" },
  { depth: 2, slug: "install", text: "Install" },
];
---

<DocsLayout
  description="Source and composition demos for Astro. Styles come from @pisagor/recipes."
  framework="astro"
  headings={headings}
  kicker="Get started"
  title="Introduction"
>
  <PackageLinks framework="astro" packageName="@pisagor/recipes" />
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">
    Overview
  </h2>
  <p class="mb-6 text-muted-foreground">
    Blocks are copy-ready source and composition demos built from Pisagor
    primitives. Visual styles still come from{" "}
    <code class="rounded bg-muted px-1.5 py-0.5 text-sm">@pisagor/recipes</code>
    {" "}(shared
    <code class="rounded bg-muted px-1.5 py-0.5 text-sm">tv()</code>
    recipes). Interactive Astro runners for these compositions are not available
    yet — browse Components from the sidebar while this track grows.
  </p>

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="install">
    Install
  </h2>
  <Installation class="mb-8" packages="@pisagor/recipes" />
</DocsLayout>
