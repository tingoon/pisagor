---
import DocsLayout from "#/layouts/docs-layout.astro";

const headings = [{ depth: 2, slug: "overview", text: "Overview" }];
---

<DocsLayout
  description="Copy composed Pisagor examples into your app and customize them."
  framework="solid"
  headings={headings}
  title="Introduction"
>
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">
    Overview
  </h2>
  <p class="mb-6 text-muted-foreground">
    Blocks are composed examples built from Pisagor components. Copy an example
    into your project and adapt the layout, copy, and behavior for your product.
    They are not published as packages — customize them in your own codebase.
  </p>
</DocsLayout>
