---
import BlockDocPage from "#/components/docs/block-doc-page.astro";
import { SolidExamplesHost } from "#/components/docs/solid-examples-host";
import { listBlockStaticPaths } from "#/lib/block-doc";

export function getStaticPaths() {
  return listBlockStaticPaths("solid");
}

const id = Astro.params.id as string;
---

<BlockDocPage framework="solid" id={id} />
<SolidExamplesHost client:only="solid-js" />
