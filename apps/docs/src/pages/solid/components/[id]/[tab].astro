---
import ComponentDocPage from "#/components/docs/component-doc-page.astro";
import {
  isLegacyComponentTab,
  listComponentTabStaticPaths,
  type SkillPaneId,
} from "#/lib/component-doc";
import { withDocsBase } from "#/lib/nav";

export async function getStaticPaths() {
  return listComponentTabStaticPaths("solid");
}

const id = Astro.params.id as string;
const tab = Astro.params.tab as SkillPaneId;

if (isLegacyComponentTab(tab)) {
  return Astro.redirect(withDocsBase(`/solid/components/${id}/develop`));
}
---

<ComponentDocPage framework="solid" id={id} tab={tab} />
