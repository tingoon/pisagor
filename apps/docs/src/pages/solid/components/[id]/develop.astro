---
import ComponentDocPage from "#/components/docs/component-doc-page.astro";
import { SolidExamplesHost } from "#/components/docs/solid-examples-host";
import { listComponentPaneStaticPaths } from "#/lib/component-doc";

export async function getStaticPaths() {
  return listComponentPaneStaticPaths("solid", "develop");
}

const id = Astro.params.id as string;
---

<ComponentDocPage framework="solid" id={id} tab="develop" />
<SolidExamplesHost client:only="solid-js" />
