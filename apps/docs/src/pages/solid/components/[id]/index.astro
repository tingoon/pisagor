---
import { listComponentIds } from "#/lib/component-doc";
import { withDocsBase } from "#/lib/nav";

export function getStaticPaths() {
  return listComponentIds("solid").map((id) => ({
    params: { id },
  }));
}

const id = Astro.params.id as string;
return Astro.redirect(withDocsBase(`/solid/components/${id}/develop`));
---

