---
import ComponentHeader from "#/components/docs/component-header.astro";
import Installation from "#/components/docs/installation.astro";
import DocsLayout from "#/layouts/docs-layout.astro";
import { solidExampleUsage } from "#/lib/solid-example-usage";
import defaultRaw from "#/solid/examples/number-input/default.tsx?raw";

const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 2, slug: "installation", text: "Installation" },
];

const usage = solidExampleUsage("NumberInput", "number-input", defaultRaw);
---

<DocsLayout
  description="Numeric stepper with increment controls."
  framework="solid"
  headings={headings}
  title="Number Input"
>
  <ComponentHeader framework="solid" id="number-input" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <pre
    class="mb-8 overflow-x-auto rounded-lg border border-border bg-muted/40 p-4 text-sm"
  ><code>{usage}</code></pre>

  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="installation"
  >
    Installation
  </h2>
  <Installation class="mb-8" packages="@pisagor/solid" />
</DocsLayout>
