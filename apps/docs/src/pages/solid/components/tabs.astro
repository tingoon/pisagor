---
import ComponentHeader from "#/components/docs/component-header.astro";
import Installation from "#/components/docs/installation.astro";
import DocsLayout from "#/layouts/docs-layout.astro";

const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 2, slug: "installation", text: "Installation" },
];

const usage = `import { Tabs } from "@pisagor/solid/tabs";

export function Example() {
  return (
    <Tabs
      defaultValue="tab-1"
      items={[
        {
          content: "Account settings and profile details.",
          label: "Account",
          value: "tab-1",
        },
        {
          content: "Password and security preferences.",
          label: "Security",
          value: "tab-2",
        },
      ]}
    />
  );
}`;
---

<DocsLayout
  description="Tabbed panels for switching related views."
  framework="solid"
  headings={headings}
  title="Tabs"
>
  <ComponentHeader framework="solid" id="tabs" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <pre
    class="mb-8 overflow-x-auto rounded-lg border border-border bg-muted/40 p-4 text-sm"
  ><code>{usage}</code></pre>

  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="installation"
  >
    Installation
  </h2>
  <Installation class="mb-8" packages="@pisagor/solid" />
</DocsLayout>
