---
import RedirectPage from "#/components/docs/redirect-page.astro";
import { listComponentIds } from "#/lib/component-doc";
import { withDocsBase } from "#/lib/nav";

export function getStaticPaths() {
  return listComponentIds("solid", "form").map((id) => ({
    params: { id },
  }));
}

const id = Astro.params.id as string;
const redirectTo = withDocsBase(`/solid/forms/${id}/develop`);
---

<RedirectPage to={redirectTo} />
