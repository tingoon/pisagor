---
import RedirectPage from "#/components/docs/redirect-page.astro";
import { listFormStaticPaths } from "#/lib/form-doc";
import { withDocsBase } from "#/lib/nav";

export async function getStaticPaths() {
  return listFormStaticPaths("solid");
}

const id = Astro.params.id as string;
---

<RedirectPage to={withDocsBase(`/solid/forms/${id}`)} />
