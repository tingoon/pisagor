---
import FormDocPage from "#/components/docs/form-doc-page.astro";
import { SolidExamplesHost } from "#/components/docs/solid/examples-host";
import { listFormStaticPaths } from "#/lib/form-doc";

export async function getStaticPaths() {
  return listFormStaticPaths("solid");
}

const id = Astro.params.id as string;
---

<FormDocPage framework="solid" id={id} />
<SolidExamplesHost client:only="solid" />
