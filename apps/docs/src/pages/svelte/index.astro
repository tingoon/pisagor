---
import PackageLinks from "../../components/docs/package-links.astro";
import DocsLayout from "../../layouts/docs-layout.astro";
import { withDocsBase } from "../../lib/nav";

const headings = [
  { depth: 2, slug: "overview", text: "Overview" },
  { depth: 2, slug: "install", text: "Install" },
  { depth: 2, slug: "next", text: "Next" },
];
---

<DocsLayout
  description="Build with Pisagor Svelte components."
  framework="svelte"
  headings={headings}
  title="Introduction"
>
  <PackageLinks framework="svelte" />
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">Overview</h2>
  <p class="mb-6 text-muted-foreground">
    <code class="rounded bg-muted px-1.5 py-0.5 text-sm">@pisagor/svelte</code>
    mirrors the React package API on Svelte 5 and Ark UI, sharing
    <code class="rounded bg-muted px-1.5 py-0.5 text-sm">@pisagor/recipes</code>
    and
    <code class="rounded bg-muted px-1.5 py-0.5 text-sm">@pisagor/props</code>. Forms and charts
    packages are not part of this track.
  </p>

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="install">Install</h2>
  <pre
    class="mb-6 overflow-x-auto rounded-lg border border-border bg-muted/40 p-4 text-sm"
  ><code>bun add @pisagor/svelte</code></pre>

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="next">Next</h2>
  <p class="text-muted-foreground">
    Start with
    <a
      class="text-foreground underline-offset-4 hover:underline"
      href={withDocsBase("/svelte/components/button")}
      >Button</a
    >
    or
    <a
      class="text-foreground underline-offset-4 hover:underline"
      href={withDocsBase("/svelte/styling")}
      >Styling</a
    >.
  </p>
</DocsLayout>
