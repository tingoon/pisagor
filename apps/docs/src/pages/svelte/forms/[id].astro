---
import FormDocPage from "#/components/docs/form-doc-page.astro";
import SvelteExamplesHost from "#/components/docs/svelte/examples-host.svelte";
import { listFormStaticPaths } from "#/lib/form-doc";

export async function getStaticPaths() {
  return listFormStaticPaths("svelte");
}

const id = Astro.params.id as string;
---

<FormDocPage framework="svelte" id={id} />
<SvelteExamplesHost client:only="svelte" />
