---
import ComponentHeader from "../../../components/docs/component-header.astro";
import Installation from "../../../components/docs/installation.astro";
import DocsLayout from "../../../layouts/docs-layout.astro";

const headings = [
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 2, slug: "installation", text: "Installation" },
];

const usage = `<script>
  import { AlertDialog } from "@pisagor/svelte/alert-dialog";
</script>

<AlertDialog.Root>
  <AlertDialog.Trigger>Delete</AlertDialog.Trigger>
  <AlertDialog.Content>
    <AlertDialog.Header>
      <AlertDialog.Title>Are you sure?</AlertDialog.Title>
    </AlertDialog.Header>
  </AlertDialog.Content>
</AlertDialog.Root>`;
---

<DocsLayout
  description="Confirmation dialog with action and cancel."
  framework="svelte"
  headings={headings}
  title="Alert Dialog"
>
  <ComponentHeader framework="svelte" id="alert-dialog" />

  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="usage">Usage</h2>
  <pre
    class="mb-8 overflow-x-auto rounded-lg border border-border bg-muted/40 p-4 text-sm"
  ><code>{usage}</code></pre>

  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="installation"
  >
    Installation
  </h2>
  <Installation class="mb-8" packages="@pisagor/svelte" />
</DocsLayout>
