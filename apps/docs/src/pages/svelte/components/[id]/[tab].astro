---
import ComponentDocPage from "#/components/docs/component-doc-page.astro";
import SvelteExamplesHost from "#/components/docs/svelte-examples-host.svelte";
import {
  listComponentTabStaticPaths,
  type SkillPaneId,
} from "#/lib/component-doc";

export async function getStaticPaths() {
  return listComponentTabStaticPaths("svelte");
}

const id = Astro.params.id as string;
const tab = Astro.params.tab as SkillPaneId;
---

<ComponentDocPage framework="svelte" id={id} tab={tab} />
{tab === "develop" ? <SvelteExamplesHost client:only="svelte" /> : null}
