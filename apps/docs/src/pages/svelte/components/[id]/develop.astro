---
import ComponentDocPage from "#/components/docs/component-doc-page.astro";
import SvelteExamplesHost from "#/components/docs/svelte/examples-host.svelte";
import { listComponentPaneStaticPaths } from "#/lib/component-doc";

export async function getStaticPaths() {
  return listComponentPaneStaticPaths("svelte", "develop");
}

const id = Astro.params.id as string;
---

<ComponentDocPage framework="svelte" id={id} tab="develop" />
<SvelteExamplesHost client:only="svelte" />
