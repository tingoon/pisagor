---
import LoginCard from "#/blocks/svelte/card/login-card.svelte";
import LoginCardSource from "#/blocks/svelte/card/login-card.svelte?raw";
import LoginCardCustomSpacing from "#/blocks/svelte/card/login-card-custom-spacing.svelte";
import LoginCardCustomSpacingSource from "#/blocks/svelte/card/login-card-custom-spacing.svelte?raw";
import ProductCard from "#/blocks/svelte/card/product-card.svelte";
import ProductCardSource from "#/blocks/svelte/card/product-card.svelte?raw";
import ComponentPreview from "#/components/docs/component-preview.astro";
import DocsLayout from "#/layouts/docs-layout.astro";

const headings = [
  {
    depth: 2,
    slug: "overview",
    text: "Overview",
  },
  {
    depth: 2,
    slug: "login-card",
    text: "Login Card",
  },
  {
    depth: 2,
    slug: "login-card-custom-spacing",
    text: "Login Card Custom Spacing",
  },
  {
    depth: 2,
    slug: "product-card",
    text: "Product Card",
  },
];
---

<DocsLayout
  description="Card compositions for login flows, custom spacing, and product display."
  framework="svelte"
  headings={headings}
  title="Card"
>
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">
    Overview
  </h2>
  <p class="mb-8 text-muted-foreground">
    Card compositions for login flows, custom spacing, and product display.
  </p>

  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="login-card">
    Login Card
  </h2>
  <ComponentPreview code={LoginCardSource} language="svelte" title="Login Card">
    <LoginCard client:only="svelte" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="login-card-custom-spacing"
  >
    Login Card Custom Spacing
  </h2>
  <ComponentPreview
    code={LoginCardCustomSpacingSource}
    language="svelte"
    title="Login Card Custom Spacing"
  >
    <LoginCardCustomSpacing client:only="svelte" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="product-card"
  >
    Product Card
  </h2>
  <ComponentPreview
    code={ProductCardSource}
    language="svelte"
    title="Product Card"
  >
    <ProductCard client:only="svelte" />
  </ComponentPreview>
</DocsLayout>
