---
import AvatarGroupOverflow from "#/blocks/svelte/overlay/avatar-group-overflow.svelte";
import AvatarGroupOverflowSource from "#/blocks/svelte/overlay/avatar-group-overflow.svelte?raw";
import ItemPicker from "#/blocks/svelte/overlay/item-picker.svelte";
import ItemPickerSource from "#/blocks/svelte/overlay/item-picker.svelte?raw";
import MenuDialog from "#/blocks/svelte/overlay/menu-dialog.svelte";
import MenuDialogSource from "#/blocks/svelte/overlay/menu-dialog.svelte?raw";
import PopoverDialog from "#/blocks/svelte/overlay/popover-dialog.svelte";
import PopoverDialogSource from "#/blocks/svelte/overlay/popover-dialog.svelte?raw";
import ComponentPreview from "#/components/docs/component-preview.astro";
import DocsLayout from "#/layouts/docs-layout.astro";

const headings = [
  {
    depth: 2,
    slug: "overview",
    text: "Overview",
  },
  {
    depth: 2,
    slug: "menu-dialog",
    text: "Menu Dialog",
  },
  {
    depth: 2,
    slug: "popover-dialog",
    text: "Popover Dialog",
  },
  {
    depth: 2,
    slug: "item-picker",
    text: "Item Picker",
  },
  {
    depth: 2,
    slug: "avatar-group-overflow",
    text: "Avatar Group Overflow",
  },
];
---

<DocsLayout
  description="Overlay compositions for menus, dialogs, popovers, item pickers, and avatar overflow."
  framework="svelte"
  headings={headings}
  title="Overlay"
>
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">
    Overview
  </h2>
  <p class="mb-8 text-muted-foreground">
    Overlay compositions for menus, dialogs, popovers, item pickers, and avatar
    overflow.
  </p>

  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="menu-dialog">
    Menu Dialog
  </h2>
  <ComponentPreview
    code={MenuDialogSource}
    language="svelte"
    title="Menu Dialog"
  >
    <MenuDialog client:only="svelte" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="popover-dialog"
  >
    Popover Dialog
  </h2>
  <ComponentPreview
    code={PopoverDialogSource}
    language="svelte"
    title="Popover Dialog"
  >
    <PopoverDialog client:only="svelte" />
  </ComponentPreview>
  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="item-picker">
    Item Picker
  </h2>
  <ComponentPreview
    code={ItemPickerSource}
    language="svelte"
    title="Item Picker"
  >
    <ItemPicker client:only="svelte" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="avatar-group-overflow"
  >
    Avatar Group Overflow
  </h2>
  <ComponentPreview
    code={AvatarGroupOverflowSource}
    language="svelte"
    title="Avatar Group Overflow"
  >
    <AvatarGroupOverflow client:only="svelte" />
  </ComponentPreview>
</DocsLayout>
