---
import BlockDocPage from "#/components/docs/block-doc-page.astro";
import SvelteExamplesHost from "#/components/docs/svelte-examples-host.svelte";
import { listBlockStaticPaths } from "#/lib/block-doc";

export async function getStaticPaths() {
  return listBlockStaticPaths("svelte");
}

const id = Astro.params.id as string;
---

<BlockDocPage framework="svelte" id={id} />
<SvelteExamplesHost client:only="svelte" />
