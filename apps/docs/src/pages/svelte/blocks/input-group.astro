---
import CodeEditorInput from "#/blocks/svelte/input-group/code-editor-input.svelte";
import CodeEditorInputSource from "#/blocks/svelte/input-group/code-editor-input.svelte?raw";
import InputGroupWithButton from "#/blocks/svelte/input-group/input-group-with-button.svelte";
import InputGroupWithButtonSource from "#/blocks/svelte/input-group/input-group-with-button.svelte?raw";
import InputGroupWithInnerLabel from "#/blocks/svelte/input-group/input-group-with-inner-label.svelte";
import InputGroupWithInnerLabelSource from "#/blocks/svelte/input-group/input-group-with-inner-label.svelte?raw";
import InputGroupWithMenu from "#/blocks/svelte/input-group/input-group-with-menu.svelte";
import InputGroupWithMenuSource from "#/blocks/svelte/input-group/input-group-with-menu.svelte?raw";
import InputGroupWithNumberInput from "#/blocks/svelte/input-group/input-group-with-number-input.svelte";
import InputGroupWithNumberInputSource from "#/blocks/svelte/input-group/input-group-with-number-input.svelte?raw";
import InputGroupWithTooltip from "#/blocks/svelte/input-group/input-group-with-tooltip.svelte";
import InputGroupWithTooltipSource from "#/blocks/svelte/input-group/input-group-with-tooltip.svelte?raw";
import ComponentPreview from "#/components/docs/component-preview.astro";
import DocsLayout from "#/layouts/docs-layout.astro";

const headings = [
  {
    depth: 2,
    slug: "overview",
    text: "Overview",
  },
  {
    depth: 2,
    slug: "code-editor-input",
    text: "Code Editor Input",
  },
  {
    depth: 2,
    slug: "input-group-with-menu",
    text: "Input Group With Menu",
  },
  {
    depth: 2,
    slug: "input-group-with-button",
    text: "Input Group With Button",
  },
  {
    depth: 2,
    slug: "input-group-with-inner-label",
    text: "Input Group With Inner Label",
  },
  {
    depth: 2,
    slug: "input-group-with-number-input",
    text: "Input Group With Number Input",
  },
  {
    depth: 2,
    slug: "input-group-with-tooltip",
    text: "Input Group With Tooltip",
  },
];
---

<DocsLayout
  description="Input group compositions for code editing, menus, inline actions, labels, number inputs, and tooltips."
  framework="svelte"
  headings={headings}
  title="Input Group"
>
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">
    Overview
  </h2>
  <p class="mb-8 text-muted-foreground">
    Input group compositions for code editing, menus, inline actions, labels,
    number inputs, and tooltips.
  </p>

  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="code-editor-input"
  >
    Code Editor Input
  </h2>
  <ComponentPreview
    code={CodeEditorInputSource}
    language="svelte"
    title="Code Editor Input"
  >
    <CodeEditorInput client:only="svelte" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="input-group-with-menu"
  >
    Input Group With Menu
  </h2>
  <ComponentPreview
    code={InputGroupWithMenuSource}
    language="svelte"
    title="Input Group With Menu"
  >
    <InputGroupWithMenu client:only="svelte" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="input-group-with-button"
  >
    Input Group With Button
  </h2>
  <ComponentPreview
    code={InputGroupWithButtonSource}
    language="svelte"
    title="Input Group With Button"
  >
    <InputGroupWithButton client:only="svelte" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="input-group-with-inner-label"
  >
    Input Group With Inner Label
  </h2>
  <ComponentPreview
    code={InputGroupWithInnerLabelSource}
    language="svelte"
    title="Input Group With Inner Label"
  >
    <InputGroupWithInnerLabel client:only="svelte" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="input-group-with-number-input"
  >
    Input Group With Number Input
  </h2>
  <ComponentPreview
    code={InputGroupWithNumberInputSource}
    language="svelte"
    title="Input Group With Number Input"
  >
    <InputGroupWithNumberInput client:only="svelte" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="input-group-with-tooltip"
  >
    Input Group With Tooltip
  </h2>
  <ComponentPreview
    code={InputGroupWithTooltipSource}
    language="svelte"
    title="Input Group With Tooltip"
  >
    <InputGroupWithTooltip client:only="svelte" />
  </ComponentPreview>
</DocsLayout>
