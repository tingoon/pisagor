---
import ComponentPreview from "#/components/docs/component-preview.astro";
import DocsLayout from "#/layouts/docs-layout.astro";
import TableBulkActions from "#/svelte/blocks/table/table-bulk-actions.svelte";
import TableBulkActionsSource from "#/svelte/blocks/table/table-bulk-actions.svelte?raw";
import TablePagination from "#/svelte/blocks/table/table-pagination.svelte";
import TablePaginationSource from "#/svelte/blocks/table/table-pagination.svelte?raw";
import TableRowMenu from "#/svelte/blocks/table/table-row-menu.svelte";
import TableRowMenuSource from "#/svelte/blocks/table/table-row-menu.svelte?raw";

const headings = [
  {
    depth: 2,
    slug: "overview",
    text: "Overview",
  },
  {
    depth: 2,
    slug: "table-bulk-actions",
    text: "Table Bulk Actions",
  },
  {
    depth: 2,
    slug: "table-row-menu",
    text: "Table Row Menu",
  },
  {
    depth: 2,
    slug: "table-pagination",
    text: "Table Pagination",
  },
];
---

<DocsLayout
  description="Table compositions with bulk actions, row menus, and pagination controls."
  framework="svelte"
  headings={headings}
  title="Table"
>
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">
    Overview
  </h2>
  <p class="mb-8 text-muted-foreground">
    Table compositions with bulk actions, row menus, and pagination controls.
  </p>

  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="table-bulk-actions"
  >
    Table Bulk Actions
  </h2>
  <ComponentPreview
    code={TableBulkActionsSource}
    language="svelte"
    title="Table Bulk Actions"
  >
    <TableBulkActions client:only="svelte" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="table-row-menu"
  >
    Table Row Menu
  </h2>
  <ComponentPreview
    code={TableRowMenuSource}
    language="svelte"
    title="Table Row Menu"
  >
    <TableRowMenu client:only="svelte" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="table-pagination"
  >
    Table Pagination
  </h2>
  <ComponentPreview
    code={TablePaginationSource}
    language="svelte"
    title="Table Pagination"
  >
    <TablePagination client:only="svelte" />
  </ComponentPreview>
</DocsLayout>
