---
import FormGrid from "#/blocks/svelte/field/form-grid.svelte";
import FormGridSource from "#/blocks/svelte/field/form-grid.svelte?raw";
import FormSection from "#/blocks/svelte/field/form-section.svelte";
import FormSectionSource from "#/blocks/svelte/field/form-section.svelte?raw";
import FormSectionTextarea from "#/blocks/svelte/field/form-section-textarea.svelte";
import FormSectionTextareaSource from "#/blocks/svelte/field/form-section-textarea.svelte?raw";
import LabelAccessory from "#/blocks/svelte/field/label-accessory.svelte";
import LabelAccessorySource from "#/blocks/svelte/field/label-accessory.svelte?raw";
import SettingsPanel from "#/blocks/svelte/field/settings-panel.svelte";
import SettingsPanelSource from "#/blocks/svelte/field/settings-panel.svelte?raw";
import SettingsRow from "#/blocks/svelte/field/settings-row.svelte";
import SettingsRowSource from "#/blocks/svelte/field/settings-row.svelte?raw";
import ComponentPreview from "#/components/docs/component-preview.astro";
import DocsLayout from "#/layouts/docs-layout.astro";

const headings = [
  {
    depth: 2,
    slug: "overview",
    text: "Overview",
  },
  {
    depth: 2,
    slug: "form-grid",
    text: "Form Grid",
  },
  {
    depth: 2,
    slug: "form-section",
    text: "Form Section",
  },
  {
    depth: 2,
    slug: "form-section-textarea",
    text: "Form Section Textarea",
  },
  {
    depth: 2,
    slug: "label-accessory",
    text: "Label Accessory",
  },
  {
    depth: 2,
    slug: "settings-panel",
    text: "Settings Panel",
  },
  {
    depth: 2,
    slug: "settings-row",
    text: "Settings Row",
  },
];
---

<DocsLayout
  description="Field layout compositions for grids, sections, labels, and settings rows."
  framework="svelte"
  headings={headings}
  title="Field"
>
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" id="overview">
    Overview
  </h2>
  <p class="mb-8 text-muted-foreground">
    Field layout compositions for grids, sections, labels, and settings rows.
  </p>

  <h2 class="mb-3 mt-10 text-2xl font-semibold tracking-tight" id="form-grid">
    Form Grid
  </h2>
  <ComponentPreview code={FormGridSource} language="svelte" title="Form Grid">
    <FormGrid client:only="svelte" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="form-section"
  >
    Form Section
  </h2>
  <ComponentPreview
    code={FormSectionSource}
    language="svelte"
    title="Form Section"
  >
    <FormSection client:only="svelte" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="form-section-textarea"
  >
    Form Section Textarea
  </h2>
  <ComponentPreview
    code={FormSectionTextareaSource}
    language="svelte"
    title="Form Section Textarea"
  >
    <FormSectionTextarea client:only="svelte" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="label-accessory"
  >
    Label Accessory
  </h2>
  <ComponentPreview
    code={LabelAccessorySource}
    language="svelte"
    title="Label Accessory"
  >
    <LabelAccessory client:only="svelte" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="settings-panel"
  >
    Settings Panel
  </h2>
  <ComponentPreview
    code={SettingsPanelSource}
    language="svelte"
    title="Settings Panel"
  >
    <SettingsPanel client:only="svelte" />
  </ComponentPreview>
  <h2
    class="mb-3 mt-10 text-2xl font-semibold tracking-tight"
    id="settings-row"
  >
    Settings Row
  </h2>
  <ComponentPreview
    code={SettingsRowSource}
    language="svelte"
    title="Settings Row"
  >
    <SettingsRow client:only="svelte" />
  </ComponentPreview>
</DocsLayout>
