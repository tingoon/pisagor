{
  "extends": "//",
  "linter": {
    "domains": {
      "astro": "all",
      "react": "recommended",
      "solid": "none",
      "svelte": "none",
      "vue": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/blocks/vue/**",
        "src/blocks/svelte/**",
        "src/blocks/solid/**",
        "**/*.svelte",
        "**/*.vue"
      ],
      "linter": {
        "domains": {
          "react": "none"
        }
      }
    }
  ]
}
