{
  "assist": {
    "actions": {
      "source": {
        "useSortedAttributes": "on",
        "useSortedKeys": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/*.gen.*", "!**/*.lock"]
  },
  "formatter": {
    "enabled": false,
    "indentStyle": "space"
  },
  "html": {
    "experimentalFullSupportEnabled": true
  },
  "linter": {
    "domains": {
      "project": "recommended",
      "tailwind": "recommended",
      "turborepo": "recommended"
    },
    "rules": {
      "complexity": {
        "noUselessFragments": "error"
      },
      "correctness": {
        "noUndeclaredDependencies": "error",
        "noUnusedFunctionParameters": "warn",
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "nursery": {
        "useSortedClasses": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@ark-ui/*/*"],
                "message": "Import Ark UI from the framework barrel (@ark-ui/react, @ark-ui/vue, @ark-ui/solid, @ark-ui/svelte), never subpaths."
              }
            ]
          }
        },
        "useExportType": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noConsole": "warn",
        "noDeprecatedImports": "warn",
        "noImportCycles": "error",
        "noUndeclaredEnvVars": {
          "level": "warn",
          "options": {
            "allowedEnvVars": ["BASE_URL"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "assist": {
        "enabled": false
      },
      "includes": [
        "**/*.js",
        "**/*.jsx",
        "**/*.ts",
        "**/*.tsx",
        "**/*.mjs",
        "**/*.cjs",
        "**/*.mts",
        "**/*.cts"
      ],
      "linter": {
        "enabled": false
      }
    },
    {
      "assist": {
        "enabled": false
      },
      "includes": ["**/*.vue", "**/*.svelte", "**/*.astro"]
    },
    {
      "assist": {
        "enabled": false
      },
      "includes": ["**/package.json"]
    },
    {
      "formatter": {
        "enabled": true
      },
      "html": {
        "formatter": {
          "enabled": true
        }
      },
      "includes": ["**/*.astro"]
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
