{
  "assist": {
    "actions": {
      "source": {
        "useSortedAttributes": "on",
        "useSortedKeys": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/*.gen.*", "!**/*.lock"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    }
  },
  "linter": {
    "domains": {
      "project": "recommended",
      "turborepo": "recommended"
    },
    "rules": {
      "suspicious": {
        "noImportCycles": "error",
        "noUndeclaredEnvVars": {
          "level": "warn",
          "options": {
            "allowedEnvVars": ["BASE_URL"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
