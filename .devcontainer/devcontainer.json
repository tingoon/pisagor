{
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "biomejs.biome",
        "bradlc.vscode-tailwindcss",
        "oven.bun-vscode",
        "vue.volar",
        "svelte.svelte-vscode"
      ],
      "settings": {
        "remote.autoForwardPorts": true
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:1": {
      "username": "vscode"
    }
  },
  "forwardPorts": [4000, 4001, 4002, 4003],
  "portsAttributes": {
    "4000": {
      "label": "docs",
      "onAutoForward": "notify"
    },
    "4001": {
      "label": "react",
      "onAutoForward": "notify"
    },
    "4002": {
      "label": "vue",
      "onAutoForward": "notify"
    },
    "4003": {
      "label": "astro",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bun install --frozen-lockfile && bun run setup",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:${containerWorkspaceFolder}/node_modules/.bin"
  },
  "remoteUser": "vscode",
  "runArgs": ["--name=pisagor", "--init"]
}
