{
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": ["biomejs.biome", "oven.bun-vscode", "bradlc.vscode-tailwindcss"],
      "settings": {
        "remote.autoForwardPorts": true
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:1": {
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [4001, 4002],
  "portsAttributes": {
    "4001": {
      "label": "react",
      "onAutoForward": "notify"
    },
    "4002": {
      "label": "vue",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bun install --frozen-lockfile",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:${containerWorkspaceFolder}/node_modules/.bin"
  },
  "remoteUser": "vscode",
  "runArgs": ["--name=pisagor", "--init"]
}
