{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/mcp-schema.json",
  "mcpServers": {
    "ark-ui": {
      "args": ["@ark-ui/mcp"],
      "command": "bunx"
    },
    "github": {
      "headers": {
        "Authorization": "Bearer ${env:GITHUB_PAT}"
      },
      "url": "https://api.githubcopilot.com/mcp/"
    }
  }
}
